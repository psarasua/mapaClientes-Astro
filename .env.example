# =================================
# SISTEMA DE REPARTOS - VARIABLES DE ENTORNO
# =================================

# DATABASE CONFIGURATION
# PostgreSQL Database URL
# Formato: postgresql://usuario:contraseña@host:puerto/base_datos?sslmode=require
DATABASE_URL=postgresql://usuario:contraseña@host:puerto/base_de_datos?sslmode=require

# JWT CONFIGURATION  
# Clave secreta para JWT (genera una nueva para producción)
# GENERAR: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_clave_secreta_muy_segura_para_jwt_tokens

# APPLICATION CONFIGURATION
# Puerto del servidor (el hosting lo configura automáticamente)
PORT=4321

# Entorno de ejecución
NODE_ENV=development