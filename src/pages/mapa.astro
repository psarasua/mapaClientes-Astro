---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mapa de Repartos - Sistema de Repartos">
  <div id="app" class="min-h-screen bg-gray-50">
    <!-- Loading state -->
    <div id="loading" class="flex items-center justify-center min-h-screen">
      <div class="animate-spin rounded-full h-32 w-32 border-b-2 border-blue-600"></div>
    </div>

    <!-- Main content -->
    <div id="mainContent" class="hidden">
      <!-- Header -->
      <header class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-center py-4">
            <div>
              <h1 class="text-2xl font-bold text-gray-900">Mapa de Repartos</h1>
              <p class="text-gray-600">Visualización de rutas y ubicaciones</p>
            </div>
            <div class="flex items-center space-x-4">
              <span id="userName" class="text-gray-700"></span>
              <button 
                id="logoutBtn"
                class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg transition-colors"
              >
                Cerrar Sesión
              </button>
            </div>
          </div>
        </div>
      </header>

      <!-- Navigation -->
      <nav class="bg-blue-600 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex space-x-8">
            <a href="/dashboard" class="px-3 py-4 text-blue-100 hover:text-white hover:border-blue-300 border-b-2 border-transparent transition-colors">Dashboard</a>
            <a href="/clientes" class="px-3 py-4 text-blue-100 hover:text-white hover:border-blue-300 border-b-2 border-transparent transition-colors">Clientes</a>
            <a href="/camiones" class="px-3 py-4 text-blue-100 hover:text-white hover:border-blue-300 border-b-2 border-transparent transition-colors">Camiones</a>
            <a href="/repartos" class="px-3 py-4 text-blue-100 hover:text-white hover:border-blue-300 border-b-2 border-transparent transition-colors">Repartos</a>
            <a href="/mapa" class="px-3 py-4 text-white border-b-2 border-white font-medium">Mapa</a>
            <a href="/reportes" class="px-3 py-4 text-blue-100 hover:text-white hover:border-blue-300 border-b-2 border-transparent transition-colors">Reportes</a>
          </div>
        </div>
      </nav>

      <!-- Map Container -->
      <div class="flex h-screen">
        <!-- Sidebar -->
        <div class="w-80 bg-white shadow-lg overflow-y-auto">
          <!-- Controls -->
          <div class="p-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Controles del Mapa</h3>
            
            <!-- Filter by Route -->
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">Filtrar por Ruta</label>
              <select id="rutaFilter" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">Todas las rutas</option>
              </select>
            </div>
            
            <!-- Map Controls -->
            <div class="space-y-2">
              <button id="showAllClients" class="w-full px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                🏢 Mostrar Todos los Clientes
              </button>
              <button id="showActiveRepartos" class="w-full px-3 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                🚛 Mostrar Repartos Activos
              </button>
              <button id="centerMap" class="w-full px-3 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors">
                🎯 Centrar Mapa
              </button>
            </div>
          </div>
          
          <!-- Legend -->
          <div class="p-4 border-b border-gray-200">
            <h4 class="text-md font-medium text-gray-900 mb-3">Leyenda</h4>
            <div class="space-y-2">
              <div class="flex items-center space-x-2">
                <div class="w-4 h-4 bg-blue-500 rounded-full"></div>
                <span class="text-sm text-gray-700">Clientes Activos</span>
              </div>
              <div class="flex items-center space-x-2">
                <div class="w-4 h-4 bg-red-500 rounded-full"></div>
                <span class="text-sm text-gray-700">Clientes Inactivos</span>
              </div>
              <div class="flex items-center space-x-2">
                <div class="w-4 h-4 bg-green-500 rounded-full"></div>
                <span class="text-sm text-gray-700">En Reparto Activo</span>
              </div>
              <div class="flex items-center space-x-2">
                <div class="w-4 h-4 bg-purple-500 rounded"></div>
                <span class="text-sm text-gray-700">Camiones</span>
              </div>
            </div>
          </div>
          
          <!-- Client List -->
          <div class="p-4">
            <h4 class="text-md font-medium text-gray-900 mb-3">Clientes Visibles</h4>
            <div id="clientList" class="space-y-2 max-h-96 overflow-y-auto">
              <!-- Client list will be populated here -->
            </div>
          </div>
        </div>

        <!-- Map -->
        <div class="flex-1 relative">
          <div id="map" class="w-full h-full">
            <!-- Leaflet map will be initialized here -->
          </div>
          
          <!-- Map not available fallback -->
          <div id="mapFallback" class="w-full h-full flex items-center justify-center bg-gray-100">
            <div class="text-center">
              <div class="text-6xl mb-4">🗺️</div>
              <h3 class="text-xl font-medium text-gray-900 mb-2">Mapa Interactivo</h3>
              <p class="text-gray-600 mb-4">Vista de clientes y rutas de reparto</p>
              <div class="bg-white rounded-lg shadow p-6 max-w-md">
                <h4 class="font-medium text-gray-900 mb-3">Clientes por Estado:</h4>
                <div id="clientStats" class="space-y-2">
                  <!-- Stats will be loaded here -->
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Client Details Modal -->
  <div id="clientModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center p-4 z-50">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">Detalles del Cliente</h3>
      </div>
      <div id="clientDetails" class="px-6 py-4">
        <!-- Client details will be loaded here -->
      </div>
      <div class="px-6 py-4 border-t border-gray-200 flex justify-end">
        <button id="closeModal" class="px-4 py-2 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-lg transition-colors">
          Cerrar
        </button>
      </div>
    </div>
  </div>

  <!-- External Libraries -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    let map;
    let clientes = [];
    let repartos = [];
    let rutas = [];
    let markers = [];
    let mapInitialized = false;

    // Default coordinates (center of Uruguay/Argentina region)
    const DEFAULT_LAT = -34.6;
    const DEFAULT_LNG = -56.2;

    document.addEventListener('DOMContentLoaded', async () => {
      await checkAuth();
      await loadData();
      initializeMap();
      setupEventListeners();
    });

    async function checkAuth() {
      try {
        const response = await fetch('/api/auth/check');
        const data = await response.json();
        
        if (!data.authenticated) {
          window.location.href = '/login';
          return;
        }
        
        document.getElementById('userName').textContent = data.user.nombre_completo;
      } catch (error) {
        console.error('Auth check error:', error);
        window.location.href = '/login';
      }
    }

    async function loadData() {
      try {
        const [clientesRes, repartosRes, rutasRes] = await Promise.all([
          fetch('/api/clientes'),
          fetch('/api/repartos'),
          fetch('/api/rutas')
        ]);
        
        const [clientesData, repartosData, rutasData] = await Promise.all([
          clientesRes.json(),
          repartosRes.json(),
          rutasRes.json()
        ]);
        
        if (clientesData.success) {
          clientes = clientesData.data.filter(c => c.latitud && c.longitud);
        }
        if (repartosData.success) repartos = repartosData.data;
        if (rutasData.success) rutas = rutasData.data;
        
        populateRutaFilter();
        updateClientStats();
        
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('mainContent').classList.remove('hidden');
        
      } catch (error) {
        console.error('Error loading data:', error);
      }
    }

    function initializeMap() {
      try {
        // Initialize Leaflet map
        map = L.map('map').setView([DEFAULT_LAT, DEFAULT_LNG], 11);
        
        // Add OpenStreetMap tiles
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© OpenStreetMap contributors'
        }).addTo(map);
        
        mapInitialized = true;
        
        // Hide fallback and show map
        document.getElementById('mapFallback').style.display = 'none';
        document.getElementById('map').style.display = 'block';
        
        // Add all client markers
        showAllClientsOnMap();
        
      } catch (error) {
        console.error('Error initializing map:', error);
        // Show fallback view
        document.getElementById('map').style.display = 'none';
        document.getElementById('mapFallback').style.display = 'flex';
      }
    }

    function populateRutaFilter() {
      const select = document.getElementById('rutaFilter');
      select.innerHTML = '<option value="">Todas las rutas</option>' +
        rutas.map(ruta => `<option value="${ruta.id}">${ruta.nombre}</option>`).join('');
    }

    function updateClientStats() {
      const statsContainer = document.getElementById('clientStats');
      const activos = clientes.filter(c => c.estado === 'Activo').length;
      const inactivos = clientes.filter(c => c.estado === 'Inactivo').length;
      const conCoordenadas = clientes.length;
      const sinCoordenadas = activos + inactivos - conCoordenadas;
      
      statsContainer.innerHTML = `
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Activos:</span>
          <span class="text-sm font-medium text-green-600">${activos}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Inactivos:</span>
          <span class="text-sm font-medium text-red-600">${inactivos}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Con GPS:</span>
          <span class="text-sm font-medium text-blue-600">${conCoordenadas}</span>
        </div>
        ${sinCoordenadas > 0 ? `
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Sin GPS:</span>
          <span class="text-sm font-medium text-gray-400">${sinCoordenadas}</span>
        </div>
        ` : ''}
      `;
    }

    function clearMarkers() {
      markers.forEach(marker => map.removeLayer(marker));
      markers = [];
    }

    function showAllClientsOnMap() {
      if (!mapInitialized) return;
      
      clearMarkers();
      
      clientes.forEach(cliente => {
        const isInReparto = repartos.some(reparto => 
          reparto.clientes && reparto.clientes.some(c => c.cliente_id === cliente.id)
        );
        
        const color = isInReparto ? 'green' : (cliente.estado === 'Activo' ? 'blue' : 'red');
        
        const marker = L.circleMarker([cliente.latitud, cliente.longitud], {
          radius: 8,
          fillColor: color,
          color: 'white',
          weight: 2,
          opacity: 1,
          fillOpacity: 0.8
        }).addTo(map);
        
        // Add popup
        marker.bindPopup(`
          <div class="p-2">
            <h4 class="font-medium text-gray-900">${cliente.nombre}</h4>
            <p class="text-sm text-gray-600">${cliente.razonsocial}</p>
            <p class="text-xs text-gray-500">${cliente.direccion}</p>
            <div class="mt-2">
              <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
                cliente.estado === 'Activo' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
              }">
                ${cliente.estado}
              </span>
              ${isInReparto ? '<span class="ml-1 inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">En Reparto</span>' : ''}
            </div>
            <button onclick="showClientDetails(${cliente.id})" class="mt-2 text-xs text-blue-600 hover:text-blue-800">
              Ver detalles
            </button>
          </div>
        `);
        
        markers.push(marker);
      });
      
      updateClientList();
    }

    function showRepartoClients(rutaId) {
      if (!mapInitialized) return;
      
      clearMarkers();
      
      const repartosFiltered = rutaId ? repartos.filter(r => r.ruta_id == rutaId) : repartos;
      
      repartosFiltered.forEach(reparto => {
        if (reparto.clientes) {
          reparto.clientes.forEach(clienteData => {
            const cliente = clientes.find(c => c.id === clienteData.cliente_id);
            if (cliente) {
              const marker = L.circleMarker([cliente.latitud, cliente.longitud], {
                radius: 10,
                fillColor: 'green',
                color: 'white',
                weight: 2,
                opacity: 1,
                fillOpacity: 0.9
              }).addTo(map);
              
              marker.bindPopup(`
                <div class="p-2">
                  <h4 class="font-medium text-gray-900">${cliente.nombre}</h4>
                  <p class="text-sm text-gray-600">${cliente.razonsocial}</p>
                  <p class="text-xs text-gray-500">${cliente.direccion}</p>
                  <div class="mt-2">
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                      En Reparto
                    </span>
                  </div>
                  <div class="mt-2 text-xs text-gray-600">
                    <strong>Ruta:</strong> ${reparto.ruta_nombre}<br>
                    <strong>Camión:</strong> ${reparto.camion_nombre}
                  </div>
                </div>
              `);
              
              markers.push(marker);
            }
          });
        }
      });
      
      updateClientList(repartosFiltered);
    }

    function updateClientList(filteredRepartos = null) {
      const container = document.getElementById('clientList');
      
      let clientsToShow;
      if (filteredRepartos) {
        clientsToShow = [];
        filteredRepartos.forEach(reparto => {
          if (reparto.clientes) {
            reparto.clientes.forEach(clienteData => {
              const cliente = clientes.find(c => c.id === clienteData.cliente_id);
              if (cliente) {
                clientsToShow.push({...cliente, ruta: reparto.ruta_nombre, camion: reparto.camion_nombre});
              }
            });
          }
        });
      } else {
        clientsToShow = clientes;
      }
      
      container.innerHTML = clientsToShow.map(cliente => `
        <div class="p-2 bg-gray-50 rounded cursor-pointer hover:bg-gray-100" onclick="focusClient(${cliente.id})">
          <div class="text-sm font-medium text-gray-900">${cliente.nombre}</div>
          <div class="text-xs text-gray-600">${cliente.razonsocial}</div>
          ${cliente.ruta ? `<div class="text-xs text-blue-600">📍 ${cliente.ruta}</div>` : ''}
        </div>
      `).join('');
    }

    function setupEventListeners() {
      // Filter controls
      document.getElementById('rutaFilter').addEventListener('change', (e) => {
        const rutaId = e.target.value;
        if (rutaId) {
          showRepartoClients(rutaId);
        } else {
          showAllClientsOnMap();
        }
      });
      
      // Map controls
      document.getElementById('showAllClients').addEventListener('click', showAllClientsOnMap);
      document.getElementById('showActiveRepartos').addEventListener('click', () => showRepartoClients());
      document.getElementById('centerMap').addEventListener('click', () => {
        if (mapInitialized && markers.length > 0) {
          const group = new L.featureGroup(markers);
          map.fitBounds(group.getBounds().pad(0.1));
        }
      });
      
      // Modal controls
      document.getElementById('closeModal').addEventListener('click', () => {
        document.getElementById('clientModal').classList.add('hidden');
        document.getElementById('clientModal').classList.remove('flex');
      });
      
      // Logout
      document.getElementById('logoutBtn').addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/login';
      });
    }

    window.focusClient = function(clientId) {
      const cliente = clientes.find(c => c.id === clientId);
      if (cliente && mapInitialized) {
        map.setView([cliente.latitud, cliente.longitud], 16);
        
        // Find and open popup for this client
        markers.forEach(marker => {
          const markerLatLng = marker.getLatLng();
          if (Math.abs(markerLatLng.lat - cliente.latitud) < 0.0001 && 
              Math.abs(markerLatLng.lng - cliente.longitud) < 0.0001) {
            marker.openPopup();
          }
        });
      }
    }

    window.showClientDetails = function(clientId) {
      const cliente = clientes.find(c => c.id === clientId);
      if (!cliente) return;
      
      const isInReparto = repartos.find(reparto => 
        reparto.clientes && reparto.clientes.some(c => c.cliente_id === cliente.id)
      );
      
      const detailsContainer = document.getElementById('clientDetails');
      detailsContainer.innerHTML = `
        <div class="space-y-3">
          <div>
            <h4 class="font-medium text-gray-900">${cliente.nombre}</h4>
            <p class="text-sm text-gray-600">${cliente.razonsocial}</p>
          </div>
          
          <div>
            <p class="text-sm"><strong>Dirección:</strong> ${cliente.direccion}</p>
            ${cliente.telefono ? `<p class="text-sm"><strong>Teléfono:</strong> ${cliente.telefono}</p>` : ''}
            ${cliente.rut ? `<p class="text-sm"><strong>RUT:</strong> ${cliente.rut}</p>` : ''}
          </div>
          
          <div>
            <p class="text-sm"><strong>Coordenadas:</strong> ${cliente.latitud}, ${cliente.longitud}</p>
            <p class="text-sm"><strong>Estado:</strong> 
              <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
                cliente.estado === 'Activo' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
              }">
                ${cliente.estado}
              </span>
            </p>
          </div>
          
          ${isInReparto ? `
          <div class="p-3 bg-blue-50 rounded-lg">
            <h5 class="font-medium text-blue-900">En Reparto Activo</h5>
            <p class="text-sm text-blue-700">Ruta: ${isInReparto.ruta_nombre}</p>
            <p class="text-sm text-blue-700">Camión: ${isInReparto.camion_nombre}</p>
          </div>
          ` : ''}
        </div>
      `;
      
      document.getElementById('clientModal').classList.remove('hidden');
      document.getElementById('clientModal').classList.add('flex');
    }
  </script>
</Layout>