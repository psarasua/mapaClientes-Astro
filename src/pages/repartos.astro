---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import MotionSimple from '../components/MotionSimple.astro';
---

<Layout title="Gestión de Repartos - Sistema de Repartos">
  <MotionSimple />
  <div id="app" class="min-h-screen bg-gray-50">
    <!-- Loading state -->
    <div id="loading" class="flex items-center justify-center min-h-screen">
      <div class="flex flex-col items-center space-y-4">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
        <p class="text-gray-600 font-medium">Cargando repartos...</p>
      </div>
    </div>

    <!-- Main content -->
    <div id="mainContent" class="hidden">
      <Navigation currentPage="repartos" />

      <!-- Content -->
      <main class="max-w-7xl mx-auto px-6 lg:px-8 py-8">
        <!-- Header de página -->
        <div class="flex justify-between items-center mb-8">
          <div>
            <h2 class="text-3xl font-bold text-gray-900" style="font-family: Inter;">Gestión de Repartos</h2>
            <p class="text-gray-600 mt-2">Planifica y administra las rutas de entrega</p>
          </div>
          <button 
            id="addRepartoBtn"
            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors flex items-center space-x-2 font-medium"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            <span>Nuevo Reparto</span>
          </button>
        </div>

        <!-- Estadísticas rápidas -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Total Repartos</p>
                <p id="totalRepartos" class="text-2xl font-bold text-gray-900" style="font-family: Inter;">0</p>
              </div>
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Programados</p>
                <p id="programadosRepartos" class="text-2xl font-bold text-blue-600" style="font-family: Inter;">0</p>
              </div>
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">En Curso</p>
                <p id="enCursoRepartos" class="text-2xl font-bold text-orange-600" style="font-family: Inter;">0</p>
              </div>
              <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Completados</p>
                <p id="completadosRepartos" class="text-2xl font-bold text-green-600" style="font-family: Inter;">0</p>
              </div>
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Lista de repartos -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900">Lista de Repartos</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ruta</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Camión/Conductor</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Clientes Asignados</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
              </thead>
              <tbody id="repartosTableBody" class="bg-white divide-y divide-gray-200">
                <!-- Repartos will be loaded here -->
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>

    <!-- Add/Edit Reparto Modal -->
    <div id="repartoModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center p-4">
      <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-screen overflow-y-auto">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 id="modalTitle" class="text-lg font-medium text-gray-900">Nuevo Reparto</h3>
        </div>
        <form id="repartoForm" class="px-6 py-4 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Ruta *</label>
              <select name="ruta_id" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">Seleccionar ruta</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Camión *</label>
              <select name="camion_id" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">Seleccionar camión</option>
              </select>
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Clientes a Asignar</label>
            <div id="clientesContainer" class="max-h-48 overflow-y-auto border border-gray-300 rounded-lg p-3">
              <!-- Clientes checkboxes will be loaded here -->
            </div>
          </div>
        </form>
        
        <div class="px-6 py-4 border-t border-gray-200 flex justify-end space-x-3">
          <button id="cancelBtn" type="button" class="px-4 py-2 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-lg transition-colors">
            Cancelar
          </button>
          <button id="saveBtn" type="submit" form="repartoForm" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
            Guardar
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let repartos = [];
    let camiones = [];
    let rutas = [];
    let clientes = [];
    let editingReparto = null;

    document.addEventListener('DOMContentLoaded', async () => {
      await checkAuth();
      await loadData();
      setupEventListeners();
    });

    async function checkAuth() {
      try {
        const response = await fetch('/api/auth/check');
        const data = await response.json();
        
        if (!data.authenticated) {
          window.location.href = '/login';
          return;
        }
        
        document.getElementById('userName').textContent = data.user.nombre_completo;
      } catch (error) {
        console.error('Auth check error:', error);
        window.location.href = '/login';
      }
    }

    async function loadData() {
      try {
        const [repartosResponse, camionesResponse, rutasResponse, clientesResponse] = await Promise.all([
          fetch('/api/repartos'),
          fetch('/api/camiones'),
          fetch('/api/rutas'),
          fetch('/api/clientes')
        ]);
        
        const repartosData = await repartosResponse.json();
        const camionesData = await camionesResponse.json();
        const rutasData = await rutasResponse.json();
        const clientesData = await clientesResponse.json();
        
        if (repartosData.success) repartos = repartosData.data;
        if (camionesData.success) camiones = camionesData.data;
        if (rutasData.success) rutas = rutasData.data;
        if (clientesData.success) clientes = clientesData.data.filter(c => c.estado === 'Activo');
        
        renderRepartos();
        updateStats();
        loadSelectOptions();
        
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('mainContent').classList.remove('hidden');
        
      } catch (error) {
        console.error('Error loading data:', error);
      }
    }

    function updateStats() {
      const total = repartos.length;
      const programados = repartos.filter(r => r.estado === 'programado').length;
      const enCurso = repartos.filter(r => r.estado === 'en_curso').length;
      const completados = repartos.filter(r => r.estado === 'completado').length;
      
      document.getElementById('totalRepartos').textContent = total;
      document.getElementById('programadosRepartos').textContent = programados;
      document.getElementById('enCursoRepartos').textContent = enCurso;
      document.getElementById('completadosRepartos').textContent = completados;
    }

    function renderRepartos() {
      const tbody = document.getElementById('repartosTableBody');
      
      if (repartos.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-gray-500">No hay repartos registrados</td>
          </tr>
        `;
        return;
      }
      
      tbody.innerHTML = repartos.map(reparto => `
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4">
            <div class="text-sm font-medium text-gray-900">#${reparto.id}</div>
          </td>
          <td class="px-6 py-4">
            <div class="text-sm font-medium text-gray-900">${reparto.ruta_nombre || 'Sin ruta'}</div>
          </td>
          <td class="px-6 py-4">
            <div class="text-sm font-medium text-gray-900">${reparto.camion_nombre || 'Sin conductor'}</div>
          </td>
          <td class="px-6 py-4">
            <div class="text-sm text-gray-900">
              ${reparto.clientes ? reparto.clientes.length : 0} clientes asignados
            </div>
            ${reparto.clientes && reparto.clientes.length > 0 ? 
              `<div class="text-xs text-gray-500">
                ${reparto.clientes.map(c => c.nombre).join(', ')}
              </div>` : 
              '<div class="text-xs text-gray-400">Sin clientes asignados</div>'
            }
          </td>
          <td class="px-6 py-4">
            <div class="flex space-x-2">
              <button onclick="editReparto(${reparto.id})" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                Editar
              </button>
              <button onclick="deleteReparto(${reparto.id})" class="text-red-600 hover:text-red-800 text-sm font-medium">
                Eliminar
              </button>
            </div>
          </td>
        </tr>
      `).join('');
    }

    function setupEventListeners() {
      // Modal controls
      document.getElementById('addRepartoBtn').addEventListener('click', () => openModal());
      document.getElementById('cancelBtn').addEventListener('click', closeModal);
      document.getElementById('repartoForm').addEventListener('submit', saveReparto);
      
      // Logout
      document.getElementById('logoutBtn').addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/login';
      });
    }

    function loadSelectOptions() {
      // Load rutas
      const rutaSelect = document.querySelector('[name="ruta_id"]');
      rutaSelect.innerHTML = '<option value="">Seleccionar ruta</option>' +
        rutas.map(ruta => `<option value="${ruta.id}">${ruta.nombre}</option>`).join('');
      
      // Load camiones
      const camionSelect = document.querySelector('[name="camion_id"]');
      camionSelect.innerHTML = '<option value="">Seleccionar camión</option>' +
        camiones.map(camion => `<option value="${camion.id}">${camion.nombre}</option>`).join('');
      
      // Load clientes checkboxes
      const clientesContainer = document.getElementById('clientesContainer');
      clientesContainer.innerHTML = clientes.map(cliente => `
        <div class="flex items-center space-x-2 mb-2">
          <input type="checkbox" name="cliente_ids" value="${cliente.id}" id="cliente_${cliente.id}" class="rounded">
          <label for="cliente_${cliente.id}" class="text-sm text-gray-700">${cliente.nombre} - ${cliente.razonsocial}</label>
        </div>
      `).join('');
    }

    function openModal(reparto = null) {
      editingReparto = reparto;
      const modal = document.getElementById('repartoModal');
      const title = document.getElementById('modalTitle');
      const form = document.getElementById('repartoForm');
      
      if (reparto) {
        title.textContent = 'Editar Reparto';
        
        // Fill form with reparto data
        form.querySelector('[name="ruta_id"]').value = reparto.ruta_id || '';
        form.querySelector('[name="camion_id"]').value = reparto.camion_id || '';
        
        // Check assigned clientes
        const checkboxes = form.querySelectorAll('[name="cliente_ids"]');
        checkboxes.forEach(checkbox => {
          checkbox.checked = reparto.clientes && reparto.clientes.some(c => c.cliente_id == checkbox.value);
        });
      } else {
        title.textContent = 'Nuevo Reparto';
        form.reset();
      }
      
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      const modal = document.getElementById('repartoModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      editingReparto = null;
    }

    async function saveReparto(e) {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const repartoData = Object.fromEntries(formData.entries());
      
      // Get selected cliente IDs
      const clienteIds = Array.from(e.target.querySelectorAll('[name="cliente_ids"]:checked')).map(cb => parseInt(cb.value));
      repartoData.cliente_ids = clienteIds;
      
      try {
        const url = editingReparto ? `/api/repartos/${editingReparto.id}` : '/api/repartos';
        const method = editingReparto ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(repartoData)
        });
        
        const data = await response.json();
        
        if (data.success) {
          closeModal();
          await loadData();
        } else {
          alert('Error al guardar reparto: ' + data.error);
        }
      } catch (error) {
        console.error('Error saving reparto:', error);
        alert('Error de conexión');
      }
    }

    window.editReparto = function(repartoId) {
      const reparto = repartos.find(r => r.id === repartoId);
      if (reparto) {
        openModal(reparto);
      }
    }

    window.deleteReparto = async function(repartoId) {
      if (confirm('¿Estás seguro de eliminar este reparto?')) {
        try {
          const response = await fetch(`/api/repartos/${repartoId}`, {
            method: 'DELETE'
          });
          
          const data = await response.json();
          
          if (data.success) {
            await loadData();
          } else {
            alert('Error al eliminar reparto: ' + data.error);
          }
        } catch (error) {
          console.error('Error deleting reparto:', error);
          alert('Error de conexión');
        }
      }
    }
  </script>
</Layout>