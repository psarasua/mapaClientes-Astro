---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import LoadingSpinner from '../components/LoadingSpinner.astro';
import SmartForm from '../components/forms/SmartForm.astro';
import SmartInput from '../components/forms/SmartInput.astro';
import SmartSelect from '../components/forms/SmartSelect.astro';
import InteractiveButton from '../components/interactions/InteractiveButton.astro';
import InteractiveCard from '../components/interactions/InteractiveCard.astro';
---

<Layout title="Repartos - Sistema de Gestión">
  <Navigation currentPage="repartos" />
  
  <LoadingSpinner message="Cargando repartos..." />

  <main id="mainContent" class="max-w-7xl mx-auto px-6 lg:px-8 py-8 hidden">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Gestión de Repartos</h1>
      <p class="text-gray-600">Administra las entregas y rutas de distribución</p>
    </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Total</p>
                <p id="totalRepartos" class="text-2xl font-bold text-blue-600">0</p>
              </div>
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Pendientes</p>
                <p id="pendientesRepartos" class="text-2xl font-bold text-yellow-600">0</p>
              </div>
              <div class="w-12 h-12 bg-yellow-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">En Curso</p>
                <p id="enCursoRepartos" class="text-2xl font-bold text-orange-600">0</p>
              </div>
              <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Completados</p>
                <p id="completadosRepartos" class="text-2xl font-bold text-green-600">0</p>
              </div>
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Tabla de Repartos -->
        <div class="bg-white rounded-lg shadow">
          <div class="px-6 py-4 border-b border-gray-200">
            <div class="flex items-center justify-between">
              <h2 class="text-lg font-medium text-gray-900">Repartos</h2>
              <button id="newRepartoBtn" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
                <svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                Nuevo Reparto
              </button>
            </div>
          </div>
          <div id="repartoTableContainer" class="p-6">
            <div class="text-center py-8">
              <p class="text-gray-500">Cargando repartos...</p>
            </div>
          </div>
        </div>
    </main>

    <!-- Smart Form Modal for Repartos -->
    <SmartForm 
      id="repartoForm" 
      title="Nuevo Reparto"
      onSubmit="handleRepartoSubmit"
      onCancel="handleRepartoCancel"
      autoSave={true}
      autoSaveInterval={30000}
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <SmartInput
          name="cliente"
          label="Cliente"
          type="text"
          required={true}
          maxLength={100}
          icon="user"
          placeholder="Nombre del cliente"
        />
        
        <SmartInput
          name="direccion"
          label="Dirección de entrega"
          type="text"
          required={true}
          maxLength={200}
          icon="location-marker"
          placeholder="Dirección completa"
        />
        
        <SmartInput
          name="fecha_entrega"
          label="Fecha de entrega"
          type="date"
          required={true}
          icon="calendar"
        />
        
        <SmartSelect
          name="estado"
          label="Estado"
          required={true}
          options={[
            { value: 'Pendiente', label: 'Pendiente' },
            { value: 'En Curso', label: 'En Curso' },
            { value: 'Completado', label: 'Completado' },
            { value: 'Cancelado', label: 'Cancelado' }
          ]}
        />
        
        <SmartInput
          name="camion"
          label="Camión asignado"
          type="text"
          maxLength={50}
          icon="truck"
          placeholder="Matrícula del camión"
        />
        
        <SmartInput
          name="conductor"
          label="Conductor"
          type="text"
          maxLength={100}
          icon="user-circle"
          placeholder="Nombre del conductor"
        />
      </div>
      
      <div class="col-span-2">
        <SmartInput
          name="observaciones"
          label="Observaciones"
          type="textarea"
          maxLength={500}
          icon="document-text"
          placeholder="Observaciones sobre el reparto..."
        />
      </div>
    </SmartForm>
  </div>

  <script>
    let repartos = [];
    let editingReparto = null;
    let repartoFormManager = null;

    document.addEventListener('DOMContentLoaded', async () => {
      const startTime = Date.now();
      const minLoadingTime = 1000; // Tiempo mínimo de loading: 1 segundo
      
      try {
        await checkAuth();
        await loadData();
        setupEventListeners();
        
        // Initialize smart form manager
        repartoFormManager = new SmartFormManager('repartoForm', {
          autoSave: true,
          autoSaveInterval: 30000,
          onSubmit: 'handleRepartoSubmit',
          onCancel: 'handleRepartoCancel'
        });
        
      } catch (error) {
        console.error('Initialization error:', error);
      } finally {
        // Asegurar tiempo mínimo de loading para mejor UX
        const elapsedTime = Date.now() - startTime;
        const remainingTime = Math.max(0, minLoadingTime - elapsedTime);
        
        setTimeout(() => {
          const loading = document.getElementById('loading');
          const mainContent = document.getElementById('mainContent');
          
          if (loading) {
            loading.style.opacity = '0';
            setTimeout(() => {
              loading.classList.add('hidden');
            }, 300);
          }
          if (mainContent) {
            mainContent.classList.remove('hidden');
            mainContent.style.opacity = '0';
            setTimeout(() => {
              mainContent.style.opacity = '1';
            }, 50);
          }
        }, remainingTime);
      }
    });

    async function checkAuth() {
      try {
        const response = await fetch('/api/auth/check');
        const data = await response.json();
        
        if (!data.authenticated) {
          window.location.href = '/login';
          return;
        }
      } catch (error) {
        console.error('Auth check error:', error);
        window.location.href = '/login';
      }
    }

    async function loadData() {
      try {
        const response = await fetch('/api/repartos');
        const result = await response.json();
        
        if (result.success) {
          repartos = result.data || [];
          updateStats();
          renderRepartosTable();
        } else {
          console.error('Error loading data:', result.message);
        }
        
      } catch (error) {
        console.error('Error loading data:', error);
      }
    }

    function updateStats() {
      const total = repartos.length;
      const pendientes = repartos.filter(r => r.estado === 'Pendiente').length;
      const enCurso = repartos.filter(r => r.estado === 'En Curso').length;
      const completados = repartos.filter(r => r.estado === 'Completado').length;
      
      document.getElementById('totalRepartos').textContent = total.toString();
      document.getElementById('pendientesRepartos').textContent = pendientes.toString();
      document.getElementById('enCursoRepartos').textContent = enCurso.toString();
      document.getElementById('completadosRepartos').textContent = completados.toString();
    }

    function renderRepartosTable() {
      const container = document.getElementById('repartoTableContainer');
      if (!container) return;

      if (repartos.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8">
            <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
            <p class="text-lg font-medium text-gray-900">No hay repartos</p>
            <p class="text-gray-500">Comienza agregando tu primer reparto</p>
          </div>
        `;
        return;
      }

      // Vista Desktop - Tabla tradicional (≥768px)
      const desktopTableHTML = `
        <div class="hidden md:block overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dirección</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Camión</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              ${repartos.map(reparto => `
                <tr class="hover:bg-gray-50 transition-colors duration-200">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    ${reparto.cliente || '-'}
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate">
                    ${reparto.direccion || '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-center">
                    ${reparto.fecha_entrega ? new Date(reparto.fecha_entrega).toLocaleDateString() : '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    ${generateEstadoBadgeReparto(reparto.estado)}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    ${reparto.camion || '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    ${generateActionButtonsReparto(reparto.id)}
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `;

      // Vista Mobile - Timeline (< 768px)
      const mobileTimelineHTML = `
        <div class="md:hidden space-y-6">
          <!-- Header del timeline -->
          <div class="text-center pb-4 border-b border-gray-200">
            <h3 class="text-lg font-semibold text-gray-900">Timeline de Repartos</h3>
            <p class="text-sm text-gray-500">Seguimiento cronológico de entregas</p>
          </div>
          
          <!-- Timeline container -->
          <div class="relative">
            <!-- Línea vertical del timeline -->
            <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gray-200"></div>
            
            ${generateTimelineItems(repartos)}
          </div>
        </div>
      `;

      container.innerHTML = desktopTableHTML + mobileTimelineHTML;
    }

    // Función para generar items del timeline móvil
    function generateTimelineItems(repartos) {
      // Ordenar repartos por fecha y estado para mejor visualización del timeline
      const sortedRepartos = [...repartos].sort((a, b) => {
        // Primero por estado (En Curso > Pendiente > Completado > Cancelado)
        const estadoOrder = { 'En Curso': 1, 'Pendiente': 2, 'Completado': 3, 'Cancelado': 4 };
        const estadoComparison = (estadoOrder[a.estado] || 5) - (estadoOrder[b.estado] || 5);
        
        if (estadoComparison !== 0) return estadoComparison;
        
        // Luego por fecha
        const dateA = new Date(a.fecha_entrega || '1970-01-01');
        const dateB = new Date(b.fecha_entrega || '1970-01-01');
        return dateA - dateB;
      });

      return sortedRepartos.map((reparto, index) => {
        const isLast = index === sortedRepartos.length - 1;
        
        return `
          <div class="relative flex items-start space-x-4 pb-6 ${isLast ? '' : 'mb-4'}">
            <!-- Icono del timeline -->
            <div class="relative z-10 flex-shrink-0">
              ${generateTimelineIcon(reparto.estado)}
            </div>
            
            <!-- Contenido del reparto -->
            <div class="flex-1 min-w-0 bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow duration-200 p-4">
              <!-- Header del reparto -->
              <div class="flex justify-between items-start mb-3">
                <div class="flex-1">
                  <h4 class="text-lg font-semibold text-gray-900 mb-1">
                    ${reparto.cliente || 'Cliente no especificado'}
                  </h4>
                  <div class="flex items-center text-sm text-gray-500 mb-2">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    ${reparto.direccion || 'Dirección no especificada'}
                  </div>
                </div>
                <div class="ml-3">
                  ${generateEstadoBadgeReparto(reparto.estado)}
                </div>
              </div>
              
              <!-- Detalles del reparto -->
              <div class="grid grid-cols-2 gap-3 mb-4 text-sm">
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <span class="text-gray-600">
                    ${reparto.fecha_entrega ? new Date(reparto.fecha_entrega).toLocaleDateString() : 'Sin fecha'}
                  </span>
                </div>
                
                ${reparto.camion ? `
                  <div class="flex items-center">
                    <svg class="w-4 h-4 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM21 17a2 2 0 11-4 0 2 2 0 014 0zM13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9.5a1 1 0 01-1-1v0a1 1 0 011-1H13a1 1 0 011 1z"></path>
                    </svg>
                    <span class="text-gray-600">${reparto.camion}</span>
                  </div>
                ` : ''}
                
                ${reparto.conductor ? `
                  <div class="flex items-center col-span-2">
                    <svg class="w-4 h-4 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    <span class="text-gray-600">${reparto.conductor}</span>
                  </div>
                ` : ''}
              </div>
              
              <!-- Observaciones si existen -->
              ${reparto.observaciones ? `
                <div class="mb-4 p-3 bg-gray-50 rounded-lg">
                  <div class="flex items-start">
                    <svg class="w-4 h-4 mr-1.5 text-gray-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <span class="text-sm text-gray-700">${reparto.observaciones}</span>
                  </div>
                </div>
              ` : ''}
              
              <!-- Botones de acción -->
              <div class="flex justify-end space-x-2 pt-3 border-t border-gray-100">
                ${generateMobileActionButtonsReparto(reparto.id)}
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Función para generar icono del timeline según estado
    function generateTimelineIcon(estado) {
      const iconConfig = {
        'Pendiente': {
          icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
          class: 'bg-yellow-100 text-yellow-600 border-yellow-200'
        },
        'En Curso': {
          icon: 'M13 10V3L4 14h7v7l9-11h-7z',
          class: 'bg-orange-100 text-orange-600 border-orange-200'
        },
        'Completado': {
          icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
          class: 'bg-green-100 text-green-600 border-green-200'
        },
        'Cancelado': {
          icon: 'M6 18L18 6M6 6l12 12',
          class: 'bg-red-100 text-red-600 border-red-200'
        }
      };
      
      const config = iconConfig[estado] || iconConfig['Pendiente'];
      
      return `
        <div class="w-12 h-12 rounded-full border-2 ${config.class} flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${config.icon}"></path>
          </svg>
        </div>
      `;
    }

    // Función auxiliar para generar badge de estado
    function generateEstadoBadgeReparto(estado) {
      const badgeClasses = {
        'Completado': 'bg-green-100 text-green-800',
        'En Curso': 'bg-orange-100 text-orange-800',
        'Pendiente': 'bg-yellow-100 text-yellow-800',
        'Cancelado': 'bg-red-100 text-red-800'
      };
      
      const className = badgeClasses[estado] || 'bg-gray-100 text-gray-800';
      
      return `
        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${className}">
          ${estado || 'Pendiente'}
        </span>
      `;
    }

    // Función auxiliar para generar botones de acción desktop
    function generateActionButtonsReparto(repartoId) {
      return `
        <button onclick="editReparto(${repartoId})" 
                class="text-blue-600 hover:text-blue-900 mr-2 p-1 hover:bg-blue-50 rounded transition-colors duration-200"
                title="Editar reparto">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
        </button>
        <button onclick="deleteReparto(${repartoId})" 
                class="text-red-600 hover:text-red-900 p-1 hover:bg-red-50 rounded transition-colors duration-200"
                title="Eliminar reparto">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
        </button>
      `;
    }

    // Función auxiliar para generar botones de acción móviles (touch-optimized)
    function generateMobileActionButtonsReparto(repartoId) {
      return `
        <button onclick="editReparto(${repartoId})" 
                class="inline-flex items-center px-3 py-2 text-sm font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 hover:border-blue-300 transition-colors duration-200 min-h-[44px] min-w-[44px] justify-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          <span class="hidden min-[480px]:inline">Editar</span>
        </button>
        <button onclick="deleteReparto(${repartoId})" 
                class="inline-flex items-center px-3 py-2 text-sm font-medium text-red-600 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 hover:border-red-300 transition-colors duration-200 min-h-[44px] min-w-[44px] justify-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          <span class="hidden min-[480px]:inline">Eliminar</span>
        </button>
      `;
    }

    function setupEventListeners() {
      // Botón nuevo reparto
      document.getElementById('newRepartoBtn')?.addEventListener('click', () => {
        editingReparto = null;
        const titleEl = document.getElementById('repartoForm-title');
        if (titleEl) titleEl.textContent = 'Nuevo Reparto';
        repartoFormManager?.open({});
      });
    }

    // Handler functions for SmartForm
    window.handleRepartoSubmit = async function(data) {
      try {
        const url = editingReparto ? `/api/repartos/${editingReparto.id}` : '/api/repartos';
        const method = editingReparto ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          repartoFormManager?.close();
          await loadData();
          
          // Mostrar notificación de éxito
          if (editingReparto) {
            showSuccess('Reparto actualizado', 'Los datos del reparto se han actualizado correctamente');
          } else {
            showSuccess('Reparto creado', 'El nuevo reparto se ha programado exitosamente');
          }
        } else {
          showError('Error', 'No se pudo guardar el reparto. Inténtalo de nuevo.');
        }
      } catch (error) {
        console.error('Error:', error);
        showError('Error de conexión', 'No se pudo conectar con el servidor');
      }
    };
    
    window.handleRepartoCancel = function() {
      editingReparto = null;
    };

    // Global functions
    window.editReparto = function(repartoId) {
      const reparto = repartos.find(r => r.id === repartoId);
      if (reparto) {
        editingReparto = reparto;
        const titleEl = document.getElementById('repartoForm-title');
        if (titleEl) titleEl.textContent = 'Editar Reparto';
        repartoFormManager?.open(reparto);
      }
    };

    window.deleteReparto = async function(repartoId) {
      if (confirm('¿Estás seguro de que quieres eliminar este reparto?')) {
        try {
          const response = await fetch(`/api/repartos/${repartoId}`, {
            method: 'DELETE'
          });

          if (response.ok) {
            await loadData();
            showSuccess('Reparto eliminado', 'El reparto se ha eliminado correctamente');
          } else {
            showError('Error', 'No se pudo eliminar el reparto');
          }
        } catch (error) {
          console.error('Error:', error);
          showError('Error de conexión', 'No se pudo conectar con el servidor');
        }
      }
    };
  </script>

  <style>
    /* Transiciones suaves para el loading */
    #mainContent {
      transition: opacity 0.3s ease-in-out;
    }
    
    #loading {
      transition: opacity 0.3s ease-in-out;
    }
  </style>
</Layout>