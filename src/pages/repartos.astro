---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gestión de Repartos - Sistema de Repartos">
  <div id="app" class="min-h-screen bg-gray-50">
    <!-- Loading state -->
    <div id="loading" class="flex items-center justify-center min-h-screen">
      <div class="animate-spin rounded-full h-32 w-32 border-b-2 border-blue-600"></div>
    </div>

    <!-- Main content -->
    <div id="mainContent" class="hidden">
      <!-- Header -->
      <header class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-center py-4">
            <div>
              <h1 class="text-2xl font-bold text-gray-900">Gestión de Repartos</h1>
              <p class="text-gray-600">Administra las rutas y asignaciones</p>
            </div>
            <div class="flex items-center space-x-4">
              <button 
                id="addRepartoBtn"
                class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors"
              >
                + Nuevo Reparto
              </button>
              <span id="userName" class="text-gray-700"></span>
              <button 
                id="logoutBtn"
                class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg transition-colors"
              >
                Cerrar Sesión
              </button>
            </div>
          </div>
        </div>
      </header>

      <!-- Navigation -->
      <nav class="bg-blue-600 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex space-x-8">
            <a href="/dashboard" class="px-3 py-4 text-blue-100 hover:text-white hover:border-blue-300 border-b-2 border-transparent transition-colors">Dashboard</a>
            <a href="/clientes" class="px-3 py-4 text-blue-100 hover:text-white hover:border-blue-300 border-b-2 border-transparent transition-colors">Clientes</a>
            <a href="/camiones" class="px-3 py-4 text-blue-100 hover:text-white hover:border-blue-300 border-b-2 border-transparent transition-colors">Camiones</a>
            <a href="/repartos" class="px-3 py-4 text-white border-b-2 border-white font-medium">Repartos</a>
            <a href="/mapa" class="px-3 py-4 text-blue-100 hover:text-white hover:border-blue-300 border-b-2 border-transparent transition-colors">Mapa</a>
            <a href="/reportes" class="px-3 py-4 text-blue-100 hover:text-white hover:border-blue-300 border-b-2 border-transparent transition-colors">Reportes</a>
          </div>
        </div>
      </nav>

      <!-- Main Content -->
      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Filters -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Filtrar por Ruta</label>
              <select id="rutaFilter" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">Todas las rutas</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Filtrar por Camión</label>
              <select id="camionFilter" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">Todos los camiones</option>
              </select>
            </div>
            <div class="flex items-end">
              <button id="clearFilters" class="px-4 py-2 text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">
                Limpiar Filtros
              </button>
            </div>
          </div>
        </div>

        <!-- Repartos Table -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900">Lista de Repartos</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ruta</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Camión/Conductor</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Clientes Asignados</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
              </thead>
              <tbody id="repartosTableBody" class="bg-white divide-y divide-gray-200">
                <!-- Repartos will be loaded here -->
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>

    <!-- Add/Edit Reparto Modal -->
    <div id="repartoModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center p-4">
      <div class="bg-white rounded-lg shadow-xl max-w-4xl w-full max-h-screen overflow-y-auto">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 id="modalTitle" class="text-lg font-medium text-gray-900">Nuevo Reparto</h3>
        </div>
        <form id="repartoForm" class="px-6 py-4 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Ruta *</label>
              <select name="ruta_id" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">Selecciona una ruta</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Camión *</label>
              <select name="camion_id" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">Selecciona un camión</option>
              </select>
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-3">Clientes a Asignar</label>
            <div class="border border-gray-300 rounded-lg p-4 max-h-64 overflow-y-auto">
              <div id="clientesCheckboxes" class="space-y-2">
                <!-- Checkboxes will be loaded here -->
              </div>
            </div>
            <p class="text-sm text-gray-500 mt-2">Selecciona los clientes que serán incluidos en este reparto</p>
          </div>
        </form>
        
        <div class="px-6 py-4 border-t border-gray-200 flex justify-end space-x-3">
          <button id="cancelBtn" type="button" class="px-4 py-2 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-lg transition-colors">
            Cancelar
          </button>
          <button id="saveBtn" type="submit" form="repartoForm" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
            Guardar
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let repartos = [];
    let rutas = [];
    let camiones = [];
    let clientes = [];
    let editingReparto = null;

    document.addEventListener('DOMContentLoaded', async () => {
      await checkAuth();
      await loadData();
      setupEventListeners();
    });

    async function checkAuth() {
      try {
        const response = await fetch('/api/auth/check');
        const data = await response.json();
        
        if (!data.authenticated) {
          window.location.href = '/login';
          return;
        }
        
        document.getElementById('userName').textContent = data.user.nombre_completo;
      } catch (error) {
        console.error('Auth check error:', error);
        window.location.href = '/login';
      }
    }

    async function loadData() {
      try {
        const [repartosRes, rutasRes, camionesRes, clientesRes] = await Promise.all([
          fetch('/api/repartos'),
          fetch('/api/rutas'),
          fetch('/api/camiones'),
          fetch('/api/clientes')
        ]);
        
        const [repartosData, rutasData, camionesData, clientesData] = await Promise.all([
          repartosRes.json(),
          rutasRes.json(),
          camionesRes.json(),
          clientesRes.json()
        ]);
        
        if (repartosData.success) repartos = repartosData.data;
        if (rutasData.success) rutas = rutasData.data;
        if (camionesData.success) camiones = camionesData.data;
        if (clientesData.success) clientes = clientesData.data.filter(c => c.estado === 'Activo');
        
        renderRepartos();
        populateFilters();
        
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('mainContent').classList.remove('hidden');
        
      } catch (error) {
        console.error('Error loading data:', error);
      }
    }

    function populateFilters() {
      const rutaFilter = document.getElementById('rutaFilter');
      const camionFilter = document.getElementById('camionFilter');
      
      // Populate ruta filter
      rutaFilter.innerHTML = '<option value="">Todas las rutas</option>' +
        rutas.map(ruta => `<option value="${ruta.id}">${ruta.nombre}</option>`).join('');
      
      // Populate camion filter
      camionFilter.innerHTML = '<option value="">Todos los camiones</option>' +
        camiones.map(camion => `<option value="${camion.id}">${camion.nombre}</option>`).join('');
    }

    function renderRepartos(repartosToRender = repartos) {
      const tbody = document.getElementById('repartosTableBody');
      
      if (repartosToRender.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-gray-500">No hay repartos registrados</td>
          </tr>
        `;
        return;
      }
      
      tbody.innerHTML = repartosToRender.map(reparto => `
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4">
            <div class="text-sm font-medium text-gray-900">#${reparto.id}</div>
          </td>
          <td class="px-6 py-4">
            <div class="text-sm font-medium text-gray-900">${reparto.ruta_nombre || 'Sin ruta'}</div>
          </td>
          <td class="px-6 py-4">
            <div class="flex items-center">
              <div class="shrink-0 h-8 w-8">
                <div class="h-8 w-8 rounded-full bg-blue-100 flex items-center justify-center text-sm font-medium text-blue-700">
                  🚛
                </div>
              </div>
              <div class="ml-3">
                <div class="text-sm font-medium text-gray-900">${reparto.camion_nombre || 'Sin asignar'}</div>
                <div class="text-xs text-gray-500">ID: ${reparto.camion_id || 'N/A'}</div>
              </div>
            </div>
          </td>
          <td class="px-6 py-4">
            <div class="text-sm text-gray-900">
              ${reparto.clientes ? reparto.clientes.length : 0} clientes
            </div>
            ${reparto.clientes && reparto.clientes.length > 0 ? 
              `<div class="text-xs text-gray-500 max-w-xs truncate">
                ${reparto.clientes.map(c => c.nombre).join(', ')}
              </div>` : 
              '<div class="text-xs text-gray-400">Sin clientes asignados</div>'
            }
          </td>
          <td class="px-6 py-4">
            <div class="flex space-x-2">
              <button onclick="editReparto(${reparto.id})" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                Editar
              </button>
              <button onclick="deleteReparto(${reparto.id})" class="text-red-600 hover:text-red-800 text-sm font-medium">
                Eliminar
              </button>
            </div>
          </td>
        </tr>
      `).join('');
    }

    function setupEventListeners() {
      // Filters
      document.getElementById('rutaFilter').addEventListener('change', filterRepartos);
      document.getElementById('camionFilter').addEventListener('change', filterRepartos);
      document.getElementById('clearFilters').addEventListener('click', clearFilters);
      
      // Modal controls
      document.getElementById('addRepartoBtn').addEventListener('click', () => openModal());
      document.getElementById('cancelBtn').addEventListener('click', closeModal);
      document.getElementById('repartoForm').addEventListener('submit', saveReparto);
      
      // Logout
      document.getElementById('logoutBtn').addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/login';
      });
    }

    function filterRepartos() {
      const rutaId = document.getElementById('rutaFilter').value;
      const camionId = document.getElementById('camionFilter').value;
      
      let filtered = repartos.filter(reparto => {
        const matchesRuta = !rutaId || reparto.ruta_id == rutaId;
        const matchesCamion = !camionId || reparto.camion_id == camionId;
        return matchesRuta && matchesCamion;
      });
      
      renderRepartos(filtered);
    }

    function clearFilters() {
      document.getElementById('rutaFilter').value = '';
      document.getElementById('camionFilter').value = '';
      renderRepartos();
    }

    function openModal(reparto = null) {
      editingReparto = reparto;
      const modal = document.getElementById('repartoModal');
      const title = document.getElementById('modalTitle');
      const form = document.getElementById('repartoForm');
      
      // Populate select options
      const rutaSelect = form.querySelector('[name="ruta_id"]');
      const camionSelect = form.querySelector('[name="camion_id"]');
      
      rutaSelect.innerHTML = '<option value="">Selecciona una ruta</option>' +
        rutas.map(ruta => `<option value="${ruta.id}">${ruta.nombre}</option>`).join('');
      
      camionSelect.innerHTML = '<option value="">Selecciona un camión</option>' +
        camiones.map(camion => `<option value="${camion.id}">${camion.nombre}</option>`).join('');
      
      // Populate clientes checkboxes
      const clientesContainer = document.getElementById('clientesCheckboxes');
      clientesContainer.innerHTML = clientes.map(cliente => `
        <label class="flex items-center space-x-2 p-2 hover:bg-gray-50 rounded">
          <input type="checkbox" name="cliente_ids" value="${cliente.id}" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
          <div class="flex-1">
            <div class="text-sm font-medium text-gray-900">${cliente.nombre}</div>
            <div class="text-xs text-gray-500">${cliente.razonsocial}</div>
            <div class="text-xs text-gray-400">${cliente.direccion}</div>
          </div>
        </label>
      `).join('');
      
      if (reparto) {
        title.textContent = 'Editar Reparto';
        rutaSelect.value = reparto.ruta_id || '';
        camionSelect.value = reparto.camion_id || '';
        
        // Check assigned clients
        if (reparto.clientes) {
          reparto.clientes.forEach(cliente => {
            const checkbox = form.querySelector(`[name="cliente_ids"][value="${cliente.cliente_id}"]`);
            if (checkbox) checkbox.checked = true;
          });
        }
      } else {
        title.textContent = 'Nuevo Reparto';
        form.reset();
      }
      
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      const modal = document.getElementById('repartoModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      editingReparto = null;
    }

    async function saveReparto(e) {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const repartoData = {
        camion_id: parseInt(formData.get('camion_id')),
        ruta_id: parseInt(formData.get('ruta_id')),
        cliente_ids: formData.getAll('cliente_ids').map(id => parseInt(id))
      };
      
      try {
        const url = editingReparto ? `/api/repartos/${editingReparto.id}` : '/api/repartos';
        const method = editingReparto ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(repartoData)
        });
        
        const data = await response.json();
        
        if (data.success) {
          closeModal();
          await loadData(); // Reload data
        } else {
          alert('Error al guardar reparto: ' + data.error);
        }
      } catch (error) {
        console.error('Error saving reparto:', error);
        alert('Error de conexión');
      }
    }

    window.editReparto = async function(repartoId) {
      try {
        const response = await fetch(`/api/repartos/${repartoId}`);
        const data = await response.json();
        
        if (data.success) {
          openModal(data.data);
        }
      } catch (error) {
        console.error('Error loading reparto:', error);
      }
    }

    window.deleteReparto = async function(repartoId) {
      if (confirm('¿Estás seguro de eliminar este reparto?')) {
        try {
          const response = await fetch(`/api/repartos/${repartoId}`, {
            method: 'DELETE'
          });
          
          const data = await response.json();
          
          if (data.success) {
            await loadData(); // Reload data
          } else {
            alert('Error al eliminar reparto: ' + data.error);
          }
        } catch (error) {
          console.error('Error deleting reparto:', error);
          alert('Error de conexión');
        }
      }
    }
  </script>
</Layout>