---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import LoadingSpinner from '../components/LoadingSpinner.astro';
---

<Layout title="Repartos - Sistema de Gestión">
  <Navigation currentPage="repartos" />
  
  <LoadingSpinner message="Cargando repartos..." />

  <main id="mainContent" class="max-w-7xl mx-auto px-6 lg:px-8 py-8 hidden">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Gestión de Repartos</h1>
      <p class="text-gray-600">Administra las entregas y rutas de distribución</p>
    </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Total</p>
                <p id="totalRepartos" class="text-2xl font-bold text-blue-600">0</p>
              </div>
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Pendientes</p>
                <p id="pendientesRepartos" class="text-2xl font-bold text-yellow-600">0</p>
              </div>
              <div class="w-12 h-12 bg-yellow-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">En Curso</p>
                <p id="enCursoRepartos" class="text-2xl font-bold text-orange-600">0</p>
              </div>
              <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Completados</p>
                <p id="completadosRepartos" class="text-2xl font-bold text-green-600">0</p>
              </div>
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Tabla de Repartos -->
        <div class="bg-white rounded-lg shadow">
          <div class="px-6 py-4 border-b border-gray-200">
            <div class="flex items-center justify-between">
              <h2 class="text-lg font-medium text-gray-900">Repartos</h2>
              <button id="newRepartoBtn" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
                <svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                Nuevo Reparto
              </button>
            </div>
          </div>
          <div id="repartoTableContainer" class="p-6">
            <div class="text-center py-8">
              <p class="text-gray-500">Cargando repartos...</p>
            </div>
          </div>
        </div>
    </main>

    <!-- Add/Edit Reparto Modal -->
    <div id="repartoModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center p-4">
      <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-screen overflow-y-auto">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 id="modalTitle" class="text-lg font-medium text-gray-900">Nuevo Reparto</h3>
        </div>
        <form id="repartoForm" class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Cliente *</label>
              <input type="text" name="cliente" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Dirección *</label>
              <input type="text" name="direccion" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Fecha de Entrega *</label>
              <input type="date" name="fecha_entrega" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Estado *</label>
              <select name="estado" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">Seleccionar estado</option>
                <option value="Pendiente">Pendiente</option>
                <option value="En Curso">En Curso</option>
                <option value="Completado">Completado</option>
                <option value="Cancelado">Cancelado</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Camión</label>
              <input type="text" name="camion" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Conductor</label>
              <input type="text" name="conductor" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 mb-1">Observaciones</label>
              <textarea name="observaciones" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></textarea>
            </div>
          </div>
        </form>
        
        <div class="px-6 py-4 border-t border-gray-200 flex justify-end space-x-3">
          <button id="cancelBtn" type="button" class="px-4 py-2 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-lg transition-colors">
            Cancelar
          </button>
          <button type="submit" form="repartoForm" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
            Guardar
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let repartos = [];
    let editingReparto = null;

    document.addEventListener('DOMContentLoaded', async () => {
      const startTime = Date.now();
      const minLoadingTime = 1000; // Tiempo mínimo de loading: 1 segundo
      
      try {
        await checkAuth();
        await loadData();
        setupEventListeners();
      } catch (error) {
        console.error('Initialization error:', error);
      } finally {
        // Asegurar tiempo mínimo de loading para mejor UX
        const elapsedTime = Date.now() - startTime;
        const remainingTime = Math.max(0, minLoadingTime - elapsedTime);
        
        setTimeout(() => {
          const loading = document.getElementById('loading');
          const mainContent = document.getElementById('mainContent');
          
          if (loading) {
            loading.style.opacity = '0';
            setTimeout(() => {
              loading.classList.add('hidden');
            }, 300);
          }
          if (mainContent) {
            mainContent.classList.remove('hidden');
            mainContent.style.opacity = '0';
            setTimeout(() => {
              mainContent.style.opacity = '1';
            }, 50);
          }
        }, remainingTime);
      }
    });

    async function checkAuth() {
      try {
        const response = await fetch('/api/auth/check');
        const data = await response.json();
        
        if (!data.authenticated) {
          window.location.href = '/login';
          return;
        }
      } catch (error) {
        console.error('Auth check error:', error);
        window.location.href = '/login';
      }
    }

    async function loadData() {
      try {
        const response = await fetch('/api/repartos');
        const result = await response.json();
        
        if (result.success) {
          repartos = result.data || [];
          updateStats();
          renderRepartosTable();
        } else {
          console.error('Error loading data:', result.message);
        }
        
      } catch (error) {
        console.error('Error loading data:', error);
      }
    }

    function updateStats() {
      const total = repartos.length;
      const pendientes = repartos.filter(r => r.estado === 'Pendiente').length;
      const enCurso = repartos.filter(r => r.estado === 'En Curso').length;
      const completados = repartos.filter(r => r.estado === 'Completado').length;
      
      document.getElementById('totalRepartos').textContent = total.toString();
      document.getElementById('pendientesRepartos').textContent = pendientes.toString();
      document.getElementById('enCursoRepartos').textContent = enCurso.toString();
      document.getElementById('completadosRepartos').textContent = completados.toString();
    }

    function renderRepartosTable() {
      const container = document.getElementById('repartoTableContainer');
      if (!container) return;

      if (repartos.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8">
            <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
            <p class="text-lg font-medium text-gray-900">No hay repartos</p>
            <p class="text-gray-500">Comienza agregando tu primer reparto</p>
          </div>
        `;
        return;
      }

      const tableHTML = `
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dirección</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Camión</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              ${repartos.map(reparto => `
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    ${reparto.cliente || '-'}
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500">
                    ${reparto.direccion || '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-center">
                    ${reparto.fecha_entrega ? new Date(reparto.fecha_entrega).toLocaleDateString() : '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
                      reparto.estado === 'Completado' ? 'bg-green-100 text-green-800' : 
                      reparto.estado === 'En Curso' ? 'bg-orange-100 text-orange-800' :
                      reparto.estado === 'Pendiente' ? 'bg-yellow-100 text-yellow-800' :
                      'bg-red-100 text-red-800'
                    }">
                      ${reparto.estado || 'Pendiente'}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    ${reparto.camion || '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <button onclick="editReparto(${reparto.id})" class="text-blue-600 hover:text-blue-900 mr-2">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                    </button>
                    <button onclick="deleteReparto(${reparto.id})" class="text-red-600 hover:text-red-900">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                    </button>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `;

      container.innerHTML = tableHTML;
    }

    function setupEventListeners() {
      // Botón nuevo reparto
      document.getElementById('newRepartoBtn')?.addEventListener('click', () => {
        editingReparto = null;
        document.getElementById('modalTitle').textContent = 'Nuevo Reparto';
        const form = document.getElementById('repartoForm') as HTMLFormElement;
        if (form) form.reset();
        document.getElementById('repartoModal')?.classList.remove('hidden');
      });

      // Cerrar modal
      document.getElementById('cancelBtn')?.addEventListener('click', () => {
        document.getElementById('repartoModal')?.classList.add('hidden');
      });

      // Submit formulario
      document.getElementById('repartoForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(e.target as HTMLFormElement);
        const repartoData = Object.fromEntries(formData);

        try {
          const url = editingReparto ? `/api/repartos/${editingReparto.id}` : '/api/repartos';
          const method = editingReparto ? 'PUT' : 'POST';
          
          const response = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(repartoData)
          });

          if (response.ok) {
            document.getElementById('repartoModal')?.classList.add('hidden');
            await loadData();
          } else {
            alert('Error al guardar el reparto');
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error al guardar el reparto');
        }
      });
    }

    // Global functions
    window.editReparto = function(repartoId) {
      const reparto = repartos.find(r => r.id === repartoId);
      if (reparto) {
        editingReparto = reparto;
        document.getElementById('modalTitle').textContent = 'Editar Reparto';
        
        // Fill form
        const form = document.getElementById('repartoForm');
        if (form) {
          const inputs = form.querySelectorAll('input, select, textarea');
          inputs.forEach(input => {
            const name = input.getAttribute('name');
            if (name && reparto[name] !== undefined) {
              if (name === 'fecha_entrega' && reparto[name]) {
                input.value = new Date(reparto[name]).toISOString().split('T')[0];
              } else {
                input.value = reparto[name] || '';
              }
            }
          });
        }
        
        document.getElementById('repartoModal')?.classList.remove('hidden');
      }
    };

    window.deleteReparto = async function(repartoId) {
      if (confirm('¿Estás seguro de que quieres eliminar este reparto?')) {
        try {
          const response = await fetch(`/api/repartos/${repartoId}`, {
            method: 'DELETE'
          });

          if (response.ok) {
            await loadData();
          } else {
            alert('Error al eliminar el reparto');
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error al eliminar el reparto');
        }
      }
    };
  </script>

  <style>
    /* Transiciones suaves para el loading */
    #mainContent {
      transition: opacity 0.3s ease-in-out;
    }
    
    #loading {
      transition: opacity 0.3s ease-in-out;
    }
  </style>
</Layout>