    async function saveCamion(e) {
      try {
        const formData = new FormData(e.target as HTMLFormElement);
        const camionData = Object.fromEntries(formData);
        
        const url = editingCamion ? `/api/camiones/${editingCamion.id}` : '/api/camiones';
        const method = editingCamion ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(camionData)
        });
        
        const result = await response.json();
        
        if (result.success) {
          await loadData();
          closeModal();
          showToast(editingCamion ? 'Camión actualizado exitosamente' : 'Camión creado exitosamente', 'success');
        } else {
          showToast(result.message || 'Error al guardar camión', 'error');
        }
      } catch (error) {
        console.error('Error saving camion:', error);
        showToast('Error al guardar camión', 'error');
      }
    }

