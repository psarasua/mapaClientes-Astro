---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import MotionSimple from '../components/MotionSimple.astro';
---

<Layout title="Gestión de Camiones - Sistema de Repartos">
  <MotionSimple />
  <div id="app" class="min-h-screen bg-gray-50">
    <!-- Loading state -->
    <div id="loading" class="flex items-center justify-center min-h-screen">
      <div class="flex flex-col items-center space-y-4">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
        <p class="text-gray-600 font-medium">Cargando camiones...</p>
      </div>
    </div>

    <!-- Main content -->
    <div id="mainContent" class="hidden">
      <Navigation currentPage="camiones" />

      <!-- Content -->
      <main class="max-w-7xl mx-auto px-6 lg:px-8 py-8">
        <!-- Header de página -->
        <div class="flex justify-between items-center mb-8">
          <div>
            <h2 class="text-3xl font-bold text-gray-900" style="font-family: Inter;">Gestión de Flota</h2>
            <p class="text-gray-600 mt-2">Administra tus vehículos y conductores</p>
          </div>
          <button 
            id="addTruckBtn"
            class="btn-primary"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Nuevo Camión
          </button>
        </div>

        <!-- Estadísticas rápidas -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="card">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Total Camiones</p>
                <p id="totalTrucks" class="text-2xl font-bold text-gray-900" style="font-family: Inter;">0</p>
              </div>
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2v0a2 2 0 01-2-2v-2a2 2 0 00-2-2H8z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Disponibles</p>
                <p id="availableTrucks" class="text-2xl font-bold text-green-600" style="font-family: Inter;">0</p>
              </div>
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">En Ruta</p>
                <p id="busyTrucks" class="text-2xl font-bold text-orange-600" style="font-family: Inter;">0</p>
              </div>
              <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Filtros y búsqueda -->
        <div class="card mb-8">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex-1 max-w-md">
              <label for="searchTrucks" class="sr-only">Buscar camiones</label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
                <input 
                  type="text" 
                  id="searchTrucks" 
                  class="input-field pl-10" 
                  placeholder="Buscar por patente, modelo o conductor..."
                />
              </div>
            </div>
            <div class="flex items-center space-x-3">
              <select id="filterEstado" class="input-field">
                <option value="">Todos los estados</option>
                <option value="disponible">Disponible</option>
                <option value="en_ruta">En Ruta</option>
                <option value="mantenimiento">Mantenimiento</option>
              </select>
              <button id="refreshBtn" class="btn-outline">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
                Actualizar
              </button>
            </div>
          </div>
        </div>

        <!-- Lista de camiones -->
        <div class="card">
          <div class="overflow-hidden">
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                      Vehículo
                    </th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                      Conductor
                    </th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                      Capacidad
                    </th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                      Estado
                    </th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                      Acciones
                    </th>
                  </tr>
                </thead>
                <tbody id="trucksTableBody" class="bg-white divide-y divide-gray-200">
                  <!-- Camiones will be loaded here -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
        </div>
      </nav>

      <!-- Main Content -->
      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="shrink-0">
                <div class="bg-green-500 rounded-lg p-3 text-white text-2xl">🚛</div>
              </div>
              <div class="ml-4">
                <p class="text-sm font-medium text-gray-600">Total Camiones</p>
                <p id="totalTrucks" class="text-2xl font-semibold text-gray-900">0</p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="shrink-0">
                <div class="bg-blue-500 rounded-lg p-3 text-white text-2xl">📦</div>
              </div>
              <div class="ml-4">
                <p class="text-sm font-medium text-gray-600">En Repartos</p>
                <p id="trucksInDelivery" class="text-2xl font-semibold text-gray-900">0</p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="shrink-0">
                <div class="bg-yellow-500 rounded-lg p-3 text-white text-2xl">🔧</div>
              </div>
              <div class="ml-4">
                <p class="text-sm font-medium text-gray-600">Disponibles</p>
                <p id="availableTrucks" class="text-2xl font-semibold text-gray-900">0</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Trucks Table -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900">Lista de Camiones</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Conductor</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Repartos Asignados</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
              </thead>
              <tbody id="trucksTableBody" class="bg-white divide-y divide-gray-200">
                <!-- Trucks will be loaded here -->
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>

    <!-- Add/Edit Truck Modal -->
    <div id="truckModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center p-4">
      <div class="bg-white rounded-lg shadow-xl max-w-md w-full">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 id="modalTitle" class="text-lg font-medium text-gray-900">Nuevo Camión</h3>
        </div>
        <form id="truckForm" class="px-6 py-4 space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nombre del Conductor *</label>
            <input type="text" name="nombre" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="Ej: Juan Pérez">
          </div>
        </form>
        
        <div class="px-6 py-4 border-t border-gray-200 flex justify-end space-x-3">
          <button id="cancelBtn" type="button" class="px-4 py-2 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-lg transition-colors">
            Cancelar
          </button>
          <button id="saveBtn" type="submit" form="truckForm" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
            Guardar
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let trucks = [];
    let repartos = [];
    let editingTruck = null;

    document.addEventListener('DOMContentLoaded', async () => {
      await checkAuth();
      await loadData();
      setupEventListeners();
    });

    async function checkAuth() {
      try {
        const response = await fetch('/api/auth/check');
        const data = await response.json();
        
        if (!data.authenticated) {
          window.location.href = '/login';
          return;
        }
        
        document.getElementById('userName').textContent = data.user.nombre_completo;
      } catch (error) {
        console.error('Auth check error:', error);
        window.location.href = '/login';
      }
    }

    async function loadData() {
      try {
        // Load trucks and repartos in parallel
        const [trucksResponse, repartosResponse] = await Promise.all([
          fetch('/api/camiones'),
          fetch('/api/repartos')
        ]);
        
        const trucksData = await trucksResponse.json();
        const repartosData = await repartosResponse.json();
        
        if (trucksData.success) {
          trucks = trucksData.data;
        }
        
        if (repartosData.success) {
          repartos = repartosData.data;
        }
        
        renderTrucks();
        updateStats();
        
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('mainContent').classList.remove('hidden');
        
      } catch (error) {
        console.error('Error loading data:', error);
      }
    }

    function updateStats() {
      const totalTrucks = trucks.length;
      const trucksInDelivery = new Set(repartos.map(r => r.camion_id)).size;
      const availableTrucks = totalTrucks - trucksInDelivery;
      
      document.getElementById('totalTrucks').textContent = totalTrucks;
      document.getElementById('trucksInDelivery').textContent = trucksInDelivery;
      document.getElementById('availableTrucks').textContent = availableTrucks;
    }

    function renderTrucks() {
      const tbody = document.getElementById('trucksTableBody');
      
      if (trucks.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-gray-500">No hay camiones registrados</td>
          </tr>
        `;
        return;
      }
      
      tbody.innerHTML = trucks.map(truck => {
        const truckRepartos = repartos.filter(r => r.camion_id === truck.id);
        const isInDelivery = truckRepartos.length > 0;
        
        return `
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <div class="text-sm font-medium text-gray-900">#${truck.id}</div>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-8 w-8">
                  <div class="h-8 w-8 rounded-full bg-gray-300 flex items-center justify-center text-sm font-medium text-gray-700">
                    ${truck.nombre.charAt(0).toUpperCase()}
                  </div>
                </div>
                <div class="ml-3">
                  <div class="text-sm font-medium text-gray-900">${truck.nombre}</div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4">
              <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
                isInDelivery ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800'
              }">
                ${isInDelivery ? 'En Reparto' : 'Disponible'}
              </span>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-gray-900">
                ${truckRepartos.length} repartos activos
              </div>
              ${truckRepartos.length > 0 ? 
                `<div class="text-xs text-gray-500">
                  Rutas: ${truckRepartos.map(r => r.ruta_nombre).join(', ')}
                </div>` : 
                '<div class="text-xs text-gray-400">Sin asignaciones</div>'
              }
            </td>
            <td class="px-6 py-4">
              <div class="flex space-x-2">
                <button onclick="editTruck(${truck.id})" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                  Editar
                </button>
                <button onclick="deleteTruck(${truck.id})" class="text-red-600 hover:text-red-800 text-sm font-medium" ${isInDelivery ? 'disabled' : ''}>
                  ${isInDelivery ? 'En uso' : 'Eliminar'}
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    function setupEventListeners() {
      // Modal controls
      document.getElementById('addTruckBtn').addEventListener('click', () => openModal());
      document.getElementById('cancelBtn').addEventListener('click', closeModal);
      document.getElementById('truckForm').addEventListener('submit', saveTruck);
      
      // Logout
      document.getElementById('logoutBtn').addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/login';
      });
    }

    function openModal(truck = null) {
      editingTruck = truck;
      const modal = document.getElementById('truckModal');
      const title = document.getElementById('modalTitle');
      const form = document.getElementById('truckForm');
      
      if (truck) {
        title.textContent = 'Editar Camión';
        form.querySelector('[name="nombre"]').value = truck.nombre;
      } else {
        title.textContent = 'Nuevo Camión';
        form.reset();
      }
      
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      const modal = document.getElementById('truckModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      editingTruck = null;
    }

    async function saveTruck(e) {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const truckData = Object.fromEntries(formData.entries());
      
      try {
        const url = editingTruck ? `/api/camiones/${editingTruck.id}` : '/api/camiones';
        const method = editingTruck ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(truckData)
        });
        
        const data = await response.json();
        
        if (data.success) {
          closeModal();
          await loadData(); // Reload data
        } else {
          alert('Error al guardar camión: ' + data.error);
        }
      } catch (error) {
        console.error('Error saving truck:', error);
        alert('Error de conexión');
      }
    }

    window.editTruck = function(truckId) {
      const truck = trucks.find(t => t.id === truckId);
      if (truck) {
        openModal(truck);
      }
    }

    window.deleteTruck = async function(truckId) {
      const truck = trucks.find(t => t.id === truckId);
      if (!truck) return;
      
      if (confirm(`¿Estás seguro de eliminar el camión de ${truck.nombre}?`)) {
        try {
          const response = await fetch(`/api/camiones/${truckId}`, {
            method: 'DELETE'
          });
          
          const data = await response.json();
          
          if (data.success) {
            await loadData(); // Reload data
          } else {
            alert('Error al eliminar camión: ' + data.error);
          }
        } catch (error) {
          console.error('Error deleting truck:', error);
          alert('Error de conexión');
        }
      }
    }
  </script>
</Layout>