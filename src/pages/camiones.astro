---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import LoadingSpinner from '../components/LoadingSpinner.astro';
import SmartForm from '../components/forms/SmartForm.astro';
import SmartInput from '../components/forms/SmartInput.astro';
import SmartSelect from '../components/forms/SmartSelect.astro';
---

<Layout title="Camiones - Sistema de Gestión">
  <Navigation currentPage="camiones" />
  
  <LoadingSpinner message="Cargando camiones..." />

  <main id="mainContent" class="max-w-7xl mx-auto px-6 lg:px-8 py-8 hidden">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Gestión de Camiones</h1>
      <p class="text-gray-600">Administra tu flota de vehículos</p>
    </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Total</p>
                <p id="totalCamiones" class="text-2xl font-bold text-blue-600">0</p>
              </div>
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Activos</p>
                <p id="activosCamiones" class="text-2xl font-bold text-green-600">0</p>
              </div>
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Mantenimiento</p>
                <p id="mantenimientoCamiones" class="text-2xl font-bold text-orange-600">0</p>
              </div>
              <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Disponibles</p>
                <p id="disponiblesCamiones" class="text-2xl font-bold text-blue-600">0</p>
              </div>
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Tabla de Camiones -->
        <div class="bg-white rounded-lg shadow">
          <div class="px-6 py-4 border-b border-gray-200">
            <div class="flex items-center justify-between">
              <h2 class="text-lg font-medium text-gray-900">Camiones</h2>
              <button id="newCamionBtn" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
                <svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                Nuevo Camión
              </button>
            </div>
          </div>
          <div id="camionTableContainer" class="p-6">
            <div class="text-center py-8">
              <p class="text-gray-500">Cargando camiones...</p>
            </div>
          </div>
        </div>
    </main>

    <!-- Smart Form Modal for Camions -->
    <SmartForm 
      id="camionForm" 
      title="Nuevo Camión"
      onSubmit="handleCamionSubmit"
      onCancel="handleCamionCancel"
      autoSave={true}
      autoSaveInterval={30000}
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <SmartInput
          name="matricula"
          label="Matrícula"
          type="text"
          required={true}
          maxLength={20}
          icon="truck"
          placeholder="Ej: ABC-1234"
        />
        
        <SmartInput
          name="marca"
          label="Marca"
          type="text"
          required={true}
          maxLength={50}
          icon="tag"
          placeholder="Ej: Mercedes"
        />
        
        <SmartInput
          name="modelo"
          label="Modelo"
          type="text"
          required={true}
          maxLength={50}
          icon="cog"
          placeholder="Ej: Actros 1840"
        />
        
        <SmartInput
          name="capacidad_kg"
          label="Capacidad (kg)"
          type="number"
          required={true}
          min={100}
          max={50000}
          icon="scale"
          placeholder="Ej: 18000"
        />
        
        <SmartSelect
          name="estado"
          label="Estado"
          required={true}
          options={[
            { value: 'Activo', label: 'Activo' },
            { value: 'Disponible', label: 'Disponible' },
            { value: 'Mantenimiento', label: 'Mantenimiento' },
            { value: 'Inactivo', label: 'Inactivo' }
          ]}
        />
        
        <SmartInput
          name="fecha_adquisicion"
          label="Fecha de Adquisición"
          type="date"
          icon="calendar"
        />
      </div>
    </SmartForm>
  </div>

  <script>
    let camiones = [];
    let editingCamion = null;
    let camionFormManager = null;

    document.addEventListener('DOMContentLoaded', async () => {
      const startTime = Date.now();
      const minLoadingTime = 1000; // Tiempo mínimo de loading: 1 segundo
      
      try {
        await checkAuth();
        await loadData();
        setupEventListeners();
        
        // Initialize smart form manager
        camionFormManager = new SmartFormManager('camionForm', {
          autoSave: true,
          autoSaveInterval: 30000,
          onSubmit: 'handleCamionSubmit',
          onCancel: 'handleCamionCancel'
        });
        
      } catch (error) {
        console.error('Initialization error:', error);
      } finally {
        // Asegurar tiempo mínimo de loading para mejor UX
        const elapsedTime = Date.now() - startTime;
        const remainingTime = Math.max(0, minLoadingTime - elapsedTime);
        
        setTimeout(() => {
          const loading = document.getElementById('loading');
          const mainContent = document.getElementById('mainContent');
          
          if (loading) {
            loading.style.opacity = '0';
            setTimeout(() => {
              loading.classList.add('hidden');
            }, 300);
          }
          if (mainContent) {
            mainContent.classList.remove('hidden');
            mainContent.style.opacity = '0';
            setTimeout(() => {
              mainContent.style.opacity = '1';
            }, 50);
          }
        }, remainingTime);
      }
    });

    async function checkAuth() {
      try {
        const response = await fetch('/api/auth/check');
        const data = await response.json();
        
        if (!data.authenticated) {
          window.location.href = '/login';
          return;
        }
      } catch (error) {
        console.error('Auth check error:', error);
        window.location.href = '/login';
      }
    }

    async function loadData() {
      try {
        const response = await fetch('/api/camiones');
        const result = await response.json();
        
        if (result.success) {
          camiones = result.data || [];
          updateStats();
          renderCamionesTable();
        } else {
          console.error('Error loading data:', result.message);
        }
        
      } catch (error) {
        console.error('Error loading data:', error);
      }
    }

    function updateStats() {
      const total = camiones.length;
      const activos = camiones.filter(c => c.estado === 'Activo').length;
      const enMantenimiento = camiones.filter(c => c.estado === 'Mantenimiento').length;
      const disponibles = camiones.filter(c => c.estado === 'Disponible').length;
      
      document.getElementById('totalCamiones').textContent = total.toString();
      document.getElementById('activosCamiones').textContent = activos.toString();
      document.getElementById('mantenimientoCamiones').textContent = enMantenimiento.toString();
      document.getElementById('disponiblesCamiones').textContent = disponibles.toString();
    }

    function renderCamionesTable() {
      const container = document.getElementById('camionTableContainer');
      if (!container) return;

      if (camiones.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8">
            <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"></path>
            </svg>
            <p class="text-lg font-medium text-gray-900">No hay camiones</p>
            <p class="text-gray-500">Comienza agregando tu primer camión</p>
          </div>
        `;
        return;
      }

      const tableHTML = `
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Matrícula</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Marca</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Modelo</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Capacidad</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              ${camiones.map(camion => `
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    ${camion.matricula || '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    ${camion.marca || '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    ${camion.modelo || '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
                      camion.estado === 'Activo' ? 'bg-green-100 text-green-800' : 
                      camion.estado === 'Disponible' ? 'bg-blue-100 text-blue-800' :
                      camion.estado === 'Mantenimiento' ? 'bg-yellow-100 text-yellow-800' :
                      'bg-red-100 text-red-800'
                    }">
                      ${camion.estado || 'Inactivo'}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-center">
                    ${camion.capacidad_kg ? `${camion.capacidad_kg} kg` : '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <button onclick="editCamion(${camion.id})" class="text-blue-600 hover:text-blue-900 mr-2">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                    </button>
                    <button onclick="deleteCamion(${camion.id})" class="text-red-600 hover:text-red-900">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                    </button>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `;

      container.innerHTML = tableHTML;
    }

    function setupEventListeners() {
      // Botón nuevo camión
      document.getElementById('newCamionBtn')?.addEventListener('click', () => {
        editingCamion = null;
        const titleEl = document.getElementById('camionForm-title');
        if (titleEl) titleEl.textContent = 'Nuevo Camión';
        camionFormManager?.open({});
      });
    }

    // Handler functions for SmartForm
    window.handleCamionSubmit = async function(data) {
      try {
        const url = editingCamion ? `/api/camiones/${editingCamion.id}` : '/api/camiones';
        const method = editingCamion ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          camionFormManager?.close();
          await loadData();
          
          // Mostrar notificación de éxito
          if (editingCamion) {
            showSuccess('Camión actualizado', 'Los datos del camión se han actualizado correctamente');
          } else {
            showSuccess('Camión creado', 'El nuevo camión se ha agregado exitosamente');
          }
        } else {
          showError('Error', 'No se pudo guardar el camión. Inténtalo de nuevo.');
        }
      } catch (error) {
        console.error('Error:', error);
        showError('Error de conexión', 'No se pudo conectar con el servidor');
      }
    };
    
    window.handleCamionCancel = function() {
      editingCamion = null;
    };

    // Global functions
    window.editCamion = function(camionId) {
      const camion = camiones.find(c => c.id === camionId);
      if (camion) {
        editingCamion = camion;
        const titleEl = document.getElementById('camionForm-title');
        if (titleEl) titleEl.textContent = 'Editar Camión';
        camionFormManager?.open(camion);
      }
    };

    window.deleteCamion = async function(camionId) {
      if (confirm('¿Estás seguro de que quieres eliminar este camión?')) {
        try {
          const response = await fetch(`/api/camiones/${camionId}`, {
            method: 'DELETE'
          });

          if (response.ok) {
            await loadData();
            showSuccess('Camión eliminado', 'El camión se ha eliminado correctamente');
          } else {
            showError('Error', 'No se pudo eliminar el camión');
          }
        } catch (error) {
          console.error('Error:', error);
          showError('Error de conexión', 'No se pudo conectar con el servidor');
        }
      }
    };
  </script>

  <style>
    /* Transiciones suaves para el loading */
    #mainContent {
      transition: opacity 0.3s ease-in-out;
    }
    
    #loading {
      transition: opacity 0.3s ease-in-out;
    }
  </style>
</Layout>