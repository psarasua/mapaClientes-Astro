---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import MotionSimple from '../components/MotionSimple.astro';
---

<Layout title="Reportes y Análisis - Sistema de Repartos">
  <MotionSimple />
  <div id="app" class="min-h-screen bg-gray-50">
    <!-- Loading state -->
    <div id="loading" class="flex items-center justify-center min-h-screen">
      <div class="flex flex-col items-center space-y-4">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
        <p class="text-gray-600 font-medium">Generando reportes...</p>
      </div>
    </div>

    <!-- Main content -->
    <div id="mainContent" class="hidden">
      <Navigation currentPage="reportes" />

      <!-- Content -->
      <main class="max-w-7xl mx-auto px-6 lg:px-8 py-8">
        <!-- Header de página -->
        <div class="flex justify-between items-center mb-8">
          <div>
            <h2 class="text-3xl font-bold text-gray-900" style="font-family: Inter;">Reportes y Análisis</h2>
            <p class="text-gray-600 mt-2">Estadísticas detalladas y análisis del rendimiento</p>
          </div>
          <div class="flex space-x-3">
            <button 
              id="refreshReports"
              class="btn-outline"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
              Actualizar
            </button>
            <button 
              id="exportBtn"
              class="btn-secondary"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              Exportar Reporte
            </button>
          </div>
        </div>

        <!-- Selector de tipo de reporte -->
        <div class="card mb-8">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex-1">
              <label for="reportType" class="block text-sm font-medium text-gray-700 mb-2">Tipo de Reporte</label>
              <select id="reportType" class="input-field">
                <option value="general">Reporte General</option>
                <option value="repartos">Análisis de Repartos</option>
                <option value="clientes">Estadísticas de Clientes</option>
                <option value="rutas">Rendimiento de Rutas</option>
                <option value="eficiencia">Análisis de Eficiencia</option>
              </select>
            </div>
            <div class="flex items-center space-x-4">
              <div>
                <label for="dateFrom" class="block text-sm font-medium text-gray-700 mb-2">Desde</label>
                <input type="date" id="dateFrom" class="input-field">
              </div>
              <div>
                <label for="dateTo" class="block text-sm font-medium text-gray-700 mb-2">Hasta</label>
                <input type="date" id="dateTo" class="input-field">
              </div>
              <button id="generateReport" class="btn-primary mt-6">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                Generar
              </button>
            </div>
          </div>
        </div>

        <!-- Métricas rápidas -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
          <div class="card">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Repartos del Mes</p>
                <p id="repartosDelMes" class="text-2xl font-bold text-blue-600" style="font-family: Inter;">0</p>
              </div>
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Eficiencia Promedio</p>
                <p id="eficienciaPromedio" class="text-2xl font-bold text-green-600" style="font-family: Inter;">0%</p>
              </div>
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Clientes Activos</p>
                <p id="clientesActivos" class="text-2xl font-bold text-orange-600" style="font-family: Inter;">0</p>
              </div>
              <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-600 mb-1">Tiempo Promedio</p>
                <p id="tiempoPromedio" class="text-2xl font-bold text-purple-600" style="font-family: Inter;">0h</p>
              </div>
              <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Contenido del reporte -->
        <div class="card">
          <div class="flex items-center justify-between mb-6">
            <h3 id="reportTitle" class="text-xl font-semibold text-gray-900" style="font-family: Inter;">Reporte General</h3>
            <div class="text-sm text-gray-500">
              Última actualización: <span id="lastUpdate">--</span>
            </div>
          </div>
          
          <div id="reportContent" class="space-y-6">
            <!-- Report content will be loaded here -->
            <div class="text-center py-12">
              <svg class="w-12 h-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <p class="text-gray-600">Selecciona un tipo de reporte y haz clic en "Generar" para ver los datos</p>
            </div>
          </div>
        </div>
        </div>
      </nav>

      <!-- Main Content -->
      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Report Type Selector -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Seleccionar Tipo de Reporte</h3>
          <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
            <button id="reportGeneral" class="report-btn px-4 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
              📊 General
            </button>
            <button id="reportRepartos" class="report-btn px-4 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
              🚛 Repartos
            </button>
            <button id="reportClientes" class="report-btn px-4 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors">
              👥 Clientes
            </button>
            <button id="reportRutas" class="report-btn px-4 py-3 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors">
              🛣️ Rutas
            </button>
            <button id="reportEficiencia" class="report-btn px-4 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
              ⚡ Eficiencia
            </button>
          </div>
        </div>

        <!-- Report Content -->
        <div id="reportContent">
          <!-- Content will be loaded dynamically -->
        </div>
      </main>
    </div>
  </div>

  <script>
    let currentReportType = 'general';
    let currentReportData = {};

    document.addEventListener('DOMContentLoaded', async () => {
      await checkAuth();
      await loadReport('general');
      setupEventListeners();
    });

    async function checkAuth() {
      try {
        const response = await fetch('/api/auth/check');
        const data = await response.json();
        
        if (!data.authenticated) {
          window.location.href = '/login';
          return;
        }
        
        document.getElementById('userName').textContent = data.user.nombre_completo;
      } catch (error) {
        console.error('Auth check error:', error);
        window.location.href = '/login';
      }
    }

    async function loadReport(tipo) {
      try {
        showLoading();
        
        const response = await fetch(`/api/reportes?tipo=${tipo}`);
        const data = await response.json();
        
        if (data.success) {
          currentReportType = tipo;
          currentReportData = data.data;
          renderReport(tipo, data.data);
        }
        
        hideLoading();
        
      } catch (error) {
        console.error('Error loading report:', error);
        hideLoading();
      }
    }

    function showLoading() {
      document.getElementById('reportContent').innerHTML = `
        <div class="flex items-center justify-center py-12">
          <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-blue-600"></div>
          <span class="ml-3 text-lg text-gray-600">Generando reporte...</span>
        </div>
      `;
    }

    function hideLoading() {
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('mainContent').classList.remove('hidden');
    }

    function renderReport(tipo, data) {
      const container = document.getElementById('reportContent');
      
      switch (tipo) {
        case 'general':
          container.innerHTML = renderGeneralReport(data);
          break;
        case 'repartos':
          container.innerHTML = renderRepartosReport(data);
          break;
        case 'clientes':
          container.innerHTML = renderClientesReport(data);
          break;
        case 'rutas':
          container.innerHTML = renderRutasReport(data);
          break;
        case 'eficiencia':
          container.innerHTML = renderEficienciaReport(data);
          break;
      }
    }

    function renderGeneralReport(data) {
      return `
        <div class="space-y-6">
          <!-- Summary Cards -->
          <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
            <div class="bg-white rounded-lg shadow p-4">
              <div class="text-center">
                <div class="text-2xl font-bold text-green-600">${data.totales.total_clientes_activos}</div>
                <div class="text-sm text-gray-600">Clientes Activos</div>
              </div>
            </div>
            <div class="bg-white rounded-lg shadow p-4">
              <div class="text-center">
                <div class="text-2xl font-bold text-blue-600">${data.totales.total_camiones}</div>
                <div class="text-sm text-gray-600">Camiones</div>
              </div>
            </div>
            <div class="bg-white rounded-lg shadow p-4">
              <div class="text-center">
                <div class="text-2xl font-bold text-purple-600">${data.totales.total_rutas}</div>
                <div class="text-sm text-gray-600">Rutas</div>
              </div>
            </div>
            <div class="bg-white rounded-lg shadow p-4">
              <div class="text-center">
                <div class="text-2xl font-bold text-yellow-600">${data.totales.total_repartos}</div>
                <div class="text-sm text-gray-600">Repartos</div>
              </div>
            </div>
            <div class="bg-white rounded-lg shadow p-4">
              <div class="text-center">
                <div class="text-2xl font-bold text-red-600">${data.totales.total_clientes_inactivos}</div>
                <div class="text-sm text-gray-600">Clientes Inactivos</div>
              </div>
            </div>
          </div>

          <!-- Charts -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Clientes por Ruta -->
            <div class="bg-white rounded-lg shadow p-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">Clientes por Ruta</h3>
              <div class="space-y-3">
                ${data.clientesPorRuta.map(item => {
                  const total = data.clientesPorRuta.reduce((acc, curr) => acc + parseInt(curr.total_clientes), 0);
                  const percentage = total > 0 ? (item.total_clientes / total) * 100 : 0;
                  return `
                    <div class="flex items-center justify-between">
                      <span class="text-sm font-medium text-gray-700">${item.ruta}</span>
                      <div class="flex items-center space-x-2">
                        <div class="w-32 bg-gray-200 rounded-full h-2">
                          <div class="bg-blue-600 h-2 rounded-full" style="width: ${percentage}%"></div>
                        </div>
                        <span class="text-sm text-gray-600 w-8">${item.total_clientes}</span>
                      </div>
                    </div>
                  `;
                }).join('')}
              </div>
            </div>

            <!-- Utilización de Camiones -->
            <div class="bg-white rounded-lg shadow p-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">Utilización de Camiones</h3>
              <div class="space-y-3">
                ${data.utilizacionCamiones.map(item => {
                  const maxRepartos = Math.max(...data.utilizacionCamiones.map(c => parseInt(c.total_repartos)));
                  const percentage = maxRepartos > 0 ? (item.total_repartos / maxRepartos) * 100 : 0;
                  return `
                    <div class="flex items-center justify-between">
                      <div>
                        <span class="text-sm font-medium text-gray-700">${item.camion}</span>
                        <div class="text-xs text-gray-500">${item.rutas_diferentes} rutas diferentes</div>
                      </div>
                      <div class="flex items-center space-x-2">
                        <div class="w-24 bg-gray-200 rounded-full h-2">
                          <div class="bg-green-600 h-2 rounded-full" style="width: ${percentage}%"></div>
                        </div>
                        <span class="text-sm text-gray-600 w-8">${item.total_repartos}</span>
                      </div>
                    </div>
                  `;
                }).join('')}
              </div>
            </div>
          </div>
        </div>
      `;
    }

    function renderRepartosReport(data) {
      return `
        <div class="space-y-6">
          <!-- Repartos Activos -->
          <div class="bg-white rounded-lg shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
              <h3 class="text-lg font-medium text-gray-900">Repartos Activos</h3>
            </div>
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ruta</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Camión</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Clientes</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  ${data.repartosActivos.map(reparto => `
                    <tr>
                      <td class="px-6 py-4 text-sm text-gray-900">#${reparto.id}</td>
                      <td class="px-6 py-4 text-sm text-gray-900">${reparto.ruta || 'Sin asignar'}</td>
                      <td class="px-6 py-4 text-sm text-gray-900">${reparto.camion || 'Sin asignar'}</td>
                      <td class="px-6 py-4 text-sm text-gray-900">${reparto.total_clientes} clientes</td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Distribución por Rutas -->
          <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Distribución por Rutas</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              ${data.distribucionRutas.map(ruta => `
                <div class="border rounded-lg p-4">
                  <h4 class="font-medium text-gray-900">${ruta.ruta}</h4>
                  <div class="mt-2 space-y-1">
                    <div class="text-sm text-gray-600">Repartos: ${ruta.total_repartos}</div>
                    <div class="text-sm text-gray-600">Promedio clientes: ${parseFloat(ruta.promedio_clientes || 0).toFixed(1)}</div>
                  </div>
                </div>
              `).join('')}
            </div>
          </div>
        </div>
      `;
    }

    function renderClientesReport(data) {
      return `
        <div class="space-y-6">
          <!-- Distribución por Estado -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white rounded-lg shadow p-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">Distribución por Estado</h3>
              <div class="space-y-3">
                ${data.estadoDistribucion.map(item => `
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-700">${item.estado}</span>
                    <div class="flex items-center space-x-2">
                      <div class="w-24 bg-gray-200 rounded-full h-2">
                        <div class="h-2 rounded-full ${item.estado === 'Activo' ? 'bg-green-600' : 'bg-red-600'}" style="width: ${item.porcentaje}%"></div>
                      </div>
                      <span class="text-sm text-gray-600">${item.total} (${item.porcentaje}%)</span>
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">Coordenadas GPS</h3>
              <div class="space-y-3">
                ${data.coordenadasStats.map(item => `
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-700">${item.tipo_coordenadas}</span>
                    <div class="flex items-center space-x-2">
                      <div class="w-24 bg-gray-200 rounded-full h-2">
                        <div class="h-2 rounded-full ${item.tipo_coordenadas === 'Con GPS' ? 'bg-blue-600' : 'bg-gray-400'}" style="width: ${(item.total / data.coordenadasStats.reduce((acc, curr) => acc + parseInt(curr.total), 0)) * 100}%"></div>
                      </div>
                      <span class="text-sm text-gray-600">${item.total}</span>
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>
          </div>

          <!-- Top Clientes -->
          <div class="bg-white rounded-lg shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
              <h3 class="text-lg font-medium text-gray-900">Top 10 Clientes por Frecuencia</h3>
            </div>
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Cliente</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Razón Social</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Repartos</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  ${data.topClientes.map((cliente, index) => `
                    <tr>
                      <td class="px-6 py-4">
                        <div class="flex items-center">
                          <div class="shrink-0 h-8 w-8 bg-blue-100 rounded-full flex items-center justify-center text-sm font-medium text-blue-700">
                            ${index + 1}
                          </div>
                          <div class="ml-3">
                            <div class="text-sm font-medium text-gray-900">${cliente.nombre}</div>
                          </div>
                        </div>
                      </td>
                      <td class="px-6 py-4 text-sm text-gray-900">${cliente.razonsocial}</td>
                      <td class="px-6 py-4 text-sm text-gray-900">${cliente.total_repartos}</td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      `;
    }

    function renderRutasReport(data) {
      return `
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900">Análisis de Rutas</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ruta</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Repartos</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Camiones Diferentes</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Clientes Únicos</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Promedio Clientes/Reparto</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                ${data.analisisRutas.map(ruta => `
                  <tr>
                    <td class="px-6 py-4 text-sm font-medium text-gray-900">${ruta.ruta}</td>
                    <td class="px-6 py-4 text-sm text-gray-900">${ruta.total_repartos}</td>
                    <td class="px-6 py-4 text-sm text-gray-900">${ruta.camiones_diferentes}</td>
                    <td class="px-6 py-4 text-sm text-gray-900">${ruta.clientes_unicos}</td>
                    <td class="px-6 py-4 text-sm text-gray-900">${parseFloat(ruta.promedio_clientes_por_reparto || 0).toFixed(1)}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }

    function renderEficienciaReport(data) {
      return `
        <div class="space-y-6">
          <!-- KPIs -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-white rounded-lg shadow p-6 text-center">
              <div class="text-3xl font-bold text-blue-600">${data.kpis.promedio_clientes_por_reparto}</div>
              <div class="text-sm text-gray-600">Promedio Clientes/Reparto</div>
            </div>
            <div class="bg-white rounded-lg shadow p-6 text-center">
              <div class="text-3xl font-bold text-green-600">${data.kpis.camiones_activos}</div>
              <div class="text-sm text-gray-600">Camiones Activos</div>
            </div>
            <div class="bg-white rounded-lg shadow p-6 text-center">
              <div class="text-3xl font-bold text-purple-600">${data.kpis.rutas_activas}</div>
              <div class="text-sm text-gray-600">Rutas Activas</div>
            </div>
            <div class="bg-white rounded-lg shadow p-6 text-center">
              <div class="text-3xl font-bold text-yellow-600">${data.kpis.clientes_en_repartos}</div>
              <div class="text-sm text-gray-600">Clientes en Repartos</div>
            </div>
          </div>

          <!-- Eficiencia de Camiones -->
          <div class="bg-white rounded-lg shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
              <h3 class="text-lg font-medium text-gray-900">Eficiencia de Camiones</h3>
            </div>
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Camión</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Total Repartos</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Rutas Cubiertas</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Clientes Servidos</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Eficiencia</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  ${data.eficienciaCamiones.map(camion => {
                    const eficiencia = parseFloat(camion.promedio_clientes_por_reparto);
                    const eficienciaClass = eficiencia >= 3 ? 'text-green-600' : eficiencia >= 2 ? 'text-yellow-600' : 'text-red-600';
                    return `
                      <tr>
                        <td class="px-6 py-4 text-sm font-medium text-gray-900">${camion.camion}</td>
                        <td class="px-6 py-4 text-sm text-gray-900">${camion.total_repartos}</td>
                        <td class="px-6 py-4 text-sm text-gray-900">${camion.rutas_cubiertas}</td>
                        <td class="px-6 py-4 text-sm text-gray-900">${camion.total_clientes_servidos}</td>
                        <td class="px-6 py-4 text-sm font-medium ${eficienciaClass}">${eficiencia} clientes/reparto</td>
                      </tr>
                    `;
                  }).join('')}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      `;
    }

    function setupEventListeners() {
      // Report type buttons
      document.getElementById('reportGeneral').addEventListener('click', () => loadReport('general'));
      document.getElementById('reportRepartos').addEventListener('click', () => loadReport('repartos'));
      document.getElementById('reportClientes').addEventListener('click', () => loadReport('clientes'));
      document.getElementById('reportRutas').addEventListener('click', () => loadReport('rutas'));
      document.getElementById('reportEficiencia').addEventListener('click', () => loadReport('eficiencia'));
      
      // Export button
      document.getElementById('exportBtn').addEventListener('click', exportReport);
      
      // Logout
      document.getElementById('logoutBtn').addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/login';
      });
    }

    function exportReport() {
      // Create a simple text export
      let exportContent = `REPORTE DEL SISTEMA DE REPARTOS\n`;
      exportContent += `Tipo: ${currentReportType.toUpperCase()}\n`;
      exportContent += `Fecha: ${new Date().toLocaleDateString()}\n`;
      exportContent += `\n` + '='.repeat(50) + `\n\n`;
      
      // Add report data as JSON for now (could be enhanced to create proper CSV/PDF)
      exportContent += JSON.stringify(currentReportData, null, 2);
      
      // Create and download file
      const blob = new Blob([exportContent], { type: 'text/plain' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `reporte_${currentReportType}_${new Date().toISOString().split('T')[0]}.txt`;
      a.click();
      window.URL.revokeObjectURL(url);
    }
  </script>
</Layout>