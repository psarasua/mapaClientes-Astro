---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import LoadingSpinner from '../components/LoadingSpinner.astro';
import LoadingSkeleton from '../components/LoadingSkeleton.astro';
import SmartForm from '../components/forms/SmartForm.astro';
import SmartInput from '../components/forms/SmartInput.astro';
import SmartSelect from '../components/forms/SmartSelect.astro';
import InteractiveButton from '../components/interactions/InteractiveButton.astro';
import InteractiveCard from '../components/interactions/InteractiveCard.astro';
import ClientDetailModal from '../components/modals/ClientDetailModal.astro';
import ResponsiveSearch from '../components/search/ResponsiveSearch.astro';
---

<Layout title="Clientes - Sistema de Gestión">
  <Navigation currentPage="clientes" />
  
  <LoadingSpinner message="Cargando clientes..." />

  <main id="mainContent" class="max-w-7xl mx-auto px-6 lg:px-8 py-8 hidden">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Gestión de Clientes</h1>
      <p class="text-gray-600">Administra tu base de clientes</p>
    </div>

        <!-- Gestión de Clientes Card -->
        <InteractiveCard 
          class="mb-8" 
          hover="lift"
          data-stagger="0.1"
        >
          <div class="px-6 py-4 border-b border-gray-200">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-lg font-medium text-gray-900">Clientes</h2>
              <InteractiveButton 
                variant="primary"
                size="md"
                class="interactive-button"
                data-button-id="newClientBtn"
              >
                <svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                Nuevo Cliente
              </InteractiveButton>
            </div>
            <!-- Búsqueda responsiva -->
            <ResponsiveSearch 
              id="clientSearch"
              placeholder="Buscar clientes por nombre, email o teléfono..."
              onSearch="handleClientSearch"
              showFilters={true}
              filters={[
                {
                  name: 'estado',
                  label: 'Estado',
                  type: 'select',
                  options: [
                    { value: 'Activo', label: 'Activo' },
                    { value: 'Inactivo', label: 'Inactivo' }
                  ]
                },
                {
                  name: 'ciudad',
                  label: 'Ciudad',
                  type: 'text'
                }
              ]}
            />
          </div>
          <div id="clientTableContainer" class="p-6">
            <!-- Skeleton loading para cards móviles -->
            <div class="md:hidden">
              <LoadingSkeleton type="card" count={4} />
            </div>
            <!-- Skeleton loading para tabla desktop -->
            <div class="hidden md:block">
              <LoadingSkeleton type="table" count={5} />
            </div>
          </div>
        </InteractiveCard>
    </main>

    <!-- Smart Form para clientes -->
    <SmartForm 
      id="clientForm" 
      title="Gestión de Cliente"
      submitText="Guardar Cliente"
      autoSave={true}
      autoSaveInterval={30000}
      onSubmit="handleClientSubmit"
      onCancel="handleClientCancel"
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <SmartInput
          name="nombre"
          label="Nombre/Razón Social"
          placeholder="Ingresa el nombre o razón social"
          required={true}
          maxLength={100}
          icon='<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>'
        />
        
        <SmartInput
          name="email"
          type="email"
          label="Email"
          placeholder="correo@ejemplo.com"
          autocomplete="email"
          helpText="Email para contacto y notificaciones"
        />
        
        <SmartInput
          name="telefono"
          type="tel"
          label="Teléfono"
          placeholder="099-123-456"
          helpText="Formato: 099-123-456"
          icon="phone"
        />
        
        <SmartSelect
          name="estado"
          label="Estado"
          options={[
            {value: "Activo", label: "Activo"},
            {value: "Inactivo", label: "Inactivo"}
          ]}
          value="Activo"
          helpText="Estado actual del cliente"
        />
      </div>
      
      <SmartInput
        name="direccion"
        label="Dirección"
        placeholder="Dirección completa del cliente"
        helpText="Dirección para entregas y facturación"
        maxLength={255}
        icon='<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>'
      />
    </SmartForm>

    <!-- Modal de Detalle del Cliente -->
    <ClientDetailModal />
  </div>

  <script>
    let clients = [];
    let allClients = []; // Copia original para búsquedas
    let editingClient = null;
    let clientFormManager = null;

    // Initialize the page
    document.addEventListener('DOMContentLoaded', async () => {
      const startTime = Date.now();
      const minLoadingTime = 1000; // Tiempo mínimo de loading: 1 segundo
      
      try {
        await checkAuth();
        await loadClients();
        setupEventListeners();
        
        // Initialize smart form manager
        clientFormManager = new SmartFormManager('clientForm', {
          autoSave: true,
          autoSaveInterval: 30000,
          onSubmit: 'handleClientSubmit',
          onCancel: 'handleClientCancel'
        });
        
      } catch (error) {
        console.error('Initialization error:', error);
      } finally {
        // Asegurar tiempo mínimo de loading para mejor UX
        const elapsedTime = Date.now() - startTime;
        const remainingTime = Math.max(0, minLoadingTime - elapsedTime);
        
        setTimeout(() => {
          const loading = document.getElementById('loading');
          const mainContent = document.getElementById('mainContent');
          
          if (loading) {
            loading.style.opacity = '0';
            setTimeout(() => {
              loading.classList.add('hidden');
            }, 300);
          }
          if (mainContent) {
            mainContent.classList.remove('hidden');
            mainContent.style.opacity = '0';
            setTimeout(() => {
              mainContent.style.opacity = '1';
            }, 50);
          }
        }, remainingTime);
      }
    });

    async function checkAuth() {
      try {
        const response = await fetch('/api/auth/check');
        const data = await response.json();
        
        if (!data.authenticated) {
          window.location.href = '/login';
          return;
        }
      } catch (error) {
        console.error('Auth check error:', error);
        window.location.href = '/login';
      }
    }

    async function loadClients() {
      try {
        const response = await fetch('/api/clientes');
        const result = await response.json();
        
        if (result.success) {
          clients = result.data || [];
          allClients = [...clients]; // Guardar copia original para búsquedas
          renderClientsTable();
        } else {
          // Error de conexión a la base de datos
          console.error('Database connection error:', result.message);
          clients = [];
          allClients = [];
          renderDatabaseError(result);
        }
        
      } catch (error) {
        console.error('Error loading clients:', error);
        clients = [];
        allClients = [];
        renderNetworkError();
      }
    }

    // Función de búsqueda responsiva
    function handleClientSearch(searchTerm, filters) {
      let filteredClients = [...allClients];
      
      // Aplicar búsqueda por texto
      if (searchTerm) {
        const search = searchTerm.toLowerCase();
        filteredClients = filteredClients.filter(client => 
          (client.nombre && client.nombre.toLowerCase().includes(search)) ||
          (client.email && client.email.toLowerCase().includes(search)) ||
          (client.telefono && client.telefono.toLowerCase().includes(search)) ||
          (client.direccion && client.direccion.toLowerCase().includes(search))
        );
      }
      
      // Aplicar filtros
      if (filters.estado) {
        filteredClients = filteredClients.filter(client => client.estado === filters.estado);
      }
      
      if (filters.ciudad) {
        const ciudad = filters.ciudad.toLowerCase();
        filteredClients = filteredClients.filter(client => 
          client.direccion && client.direccion.toLowerCase().includes(ciudad)
        );
      }
      
      // Actualizar la lista y renderizar
      clients = filteredClients;
      renderClientsTable();
      
      // Mostrar mensaje si no hay resultados
      if (filteredClients.length === 0 && (searchTerm || Object.keys(filters).length > 0)) {
        const container = document.getElementById('clientTableContainer');
        if (container) {
          container.innerHTML = `
            <div class="text-center py-8">
              <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.29.82-5.657 2.172M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
              </svg>
              <p class="text-lg font-medium text-gray-900">No se encontraron clientes</p>
              <p class="text-gray-500">Intenta ajustar los criterios de búsqueda</p>
              <button onclick="clearSearch()" class="mt-4 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors duration-200">
                Limpiar búsqueda
              </button>
            </div>
          `;
        }
      }
    }

    // Función para limpiar búsqueda
    function clearSearch() {
      clients = [...allClients];
      renderClientsTable();
      
      // Limpiar campo de búsqueda
      const searchInput = document.getElementById('clientSearch-input');
      if (searchInput) {
        searchInput.value = '';
        searchInput.dispatchEvent(new Event('input'));
      }
    }

    // Exponer funciones globalmente
    window.handleClientSearch = handleClientSearch;
    window.clearSearch = clearSearch;

    // Función para mostrar error de base de datos
    function renderDatabaseError(result) {
      const container = document.getElementById('clientTableContainer');
      if (!container) return;

      // Ocultar skeleton loading
      const skeletons = container.querySelectorAll('.skeleton-container');
      skeletons.forEach(skeleton => skeleton.style.display = 'none');

      container.innerHTML = `
        <div class="text-center py-12">
          <div class="bg-red-50 border border-red-200 rounded-xl p-8 max-w-md mx-auto">
            <svg class="w-16 h-16 text-red-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
            <h3 class="text-lg font-medium text-red-800 mb-2">Sin conexión a la base de datos</h3>
            <p class="text-red-600 mb-4">${result.message || 'No se puede conectar con la base de datos'}</p>
            <div class="space-y-2">
              <p class="text-sm text-red-500">• Verifica la configuración de la base de datos</p>
              <p class="text-sm text-red-500">• Asegúrate de que el servidor PostgreSQL esté ejecutándose</p>
              <p class="text-sm text-red-500">• Revisa las credenciales de conexión</p>
            </div>
            <button onclick="loadClients()" class="mt-6 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors duration-200">
              Reintentar conexión
            </button>
          </div>
        </div>
      `;
    }

    // Función para mostrar error de red
    function renderNetworkError() {
      const container = document.getElementById('clientTableContainer');
      if (!container) return;

      // Ocultar skeleton loading
      const skeletons = container.querySelectorAll('.skeleton-container');
      skeletons.forEach(skeleton => skeleton.style.display = 'none');

      container.innerHTML = `
        <div class="text-center py-12">
          <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-8 max-w-md mx-auto">
            <svg class="w-16 h-16 text-yellow-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h3 class="text-lg font-medium text-yellow-800 mb-2">Error de conexión</h3>
            <p class="text-yellow-600 mb-4">No se pudo conectar con el servidor</p>
            <div class="space-y-2">
              <p class="text-sm text-yellow-600">• Verifica tu conexión a internet</p>
              <p class="text-sm text-yellow-600">• El servidor podría estar temporalmente no disponible</p>
            </div>
            <button onclick="loadClients()" class="mt-6 px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors duration-200">
              Reintentar
            </button>
          </div>
        </div>
      `;
    }

    // Funciones auxiliares para notificaciones (placeholder hasta implementar sistema completo)
    function showSuccess(title, message) {
      console.log(`✅ ${title}: ${message}`);
      // Aquí se podría implementar un toast/notificación visual
    }

    function showError(title, message) {
      console.error(`❌ ${title}: ${message}`);
      // Aquí se podría implementar un toast/notificación visual
    }

    function renderClientsTable() {
      const container = document.getElementById('clientTableContainer');
      if (!container) return;

      // Ocultar skeleton loading
      const skeletons = container.querySelectorAll('.skeleton-container');
      skeletons.forEach(skeleton => skeleton.style.display = 'none');

      if (clients.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8">
            <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            <p class="text-lg font-medium text-gray-900">No hay clientes</p>
            <p class="text-gray-500">Comienza agregando tu primer cliente</p>
            <button onclick="document.querySelector('[data-button-id=\"newClientBtn\"]').click()" class="mt-4 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors duration-200">
              Agregar Cliente
            </button>
          </div>
        `;
        return;
      }

      // Vista Desktop (tabla tradicional)
      const desktopTableHTML = `
        <div class="overflow-x-auto shadow ring-1 ring-black ring-opacity-5 rounded-xl hidden md:block">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nombre</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Teléfono</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              ${clients.map(client => `
                <tr class="hover:bg-gray-50 transition-colors duration-200">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    ${client.nombre || client.razonsocial || 'Sin nombre'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    ${client.email || 'No especificado'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    ${client.telefono || 'No especificado'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
                      client.estado === 'Activo' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                    }">
                      ${client.estado || 'Activo'}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    ${generateActionButtons(client.id)}
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `;

      // Vista Mobile (cards)
      const mobileCardsHTML = `
        <div class="md:hidden space-y-4">
          ${clients.map(client => `
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 hover:shadow-md hover:border-gray-300 transition-all duration-200">
              <div class="flex items-center justify-between mb-3 pb-3 border-b border-gray-100">
                <div>
                  <div class="font-semibold text-gray-900 text-lg">${client.nombre || client.razonsocial || 'Sin nombre'}</div>
                  <div class="text-sm text-gray-500 mt-1">${client.email || 'No especificado'}</div>
                </div>
                <span class="inline-flex px-3 py-1 text-xs font-semibold rounded-full ${
                  client.estado === 'Activo' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                }">
                  ${client.estado || 'Activo'}
                </span>
              </div>
              
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-sm font-medium text-gray-500">Teléfono</span>
                  <span class="text-sm text-gray-900 font-medium">${client.telefono || 'No especificado'}</span>
                </div>
                ${client.direccion ? `
                  <div class="flex items-start justify-between">
                    <span class="text-sm font-medium text-gray-500">Dirección</span>
                    <span class="text-sm text-gray-900 font-medium text-right ml-2">${client.direccion}</span>
                  </div>
                ` : ''}
              </div>
              
              <div class="flex items-center justify-end space-x-2 mt-4 pt-3 border-t border-gray-100">
                ${generateActionButtons(client.id)}
              </div>
            </div>
          `).join('')}
        </div>
      `;

      container.innerHTML = desktopTableHTML + mobileCardsHTML;
    }

    function generateActionButtons(clientId) {
      return `
        <div class="flex justify-center space-x-2">
          <button onclick="viewClient(${clientId})" class="p-2 rounded-lg transition-all duration-200 text-green-600 hover:text-green-700 hover:bg-green-50" title="Ver detalle">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M12 1v6m0 6v6m6-6h-6m6 0h6"></path>
            </svg>
          </button>
          <button onclick="editClient(${clientId})" class="p-2 rounded-lg transition-all duration-200 text-blue-600 hover:text-blue-700 hover:bg-blue-50" title="Editar">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
          </button>
          <button onclick="deleteClient(${clientId})" class="p-2 rounded-lg transition-all duration-200 text-red-600 hover:text-red-700 hover:bg-red-50" title="Eliminar">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <polyline points="3,6 5,6 21,6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
          </button>
        </div>
      `;
    }

    function setupEventListeners() {
      // Botón nuevo cliente - Buscar por data-button-id
      const newClientBtn = document.querySelector('[data-button-id="newClientBtn"]');
      newClientBtn?.addEventListener('click', () => {
        editingClient = null;
        const titleEl = document.getElementById('clientForm-title');
        if (titleEl) titleEl.textContent = 'Nuevo Cliente';
        clientFormManager?.open({});
      });
    }

    // Handler functions for SmartForm
    window.handleClientSubmit = async function(data) {
      try {
        const url = editingClient ? `/api/clientes/${editingClient.id}` : '/api/clientes';
        const method = editingClient ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          clientFormManager?.close();
          await loadClients();
          
          // Mostrar notificación de éxito
          if (editingClient) {
            showSuccess('Cliente actualizado', 'Los datos del cliente se han actualizado correctamente');
          } else {
            showSuccess('Cliente creado', 'El nuevo cliente se ha agregado exitosamente');
          }
        } else {
          showError('Error', 'No se pudo guardar el cliente. Inténtalo de nuevo.');
        }
      } catch (error) {
        console.error('Error:', error);
        showError('Error de conexión', 'No se pudo conectar con el servidor');
      }
    };
    
    window.handleClientCancel = function() {
      editingClient = null;
    };

    // Global functions
    window.viewClient = function(clientId) {
      const client = clients.find(c => c.id === clientId);
      if (client) {
        showClientDetail(client);
      }
    };

    window.editClientFromDetail = function() {
      if (window.currentDetailClient) {
        hideClientDetail();
        editingClient = window.currentDetailClient;
        const titleEl = document.getElementById('clientForm-title');
        if (titleEl) titleEl.textContent = 'Editar Cliente';
        clientFormManager?.open(window.currentDetailClient);
      }
    };

    window.editClient = function(clientId) {
      const client = clients.find(c => c.id === clientId);
      if (client) {
        editingClient = client;
        const titleEl = document.getElementById('clientForm-title');
        if (titleEl) titleEl.textContent = 'Editar Cliente';
        clientFormManager?.open(client);
      }
    };

    window.deleteClient = async function(clientId) {
      if (confirm('¿Estás seguro de que quieres eliminar este cliente?')) {
        try {
          const response = await fetch(`/api/clientes/${clientId}`, {
            method: 'DELETE'
          });

          if (response.ok) {
            await loadClients();
            showSuccess('Cliente eliminado', 'El cliente se ha eliminado correctamente');
          } else {
            showError('Error', 'No se pudo eliminar el cliente');
          }
        } catch (error) {
          console.error('Error:', error);
          showError('Error de conexión', 'No se pudo conectar con el servidor');
        }
      }
    };
  </script>

  <style>
    /* Transiciones suaves para el loading */
    #mainContent {
      transition: opacity 0.3s ease-in-out;
    }
    
    #loading {
      transition: opacity 0.3s ease-in-out;
    }

    /* Hover effects para botones de acción */
    .interactive-button {
      transition: all 0.2s ease;
    }

    .interactive-button:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    /* Estilos responsivos para móviles */
    @media (max-width: 480px) {
