---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import LoadingSpinner from '../components/LoadingSpinner.astro';
import SmartForm from '../components/forms/SmartForm.astro';
import SmartInput from '../components/forms/SmartInput.astro';
import SmartSelect from '../components/forms/SmartSelect.astro';
import InteractiveButton from '../components/interactions/InteractiveButton.astro';
import InteractiveCard from '../components/interactions/InteractiveCard.astro';
---

<Layout title="Clientes - Sistema de Gestión">
  <Navigation currentPage="clientes" />
  
  <LoadingSpinner message="Cargando clientes..." />

  <main id="mainContent" class="max-w-7xl mx-auto px-6 lg:px-8 py-8 hidden">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Gestión de Clientes</h1>
      <p class="text-gray-600">Administra tu base de clientes</p>
    </div>

        <!-- Gestión de Clientes Card -->
        <InteractiveCard 
          class="mb-8" 
          hover="lift"
          data-stagger="0.1"
        >
          <div class="px-6 py-4 border-b border-gray-200">
            <div class="flex items-center justify-between">
              <h2 class="text-lg font-medium text-gray-900">Clientes</h2>
              <InteractiveButton 
                variant="primary"
                size="md"
                class="interactive-button"
                data-button-id="newClientBtn"
              >
                <svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                Nuevo Cliente
              </InteractiveButton>
            </div>
          </div>
          <div id="clientTableContainer" class="p-6">
            <div class="text-center py-8">
              <p class="text-gray-500">Cargando clientes...</p>
            </div>
          </div>
        </InteractiveCard>
    </main>

    <!-- Smart Form para clientes -->
    <SmartForm 
      id="clientForm" 
      title="Gestión de Cliente"
      submitText="Guardar Cliente"
      autoSave={true}
      autoSaveInterval={30000}
      onSubmit="handleClientSubmit"
      onCancel="handleClientCancel"
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <SmartInput
          name="nombre"
          label="Nombre/Razón Social"
          placeholder="Ingresa el nombre o razón social"
          required={true}
          maxLength={100}
          icon='<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>'
        />
        
        <SmartInput
          name="email"
          type="email"
          label="Email"
          placeholder="correo@ejemplo.com"
          autocomplete="email"
          helpText="Email para contacto y notificaciones"
        />
        
        <SmartInput
          name="telefono"
          type="tel"
          label="Teléfono"
          placeholder="099-123-456"
          helpText="Formato: 099-123-456"
          icon="phone"
        />
        
        <SmartSelect
          name="estado"
          label="Estado"
          options={[
            {value: "Activo", label: "Activo"},
            {value: "Inactivo", label: "Inactivo"}
          ]}
          value="Activo"
          helpText="Estado actual del cliente"
        />
      </div>
      
      <SmartInput
        name="direccion"
        label="Dirección"
        placeholder="Dirección completa del cliente"
        helpText="Dirección para entregas y facturación"
        maxLength={255}
        icon='<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>'
      />
    </SmartForm>
  </div>

  <script>
    let clients = [];
    let editingClient = null;
    let clientFormManager = null;

    // Initialize the page
    document.addEventListener('DOMContentLoaded', async () => {
      const startTime = Date.now();
      const minLoadingTime = 1000; // Tiempo mínimo de loading: 1 segundo
      
      try {
        await checkAuth();
        await loadClients();
        setupEventListeners();
        
        // Initialize smart form manager
        clientFormManager = new SmartFormManager('clientForm', {
          autoSave: true,
          autoSaveInterval: 30000,
          onSubmit: 'handleClientSubmit',
          onCancel: 'handleClientCancel'
        });
        
      } catch (error) {
        console.error('Initialization error:', error);
      } finally {
        // Asegurar tiempo mínimo de loading para mejor UX
        const elapsedTime = Date.now() - startTime;
        const remainingTime = Math.max(0, minLoadingTime - elapsedTime);
        
        setTimeout(() => {
          const loading = document.getElementById('loading');
          const mainContent = document.getElementById('mainContent');
          
          if (loading) {
            loading.style.opacity = '0';
            setTimeout(() => {
              loading.classList.add('hidden');
            }, 300);
          }
          if (mainContent) {
            mainContent.classList.remove('hidden');
            mainContent.style.opacity = '0';
            setTimeout(() => {
              mainContent.style.opacity = '1';
            }, 50);
          }
        }, remainingTime);
      }
    });

    async function checkAuth() {
      try {
        const response = await fetch('/api/auth/check');
        const data = await response.json();
        
        if (!data.authenticated) {
          window.location.href = '/login';
          return;
        }
      } catch (error) {
        console.error('Auth check error:', error);
        window.location.href = '/login';
      }
    }

    async function loadClients() {
      try {
        const response = await fetch('/api/clientes');
        const result = await response.json();
        
        if (result.success) {
          clients = result.data || [];
          renderClientsTable();
        } else {
          console.error('Error loading clients:', result.message);
        }
        
      } catch (error) {
        console.error('Error loading clients:', error);
        clients = [];
        renderClientsTable();
      }
    }

    function renderClientsTable() {
      const container = document.getElementById('clientTableContainer');
      if (!container) return;

      if (clients.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8">
            <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            <p class="text-lg font-medium text-gray-900">No hay clientes</p>
            <p class="text-gray-500">Comienza agregando tu primer cliente</p>
          </div>
        `;
        return;
      }

      const tableHTML = `
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nombre</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Teléfono</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              ${clients.map(client => `
                <tr class="interactive-row hover:bg-gray-50 transition-colors duration-200">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    ${client.nombre || client.razonsocial || 'Sin nombre'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    ${client.email || '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    ${client.telefono || '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full transition-all duration-200 ${
                      client.estado === 'Activo' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                    }">
                      ${client.estado || 'Activo'}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <div class="flex justify-center space-x-2">
                      <button onclick="editClient(${client.id})" class="interactive-button text-blue-600 hover:text-blue-900 p-2 rounded transition-all duration-200 hover:bg-blue-50">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                      </button>
                      <button onclick="deleteClient(${client.id})" class="interactive-button text-red-600 hover:text-red-900 p-2 rounded transition-all duration-200 hover:bg-red-50">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `;

      container.innerHTML = tableHTML;
    }

    function setupEventListeners() {
      // Botón nuevo cliente - Buscar por data-button-id
      const newClientBtn = document.querySelector('[data-button-id="newClientBtn"]');
      newClientBtn?.addEventListener('click', () => {
        editingClient = null;
        const titleEl = document.getElementById('clientForm-title');
        if (titleEl) titleEl.textContent = 'Nuevo Cliente';
        clientFormManager?.open({});
      });
    }

    // Handler functions for SmartForm
    window.handleClientSubmit = async function(data) {
      try {
        const url = editingClient ? `/api/clientes/${editingClient.id}` : '/api/clientes';
        const method = editingClient ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          clientFormManager?.close();
          await loadClients();
          
          // Mostrar notificación de éxito
          if (editingClient) {
            showSuccess('Cliente actualizado', 'Los datos del cliente se han actualizado correctamente');
          } else {
            showSuccess('Cliente creado', 'El nuevo cliente se ha agregado exitosamente');
          }
        } else {
          showError('Error', 'No se pudo guardar el cliente. Inténtalo de nuevo.');
        }
      } catch (error) {
        console.error('Error:', error);
        showError('Error de conexión', 'No se pudo conectar con el servidor');
      }
    };
    
    window.handleClientCancel = function() {
      editingClient = null;
    };

    // Global functions
    window.editClient = function(clientId) {
      const client = clients.find(c => c.id === clientId);
      if (client) {
        editingClient = client;
        const titleEl = document.getElementById('clientForm-title');
        if (titleEl) titleEl.textContent = 'Editar Cliente';
        clientFormManager?.open(client);
      }
    };

    window.deleteClient = async function(clientId) {
      if (confirm('¿Estás seguro de que quieres eliminar este cliente?')) {
        try {
          const response = await fetch(`/api/clientes/${clientId}`, {
            method: 'DELETE'
          });

          if (response.ok) {
            await loadClients();
            showSuccess('Cliente eliminado', 'El cliente se ha eliminado correctamente');
          } else {
            showError('Error', 'No se pudo eliminar el cliente');
          }
        } catch (error) {
          console.error('Error:', error);
          showError('Error de conexión', 'No se pudo conectar con el servidor');
        }
      }
    };
  </script>

  <style>
    /* Transiciones suaves para el loading */
    #mainContent {
      transition: opacity 0.3s ease-in-out;
    }
    
    #loading {
      transition: opacity 0.3s ease-in-out;
    }
  </style>
</Layout>