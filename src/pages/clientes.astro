---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import MotionSimple from '../components/MotionSimple.astro';
---

<Layout title="Gestión de Clientes - Sistema de Repartos">
  <MotionSimple />
  <div id="app" class="min-h-screen bg-gray-50">
    <!-- Loading state -->
    <div id="loading" class="flex items-center justify-center min-h-screen">
      <div class="flex flex-col items-center space-y-4">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
        <p class="text-gray-600 font-medium">Cargando clientes...</p>
      </div>
    </div>

    <!-- Main content -->
    <div id="mainContent" class="hidden">
      <Navigation currentPage="clientes" />

      <!-- Content -->
      <main class="max-w-7xl mx-auto px-6 lg:px-8 py-8">
        <!-- Header de página con animación -->
        <div class="flex justify-between items-center mb-8" data-motion="fade-up" data-delay="0">
          <div data-motion="fade-right" data-delay="100">
            <h2 class="text-3xl font-bold text-gray-900" style="font-family: Inter;">Gestión de Clientes</h2>
            <p class="text-gray-600 mt-2">Administra tu cartera de clientes y sus ubicaciones</p>
          </div>
          <button 
            id="addClientBtn"
            class="btn-primary motion-hover-scale"
            data-motion="fade-left" data-delay="200"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Nuevo Cliente
          </button>
        </div>

        <!-- Filtros y búsqueda con animación -->
        <div class="card mb-8" data-motion="fade-up" data-delay="300">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex-1 max-w-md" data-motion="fade-right" data-delay="400">
              <label for="searchClients" class="sr-only">Buscar clientes</label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
                <input 
                  type="text" 
                  id="searchClients" 
                  class="input-field pl-10" 
                  placeholder="Buscar por nombre, email o teléfono..."
                />
              </div>
            </div>
            <div class="flex items-center space-x-3" data-motion="fade-left" data-delay="500">
              <select id="filterEstado" class="input-field">
                <option value="">Todos los estados</option>
                <option value="activo">Activo</option>
                <option value="inactivo">Inactivo</option>
              </select>
              <button id="refreshBtn" class="btn-outline motion-hover-scale">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
                Actualizar
              </button>
            </div>
          </div>
        </div>

        <!-- Lista de clientes con animación -->
        <div class="card motion-hover-lift" data-motion="fade-up" data-delay="600">
          <div class="overflow-hidden">
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                      Cliente
                    </th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                      Contacto
                    </th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                      Ubicación
                    </th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                      Estado
                    </th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                      Acciones
                    </th>
                  </tr>
                </thead>
                <tbody id="clientsTableBody" class="bg-white divide-y divide-gray-200">
                  <!-- Clientes will be loaded here -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
              <input 
                type="text" 
                id="searchInput"
                placeholder="Buscar clientes por nombre, razón social o dirección..."
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              />
            </div>
            <div>
              <select id="statusFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">Todos los estados</option>
                <option value="Activo">Activos</option>
                <option value="Inactivo">Inactivos</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Clients Table -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900">Lista de Clientes</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contacto</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ubicación</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
              </thead>
              <tbody id="clientsTableBody" class="bg-white divide-y divide-gray-200">
                <!-- Clients will be loaded here -->
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>

    <!-- Add/Edit Client Modal -->
    <div id="clientModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center p-4">
      <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-screen overflow-y-auto">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 id="modalTitle" class="text-lg font-medium text-gray-900">Nuevo Cliente</h3>
        </div>
        <form id="clientForm" class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Código Alternativo</label>
              <input type="text" name="codigoalte" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">RUT</label>
              <input type="text" name="rut" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Razón Social *</label>
            <input type="text" name="razonsocial" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nombre *</label>
            <input type="text" name="nombre" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Dirección *</label>
            <textarea name="direccion" required rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></textarea>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Teléfono</label>
            <input type="text" name="telefono" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Latitud</label>
              <input type="number" step="any" name="latitud" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Longitud</label>
              <input type="number" step="any" name="longitud" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            </div>
          </div>
          
          <div id="editOnlyFields" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-1">Estado</label>
            <select name="estado" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
              <option value="Activo">Activo</option>
              <option value="Inactivo">Inactivo</option>
            </select>
          </div>
        </form>
        
        <div class="px-6 py-4 border-t border-gray-200 flex justify-end space-x-3">
          <button id="cancelBtn" type="button" class="px-4 py-2 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-lg transition-colors">
            Cancelar
          </button>
          <button id="saveBtn" type="submit" form="clientForm" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
            Guardar
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let clients = [];
    let editingClient = null;

    document.addEventListener('DOMContentLoaded', async () => {
      await checkAuth();
      await loadClients();
      setupEventListeners();
    });

    async function checkAuth() {
      try {
        const response = await fetch('/api/auth/check');
        const data = await response.json();
        
        if (!data.authenticated) {
          window.location.href = '/login';
          return;
        }
        
        document.getElementById('userName').textContent = data.user.nombre_completo;
      } catch (error) {
        console.error('Auth check error:', error);
        window.location.href = '/login';
      }
    }

    async function loadClients() {
      try {
        const response = await fetch('/api/clientes');
        const data = await response.json();
        
        if (data.success) {
          clients = data.data;
          renderClients(clients);
        }
        
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('mainContent').classList.remove('hidden');
        
      } catch (error) {
        console.error('Error loading clients:', error);
      }
    }

    function renderClients(clientsToRender) {
      const tbody = document.getElementById('clientsTableBody');
      
      if (clientsToRender.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-gray-500">No se encontraron clientes</td>
          </tr>
        `;
        return;
      }
      
      tbody.innerHTML = clientsToRender.map(client => `
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4">
            <div>
              <div class="text-sm font-medium text-gray-900">${client.razonsocial}</div>
              <div class="text-sm text-gray-500">${client.nombre}</div>
              <div class="text-xs text-gray-400">${client.codigoalte || 'Sin código'}</div>
            </div>
          </td>
          <td class="px-6 py-4">
            <div class="text-sm text-gray-900">${client.telefono || 'Sin teléfono'}</div>
            <div class="text-sm text-gray-500">${client.rut || 'Sin RUT'}</div>
          </td>
          <td class="px-6 py-4">
            <div class="text-sm text-gray-900">${client.direccion}</div>
            ${client.latitud && client.longitud ? 
              `<div class="text-xs text-gray-500">📍 ${client.latitud}, ${client.longitud}</div>` : 
              '<div class="text-xs text-gray-400">Sin coordenadas</div>'
            }
          </td>
          <td class="px-6 py-4">
            <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
              client.estado === 'Activo' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
            }">
              ${client.estado}
            </span>
          </td>
          <td class="px-6 py-4">
            <div class="flex space-x-2">
              <button onclick="editClient(${client.id})" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                Editar
              </button>
              <button onclick="toggleClientStatus(${client.id})" class="text-red-600 hover:text-red-800 text-sm font-medium">
                ${client.estado === 'Activo' ? 'Desactivar' : 'Activar'}
              </button>
            </div>
          </td>
        </tr>
      `).join('');
    }

    function setupEventListeners() {
      // Search functionality
      document.getElementById('searchInput').addEventListener('input', filterClients);
      document.getElementById('statusFilter').addEventListener('change', filterClients);
      
      // Modal controls
      document.getElementById('addClientBtn').addEventListener('click', () => openModal());
      document.getElementById('cancelBtn').addEventListener('click', closeModal);
      document.getElementById('clientForm').addEventListener('submit', saveClient);
      
      // Logout
      document.getElementById('logoutBtn').addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/login';
      });
    }

    function filterClients() {
      const search = document.getElementById('searchInput').value.toLowerCase();
      const status = document.getElementById('statusFilter').value;
      
      let filtered = clients.filter(client => {
        const matchesSearch = !search || 
          client.razonsocial.toLowerCase().includes(search) ||
          client.nombre.toLowerCase().includes(search) ||
          client.direccion.toLowerCase().includes(search);
          
        const matchesStatus = !status || client.estado === status;
        
        return matchesSearch && matchesStatus;
      });
      
      renderClients(filtered);
    }

    function openModal(client = null) {
      editingClient = client;
      const modal = document.getElementById('clientModal');
      const title = document.getElementById('modalTitle');
      const form = document.getElementById('clientForm');
      const editFields = document.getElementById('editOnlyFields');
      
      if (client) {
        title.textContent = 'Editar Cliente';
        editFields.classList.remove('hidden');
        
        // Fill form with client data
        Object.keys(client).forEach(key => {
          const input = form.querySelector(`[name="${key}"]`);
          if (input) {
            input.value = client[key] || '';
          }
        });
      } else {
        title.textContent = 'Nuevo Cliente';
        editFields.classList.add('hidden');
        form.reset();
      }
      
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      const modal = document.getElementById('clientModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      editingClient = null;
    }

    async function saveClient(e) {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const clientData = Object.fromEntries(formData.entries());
      
      // Convert coordinates to numbers if provided
      if (clientData.latitud) clientData.latitud = parseFloat(clientData.latitud);
      if (clientData.longitud) clientData.longitud = parseFloat(clientData.longitud);
      
      try {
        const url = editingClient ? `/api/clientes/${editingClient.id}` : '/api/clientes';
        const method = editingClient ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(clientData)
        });
        
        const data = await response.json();
        
        if (data.success) {
          closeModal();
          await loadClients(); // Reload clients
        } else {
          alert('Error al guardar cliente: ' + data.error);
        }
      } catch (error) {
        console.error('Error saving client:', error);
        alert('Error de conexión');
      }
    }

    window.editClient = function(clientId) {
      const client = clients.find(c => c.id === clientId);
      if (client) {
        openModal(client);
      }
    }

    window.toggleClientStatus = async function(clientId) {
      const client = clients.find(c => c.id === clientId);
      if (!client) return;
      
      const newStatus = client.estado === 'Activo' ? 'Inactivo' : 'Activo';
      
      if (confirm(`¿Estás seguro de ${newStatus === 'Activo' ? 'activar' : 'desactivar'} este cliente?`)) {
        try {
          const response = await fetch(`/api/clientes/${clientId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...client, estado: newStatus })
          });
          
          const data = await response.json();
          
          if (data.success) {
            await loadClients(); // Reload clients
          } else {
            alert('Error al actualizar cliente: ' + data.error);
          }
        } catch (error) {
          console.error('Error updating client:', error);
          alert('Error de conexión');
        }
      }
    }
  </script>
</Layout>