---
// src/components/forms/SmartInput.astro - JavaScript puro
const {
  type = "text",
  name,
  label,
  placeholder,
  required = false,
  value = "",
  autocomplete,
  helpText,
  validator,
  minLength,
  maxLength,
  min,
  max,
  step,
  pattern,
  className = "",
  icon,
  suggestions = []
} = Astro.props;

const inputId = `input-${name}`;
const hasIcon = icon && icon.length > 0;

// Icon definitions
const iconPaths = {
  user: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
  email: 'M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  phone: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
  'location-marker': 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z',
  calendar: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  lock: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  truck: 'M9 17a2 2 0 11-4 0 2 2 0 014 0zM21 17a2 2 0 11-4 0 2 2 0 014 0zM13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l2.414 2.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0',
  tag: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z',
  cog: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  scale: 'M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2m1 0v1a1 1 0 01-1 1H6a1 1 0 01-1-1V4m1 0h12M9 8v8m6-8v8M5 12h14',
  'document-text': 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  'user-circle': 'M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z'
};

const iconPath = iconPaths[icon] || icon;
---

<div class={`smart-input-group ${className}`}>
  <!-- Label -->
  <label for={inputId} class="block text-sm font-medium text-gray-700 mb-1">
    {label}
    {required && <span class="text-red-500 ml-1">*</span>}
  </label>
  
  <!-- Input container -->
  <div class="relative">
    <!-- Icon -->
    {hasIcon && (
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPath}></path>
        </svg>
      </div>
    )}
    
    <!-- Input field -->
    <input
      type={type}
      id={inputId}
      name={name}
      placeholder={placeholder}
      value={value}
      required={required}
      autocomplete={autocomplete}
      minlength={minLength}
      maxlength={maxLength}
      min={min}
      max={max}
      step={step}
      pattern={pattern}
      data-validator={validator}
      list={suggestions.length > 0 ? `${inputId}-suggestions` : undefined}
      class={`
        w-full px-3 py-2 border border-gray-300 rounded-lg 
        focus:ring-2 focus:ring-blue-500 focus:border-blue-500
        transition-colors duration-200
        ${hasIcon ? 'pl-10' : ''}
        placeholder-gray-400
      `}
    />
    
    <!-- Suggestions datalist -->
    {suggestions.length > 0 && (
      <datalist id={`${inputId}-suggestions`}>
        {suggestions.map(suggestion => (
          <option value={suggestion} />
        ))}
      </datalist>
    )}
    
    <!-- Character counter -->
    {maxLength && (
      <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
        <span id={`${inputId}-counter`} class="text-xs text-gray-400">
          0/{maxLength}
        </span>
      </div>
    )}
  </div>
  
  <!-- Help text -->
  {helpText && (
    <p class="mt-1 text-sm text-gray-500">
      {helpText}
    </p>
  )}
  
  <!-- Error message placeholder -->
  <div id={`${inputId}-error`} class="mt-1 text-sm text-red-600 hidden"></div>
</div>

<script define:vars={{ inputId, maxLength, suggestions }}>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById(inputId);
    if (!input) return;
    
    // Character counter
    if (maxLength) {
      const counter = document.getElementById(`${inputId}-counter`);
      
      const updateCounter = () => {
        const count = input.value.length;
        counter.textContent = `${count}/${maxLength}`;
        
        if (count > maxLength * 0.9) {
          counter.classList.add('text-yellow-500');
          counter.classList.remove('text-gray-400');
        } else if (count >= maxLength) {
          counter.classList.add('text-red-500');
          counter.classList.remove('text-yellow-500', 'text-gray-400');
        } else {
          counter.classList.add('text-gray-400');
          counter.classList.remove('text-yellow-500', 'text-red-500');
        }
      };
      
      input.addEventListener('input', updateCounter);
      updateCounter(); // Initial count
    }
    
    // Enhanced autocomplete for suggestions
    if (suggestions.length > 0) {
      let currentFocus = -1;
      
      input.addEventListener('input', function() {
        const value = this.value;
        if (!value) return;
        
        // Filter suggestions
        const filtered = suggestions.filter(s => 
          s.toLowerCase().includes(value.toLowerCase())
        );
        
        if (filtered.length > 0) {
          showSuggestions(filtered);
        }
      });
      
      function showSuggestions(filtered) {
        // Remove existing suggestions
        const existingList = document.getElementById(`${inputId}-suggestions-list`);
        if (existingList) {
          existingList.remove();
        }
        
        // Create new suggestions dropdown
        const list = document.createElement('div');
        list.id = `${inputId}-suggestions-list`;
        list.className = 'absolute z-10 w-full bg-white border border-gray-300 rounded-md shadow-lg max-h-48 overflow-y-auto mt-1';
        
        filtered.forEach((suggestion, index) => {
          const item = document.createElement('div');
          item.className = 'px-3 py-2 hover:bg-gray-100 cursor-pointer text-sm';
          item.textContent = suggestion;
          
          item.addEventListener('click', () => {
            input.value = suggestion;
            input.dispatchEvent(new Event('input'));
            list.remove();
          });
          
          list.appendChild(item);
        });
        
        input.parentNode.appendChild(list);
        
        // Close suggestions when clicking outside
        document.addEventListener('click', function closeHandler(e) {
          if (!input.contains(e.target) && !list.contains(e.target)) {
            list.remove();
            document.removeEventListener('click', closeHandler);
          }
        });
      }
    }
    
    // Auto-format specific input types
    if (input.type === 'tel') {
      input.addEventListener('input', function() {
        // Format phone number as user types
        let value = this.value.replace(/\D/g, '');
        if (value.length >= 6) {
          value = value.replace(/(\d{3})(\d{3})(\d+)/, '$1-$2-$3');
        } else if (value.length >= 3) {
          value = value.replace(/(\d{3})(\d+)/, '$1-$2');
        }
        this.value = value;
        
        // Validate phone number
        validatePhone(this);
      });
      
      input.addEventListener('blur', function() {
        validatePhone(this);
      });
    }
    
    // Phone validation function
    function validatePhone(phoneInput) {
      const errorDiv = document.getElementById(`${phoneInput.id}-error`);
      const value = phoneInput.value.replace(/\D/g, '');
      
      if (phoneInput.value && value.length < 8) {
        showFieldError(phoneInput, 'El teléfono debe tener al menos 8 dígitos');
        return false;
      } else if (phoneInput.value && value.length > 10) {
        showFieldError(phoneInput, 'El teléfono no puede tener más de 10 dígitos');
        return false;
      } else {
        hideFieldError(phoneInput);
        return true;
      }
    }
    
    // Show field error
    function showFieldError(field, message) {
      const errorDiv = document.getElementById(`${field.id}-error`);
      if (errorDiv) {
        errorDiv.textContent = message;
        errorDiv.classList.remove('hidden');
      }
      field.classList.add('border-red-500', 'focus:border-red-500', 'focus:ring-red-200');
    }
    
    // Hide field error
    function hideFieldError(field) {
      const errorDiv = document.getElementById(`${field.id}-error`);
      if (errorDiv) {
        errorDiv.classList.add('hidden');
      }
      field.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-200');
    }
    
    // Auto-format currency inputs
    if (input.hasAttribute('data-currency')) {
      input.addEventListener('input', function() {
        let value = this.value.replace(/[^\d]/g, '');
        if (value) {
          value = parseInt(value).toLocaleString();
          this.value = value;
        }
      });
    }
    
    // Enhanced date inputs
    if (input.type === 'date') {
      // Set max date to today if data-max-today attribute exists
      if (input.hasAttribute('data-max-today')) {
        const today = new Date().toISOString().split('T')[0];
        input.setAttribute('max', today);
      }
      
      // Set min date to today if data-min-today attribute exists
      if (input.hasAttribute('data-min-today')) {
        const today = new Date().toISOString().split('T')[0];
        input.setAttribute('min', today);
      }
    }
  });
</script>

<style>
  .smart-input-group {
    position: relative;
  }
  
  /* Enhanced focus animations */
  .smart-input-group input:focus {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(74, 144, 226, 0.15);
  }
  
  /* Floating label effect for inputs with icons */
  .smart-input-group input:focus + .floating-label,
  .smart-input-group input:not(:placeholder-shown) + .floating-label {
    transform: translateY(-1.5rem) scale(0.75);
    color: #4A90E2;
  }
  
  /* Suggestions dropdown animation */
  #suggestions-list {
    animation: slideDown 0.2s ease-out;
  }
  
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>