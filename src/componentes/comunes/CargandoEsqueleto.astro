---
export interface Props {
  count?: number;
  type?: 'card' | 'table' | 'timeline' | 'widget';
  className?: string;
}

const {
  count = 3,
  type = 'card',
  className = ''
} = Astro.props;

// Configuraciones por tipo de skeleton
const skeletonConfig = {
  card: {
    containerClass: 'space-y-4',
    itemClass: 'bg-white rounded-xl shadow-sm border p-4 animate-pulse'
  },
  table: {
    containerClass: 'space-y-3',
    itemClass: 'bg-white rounded-lg shadow-sm p-4 animate-pulse'
  },
  timeline: {
    containerClass: 'space-y-6',
    itemClass: 'flex items-start space-x-4 animate-pulse'
  },
  widget: {
    containerClass: 'grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6',
    itemClass: 'bg-white rounded-xl shadow-sm border p-4 sm:p-6 animate-pulse'
  }
};

const config = skeletonConfig[type];
---

<div class={`skeleton-container ${config.containerClass} ${className}`} id="skeleton-loading">
  {Array.from({ length: count }, (_, i) => (
    <div key={i} class={config.itemClass}>
      {type === 'card' && (
        <>
          <!-- Header del card -->
          <div class="flex justify-between items-start mb-3 pb-3 border-b border-gray-100">
            <div class="flex-1">
              <div class="h-5 bg-gray-200 rounded-md mb-2 w-3/4"></div>
              <div class="h-4 bg-gray-200 rounded-md w-1/2"></div>
            </div>
            <div class="ml-3">
              <div class="h-6 w-16 bg-gray-200 rounded-full"></div>
            </div>
          </div>
          
          <!-- Contenido del card -->
          <div class="space-y-3 mb-4">
            <div class="flex justify-between items-center">
              <div class="h-4 bg-gray-200 rounded-md w-1/4"></div>
              <div class="h-4 bg-gray-200 rounded-md w-1/3"></div>
            </div>
            <div class="flex justify-between items-center">
              <div class="h-4 bg-gray-200 rounded-md w-1/3"></div>
              <div class="h-4 bg-gray-200 rounded-md w-1/4"></div>
            </div>
          </div>
          
          <!-- Botones de acción -->
          <div class="flex justify-end space-x-2 pt-3 border-t border-gray-100">
            <div class="h-9 w-20 bg-gray-200 rounded-lg"></div>
            <div class="h-9 w-20 bg-gray-200 rounded-lg"></div>
          </div>
        </>
      )}
      
      {type === 'table' && (
        <div class="flex items-center space-x-4">
          <div class="h-12 w-12 bg-gray-200 rounded-lg"></div>
          <div class="flex-1 space-y-2">
            <div class="h-4 bg-gray-200 rounded-md w-3/4"></div>
            <div class="h-3 bg-gray-200 rounded-md w-1/2"></div>
          </div>
          <div class="flex space-x-2">
            <div class="h-8 w-8 bg-gray-200 rounded-md"></div>
            <div class="h-8 w-8 bg-gray-200 rounded-md"></div>
          </div>
        </div>
      )}
      
      {type === 'timeline' && (
        <>
          <!-- Icono del timeline -->
          <div class="relative z-10 flex-shrink-0">
            <div class="w-12 h-12 bg-gray-200 rounded-full border-2 border-gray-100"></div>
          </div>
          
          <!-- Contenido del timeline -->
          <div class="flex-1 min-w-0 bg-white rounded-xl border border-gray-200 shadow-sm p-4">
            <!-- Header -->
            <div class="flex justify-between items-start mb-3">
              <div class="flex-1">
                <div class="h-5 bg-gray-200 rounded-md mb-2 w-2/3"></div>
                <div class="h-4 bg-gray-200 rounded-md w-4/5"></div>
              </div>
              <div class="ml-3">
                <div class="h-6 w-20 bg-gray-200 rounded-full"></div>
              </div>
            </div>
            
            <!-- Detalles -->
            <div class="grid grid-cols-2 gap-3 mb-4 text-sm">
              <div class="h-4 bg-gray-200 rounded-md w-full"></div>
              <div class="h-4 bg-gray-200 rounded-md w-3/4"></div>
            </div>
            
            <!-- Botones -->
            <div class="flex justify-end space-x-2 pt-3 border-t border-gray-100">
              <div class="h-9 w-16 bg-gray-200 rounded-lg"></div>
              <div class="h-9 w-20 bg-gray-200 rounded-lg"></div>
            </div>
          </div>
        </>
      )}
      
      {type === 'widget' && (
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div class="space-y-2">
              <div class="h-4 bg-gray-200 rounded-md w-20"></div>
              <div class="h-8 bg-gray-200 rounded-md w-16"></div>
            </div>
            <div class="w-12 h-12 bg-gray-200 rounded-xl"></div>
          </div>
          <div class="h-3 bg-gray-200 rounded-md w-3/4"></div>
        </div>
      )}
    </div>
  ))}
</div>

<style>
  .skeleton-container {
    animation: fadeIn 0.3s ease-in-out;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Animación de pulsación más suave */
  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }
  
  /* Efecto shimmer para mejor apariencia */
  .animate-pulse > * {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
  }
  
  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }
  
  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    .animate-pulse > * {
      background: linear-gradient(90deg, #374151 25%, #4b5563 50%, #374151 75%);
      background-size: 200% 100%;
    }
  }
</style>

<script>
  // Función global para mostrar/ocultar skeleton
  window.showSkeleton = function(containerId, type = 'card', count = 3) {
    const container = document.getElementById(containerId);
    if (!container) return;
    
    const skeleton = document.getElementById('skeleton-loading');
    if (skeleton) {
      skeleton.style.display = 'block';
    }
    
    // Ocultar contenido real
    const realContent = container.querySelector(':not(#skeleton-loading)');
    if (realContent) {
      realContent.style.display = 'none';
    }
  };
  
  window.hideSkeleton = function(containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;
    
    const skeleton = document.getElementById('skeleton-loading');
    if (skeleton) {
      skeleton.style.display = 'none';
    }
    
    // Mostrar contenido real con animación
    const realContent = container.querySelector(':not(#skeleton-loading)');
    if (realContent) {
      realContent.style.display = 'block';
      realContent.style.animation = 'fadeIn 0.5s ease-in-out';
    }
  };
</script>