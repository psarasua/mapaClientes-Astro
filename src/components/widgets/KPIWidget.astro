---
interface Props {
  title: string;
  value: number;
  targetValue?: number;
  change?: number;
  icon: string;
  color?: 'blue' | 'green' | 'yellow' | 'red' | 'purple' | 'indigo';
  trend?: 'up' | 'down' | 'neutral';
  trendValue?: number;
  subtitle?: string;
  showProgress?: boolean;
  isLoading?: boolean;
}

const { 
  title, 
  value, 
  targetValue,
  change = 0, 
  icon, 
  color = 'blue', 
  trend = 'neutral',
  trendValue,
  subtitle,
  showProgress = false,
  isLoading = false 
} = Astro.props;

// Color configurations
const colorConfig = {
  blue: {
    bg: 'bg-blue-50',
    iconBg: 'bg-blue-100',
    iconColor: 'text-blue-600',
    valueColor: 'text-blue-600',
    trendUp: 'text-green-600',
    trendDown: 'text-red-600'
  },
  green: {
    bg: 'bg-green-50',
    iconBg: 'bg-green-100',
    iconColor: 'text-green-600',
    valueColor: 'text-green-600',
    trendUp: 'text-green-600',
    trendDown: 'text-red-600'
  },
  yellow: {
    bg: 'bg-yellow-50',
    iconBg: 'bg-yellow-100',
    iconColor: 'text-yellow-600',
    valueColor: 'text-yellow-600',
    trendUp: 'text-green-600',
    trendDown: 'text-red-600'
  },
  red: {
    bg: 'bg-red-50',
    iconBg: 'bg-red-100',
    iconColor: 'text-red-600',
    valueColor: 'text-red-600',
    trendUp: 'text-green-600',
    trendDown: 'text-red-600'
  },
  purple: {
    bg: 'bg-purple-50',
    iconBg: 'bg-purple-100',
    iconColor: 'text-purple-600',
    valueColor: 'text-purple-600',
    trendUp: 'text-green-600',
    trendDown: 'text-red-600'
  },
  indigo: {
    bg: 'bg-indigo-50',
    iconBg: 'bg-indigo-100',
    iconColor: 'text-indigo-600',
    valueColor: 'text-indigo-600',
    trendUp: 'text-green-600',
    trendDown: 'text-red-600'
  }
};

const currentColor = colorConfig[color];
---

<div class={`${currentColor.bg} rounded-xl border border-gray-200 p-6 hover:shadow-lg transition-all duration-300 group`} data-motion="fade-up">
  <div class="flex items-center justify-between">
    <div class="flex-1">
      <!-- Title -->
      <p class="text-sm font-medium text-gray-600 mb-2">{title}</p>
      
      <!-- Value -->
      <div class="flex items-baseline space-x-2">
        {isLoading ? (
          <div class="animate-pulse">
            <div class="h-8 bg-gray-200 rounded w-16"></div>
          </div>
        ) : (
          <p class={`text-3xl font-bold ${currentColor.valueColor} font-mono`} id={`kpi-value-${title.toLowerCase().replace(/\s+/g, '-')}`}>
            0
          </p>
        )}
        
        <!-- Change indicator -->
        {change !== 0 && !isLoading && (
          <div class={`flex items-center text-sm font-medium ${
            trend === 'up' ? currentColor.trendUp : 
            trend === 'down' ? currentColor.trendDown : 
            'text-gray-500'
          }`}>
            {trend === 'up' && (
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
              </svg>
            )}
            {trend === 'down' && (
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path>
              </svg>
            )}
            {Math.abs(change)}%
          </div>
        )}
      </div>
    </div>
    
    <!-- Icon -->
    <div class={`w-12 h-12 ${currentColor.iconBg} rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300`}>
      <div class={`w-6 h-6 ${currentColor.iconColor}`} set:html={icon}></div>
    </div>
  </div>
  
  <!-- Progress bar (optional) -->
  {change !== 0 && (
    <div class="mt-4">
      <div class="w-full bg-gray-200 rounded-full h-2">
        <div 
          class={`h-2 rounded-full transition-all duration-1000 ease-out ${
            trend === 'up' ? 'bg-green-400' : 
            trend === 'down' ? 'bg-red-400' : 
            'bg-gray-400'
          }`}
          style={`width: ${Math.min(Math.abs(change), 100)}%`}
        ></div>
      </div>
    </div>
  )}
</div>

<script define:vars={{ value, title }}>
  // Animate counter on load
  document.addEventListener('DOMContentLoaded', () => {
    const elementId = `kpi-value-${title.toLowerCase().replace(/\s+/g, '-')}`;
    const element = document.getElementById(elementId);
    
    if (element && value > 0) {
      let current = 0;
      const increment = value / 50; // 50 steps for smooth animation
      const duration = 1500; // 1.5 seconds
      const stepTime = duration / 50;
      
      const timer = setInterval(() => {
        current += increment;
        if (current >= value) {
          current = value;
          clearInterval(timer);
        }
        element.textContent = Math.floor(current);
      }, stepTime);
    }
  });
</script>

<style>
  /* Custom styles for the widget */
  .group:hover .w-12 {
    transform: scale(1.1);
  }
</style>