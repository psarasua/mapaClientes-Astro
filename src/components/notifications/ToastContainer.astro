---
// src/components/notifications/ToastContainer.astro
---

<div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2 pointer-events-none">
  <!-- Toasts se insertan aquí dinámicamente -->
</div>

<style>
  /* Estilos para las animaciones de toast */
  @keyframes slideInRight {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }
  
  @keyframes slideOutRight {
    from {
      transform: translateX(0);
      opacity: 1;
    }
    to {
      transform: translateX(100%);
      opacity: 0;
    }
  }
  
  @keyframes progress {
    from {
      width: 100%;
    }
    to {
      width: 0%;
    }
  }
  
  /* Clases de animación para toasts */
  .toast-enter {
    animation: slideInRight 0.3s ease-out forwards;
  }
  
  .toast-exit {
    animation: slideOutRight 0.3s ease-in forwards;
  }
  
  .toast-progress {
    animation: progress linear forwards;
  }
  
  /* Hacer que los toasts sean interactivos */
  .toast {
    pointer-events: auto;
  }
</style>

<script>
  // Script para manejar los toasts globalmente
  class ToastManager {
    constructor() {
      this.container = document.getElementById('toast-container');
      this.toasts = new Map();
      this.toastCounter = 0;
    }
    
    show(type, title, message, duration = 5000) {
      const toastId = ++this.toastCounter;
      const toast = this.createToast(toastId, type, title, message, duration);
      
      this.container.appendChild(toast);
      this.toasts.set(toastId, toast);
      
      // Animar entrada
      requestAnimationFrame(() => {
        toast.classList.add('toast-enter');
      });
      
      // Auto-remove después del duration
      if (duration > 0) {
        setTimeout(() => {
          this.remove(toastId);
        }, duration);
      }
      
      return toastId;
    }
    
    createToast(id, type, title, message, duration) {
      const toast = document.createElement('div');
      toast.className = `toast max-w-sm bg-white rounded-lg shadow-lg border-l-4 overflow-hidden transform translate-x-full opacity-0 ${this.getTypeClasses(type)}`;
      toast.setAttribute('data-toast-id', id);
      
      const iconSvg = this.getIconSvg(type);
      const progressBar = duration > 0 ? this.createProgressBar(duration, type) : '';
      
      toast.innerHTML = `
        <div class="p-4">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              ${iconSvg}
            </div>
            <div class="ml-3 w-0 flex-1">
              <p class="text-sm font-medium text-gray-900">
                ${title}
              </p>
              <p class="mt-1 text-sm text-gray-500">
                ${message}
              </p>
            </div>
            <div class="ml-4 flex-shrink-0 flex">
              <button class="toast-close bg-white rounded-md inline-flex text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                <span class="sr-only">Cerrar</span>
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </button>
            </div>
          </div>
        </div>
        ${progressBar}
      `;
      
      // Event listener para cerrar
      const closeBtn = toast.querySelector('.toast-close');
      closeBtn.addEventListener('click', () => {
        this.remove(id);
      });
      
      return toast;
    }
    
    createProgressBar(duration, type) {
      const colorClass = this.getProgressColor(type);
      return `
        <div class="h-1 bg-gray-200">
          <div class="h-full ${colorClass} toast-progress" style="animation-duration: ${duration}ms;"></div>
        </div>
      `;
    }
    
    getTypeClasses(type) {
      const classes = {
        success: 'border-green-400',
        error: 'border-red-400',
        warning: 'border-yellow-400',
        info: 'border-blue-400'
      };
      return classes[type] || classes.info;
    }
    
    getProgressColor(type) {
      const colors = {
        success: 'bg-green-400',
        error: 'bg-red-400',
        warning: 'bg-yellow-400',
        info: 'bg-blue-400'
      };
      return colors[type] || colors.info;
    }
    
    getIconSvg(type) {
      const icons = {
        success: `
          <svg class="h-6 w-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        `,
        error: `
          <svg class="h-6 w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        `,
        warning: `
          <svg class="h-6 w-6 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        `,
        info: `
          <svg class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        `
      };
      return icons[type] || icons.info;
    }
    
    remove(toastId) {
      const toast = this.toasts.get(toastId);
      if (toast) {
        toast.classList.remove('toast-enter');
        toast.classList.add('toast-exit');
        
        setTimeout(() => {
          if (toast.parentNode) {
            toast.parentNode.removeChild(toast);
          }
          this.toasts.delete(toastId);
        }, 300);
      }
    }
    
    clear() {
      this.toasts.forEach((toast, id) => {
        this.remove(id);
      });
    }
  }
  
  // Crear instancia global
  window.toastManager = new ToastManager();
  
  // API global para mostrar notificaciones
  window.showToast = (type, title, message, duration) => {
    return window.toastManager.show(type, title, message, duration);
  };
  
  // Shortcuts para diferentes tipos
  window.showSuccess = (title, message, duration) => showToast('success', title, message, duration);
  window.showError = (title, message, duration) => showToast('error', title, message, duration);
  window.showWarning = (title, message, duration) => showToast('warning', title, message, duration);
  window.showInfo = (title, message, duration) => showToast('info', title, message, duration);
</script>