---
// src/components/modals/ClientDetailModal.astro
export interface Props {
  id?: string;
}

const { id = 'clientDetailModal' } = Astro.props;
---

<!-- Modal de Detalle del Cliente -->
<div id={id} class="fixed inset-0 bg-gray-900/80 backdrop-blur-sm z-50 hidden">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-hidden">
      <!-- Header del Modal -->
      <div class="relative bg-gradient-to-r from-blue-600 to-blue-700 px-8 py-6 text-white">
        <button id="closeDetailModal" class="absolute top-4 right-4 p-2 hover:bg-white/20 rounded-full transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
        
        <div class="flex items-center space-x-4">
          <div class="w-16 h-16 bg-white/20 rounded-2xl flex items-center justify-center backdrop-blur-sm">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-2xl font-bold" id="clientDetailName">Cliente</h3>
            <div class="flex items-center space-x-2 mt-1">
              <span id="clientDetailStatus" class="inline-flex px-3 py-1 text-xs font-semibold rounded-full bg-white/20 text-white"></span>
              <span class="text-blue-100 text-sm" id="clientDetailCode">-</span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Contenido del Modal -->
      <div class="overflow-y-auto max-h-[60vh]">
        <div class="p-8">
          <!-- Información de Contacto -->
          <div class="mb-8">
            <h4 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
              <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              Información de Contacto
            </h4>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Email -->
              <div class="group">
                <div class="flex items-center space-x-3 p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
                  <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-500">Email</p>
                    <p id="clientDetailEmail" class="text-gray-900 font-medium truncate">-</p>
                  </div>
                </div>
              </div>
              
              <!-- Teléfono -->
              <div class="group">
                <div class="flex items-center space-x-3 p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
                  <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center group-hover:bg-green-200 transition-colors">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-500">Teléfono</p>
                    <p id="clientDetailPhone" class="text-gray-900 font-medium">-</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Dirección y Ubicación -->
          <div class="mb-8">
            <h4 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
              <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              Dirección y Ubicación
            </h4>
            
            <div class="space-y-4">
              <!-- Dirección -->
              <div class="p-4 bg-gray-50 rounded-xl">
                <p class="text-sm font-medium text-gray-500 mb-1">Dirección</p>
                <p id="clientDetailAddress" class="text-gray-900 font-medium">-</p>
              </div>
              
              <!-- Coordenadas -->
              <div id="clientCoordinates" class="hidden">
                <div class="grid grid-cols-2 gap-4">
                  <div class="p-4 bg-purple-50 rounded-xl">
                    <p class="text-sm font-medium text-purple-600 mb-1">Latitud</p>
                    <p id="clientDetailLat" class="text-purple-900 font-mono text-sm">-</p>
                  </div>
                  <div class="p-4 bg-purple-50 rounded-xl">
                    <p class="text-sm font-medium text-purple-600 mb-1">Longitud</p>
                    <p id="clientDetailLng" class="text-purple-900 font-mono text-sm">-</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Información Legal -->
          <div class="mb-6">
            <h4 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
              <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              Información Legal
            </h4>
            
            <div class="p-4 bg-gray-50 rounded-xl">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-gray-500">RUT</p>
                  <p id="clientDetailRut" class="text-gray-900 font-mono">-</p>
                </div>
                <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center">
                  <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Footer del Modal -->
      <div class="border-t border-gray-200 p-6 bg-gray-50 rounded-b-2xl">
        <div class="flex flex-col sm:flex-row gap-3">
          <button onclick="editClientFromDetail()" 
                  class="flex-1 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white px-6 py-3 rounded-xl transition-all duration-200 font-medium flex items-center justify-center space-x-2 hover:shadow-lg transform hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <span>Editar Cliente</span>
          </button>
          <button id="closeDetailModalFooter" 
                  class="flex-1 bg-gray-300 hover:bg-gray-400 active:bg-gray-500 text-gray-700 px-6 py-3 rounded-xl transition-all duration-200 font-medium hover:shadow-lg transform hover:-translate-y-0.5">
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Animaciones del modal */
  #clientDetailModal {
    animation: modalFadeIn 0.3s ease-out;
  }

  #clientDetailModal .bg-white {
    animation: modalSlideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes modalFadeIn {
    from { 
      opacity: 0;
    }
    to { 
      opacity: 1;
    }
  }

  @keyframes modalSlideUp {
    from { 
      opacity: 0;
      transform: translateY(40px) scale(0.9);
    }
    to { 
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Efectos hover mejorados */
  .group:hover .w-12 {
    transform: scale(1.1);
  }

  /* Responsive */
  @media (max-width: 640px) {
    #clientDetailModal .max-w-2xl {
      max-width: 95vw;
      margin: 0.5rem;
    }

    #clientDetailModal .px-8 {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    #clientDetailModal .grid-cols-2 {
      grid-template-columns: 1fr;
    }
  }

  /* Efectos de estado del cliente */
  .status-active {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
  }

  .status-inactive {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: white;
  }

  /* Mejoras visuales adicionales */
  .hover\:shadow-lg:hover {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .transform:hover {
    transition: all 0.2s ease;
  }
</style>

<script>
  // Función para poblar el modal con datos del cliente
  window.showClientDetail = function(client) {
    // Poblar el modal con los datos del cliente
    document.getElementById('clientDetailName').textContent = client.nombre || client.razonsocial || 'Sin nombre';
    document.getElementById('clientDetailEmail').textContent = client.email || 'No especificado';
    document.getElementById('clientDetailPhone').textContent = client.telefono || 'No especificado';
    document.getElementById('clientDetailAddress').textContent = client.direccion || 'No especificada';
    document.getElementById('clientDetailRut').textContent = client.rut || 'No especificado';
    document.getElementById('clientDetailCode').textContent = client.codigoalte ? `#${client.codigoalte}` : '';
    
    // Estado del cliente con estilos mejorados
    const statusEl = document.getElementById('clientDetailStatus');
    const isActive = client.estado === 'Activo';
    statusEl.textContent = client.estado || 'Activo';
    
    if (isActive) {
      statusEl.className = 'inline-flex px-3 py-1 text-xs font-semibold rounded-full status-active';
    } else {
      statusEl.className = 'inline-flex px-3 py-1 text-xs font-semibold rounded-full status-inactive';
    }
    
    // Coordenadas si existen
    const coordsContainer = document.getElementById('clientCoordinates');
    if (client.latitud && client.longitud) {
      document.getElementById('clientDetailLat').textContent = parseFloat(client.latitud).toFixed(6);
      document.getElementById('clientDetailLng').textContent = parseFloat(client.longitud).toFixed(6);
      coordsContainer.classList.remove('hidden');
    } else {
      coordsContainer.classList.add('hidden');
    }
    
    // Guardar cliente actual para edición
    window.currentDetailClient = client;
    
    // Mostrar modal con animación
    const modal = document.getElementById('clientDetailModal');
    modal.classList.remove('hidden');
    
    // Animación de entrada con delay
    setTimeout(() => {
      modal.style.opacity = '1';
    }, 10);
  };

  // Función para ocultar el modal
  window.hideClientDetail = function() {
    const modal = document.getElementById('clientDetailModal');
    modal.style.opacity = '0';
    
    setTimeout(() => {
      modal.classList.add('hidden');
      window.currentDetailClient = null;
    }, 300);
  };

  // Event listeners
  document.addEventListener('DOMContentLoaded', () => {
    // Cerrar modal
    document.getElementById('closeDetailModal')?.addEventListener('click', hideClientDetail);
    document.getElementById('closeDetailModalFooter')?.addEventListener('click', hideClientDetail);
    
    // Cerrar modal al hacer click fuera
    document.getElementById('clientDetailModal')?.addEventListener('click', (e) => {
      if (e.target.id === 'clientDetailModal') {
        hideClientDetail();
      }
    });

    // Cerrar modal con tecla Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !document.getElementById('clientDetailModal').classList.contains('hidden')) {
        hideClientDetail();
      }
    });
  });
</script>