---
// Motion Animation System - Global Component
// No props needed - provides motion system to entire page
---

const animationId = `anim-${Math.random().toString(36).substr(2, 9)}`;
---

<div id={animationId} class={`motion-element ${className}`} data-animation={type} data-delay={delay} data-duration={duration}>
  {children}
</div>

<script>
  // Framer Motion-like animations with vanilla JS
  class MotionManager {
    constructor() {
      this.observers = new Map();
      this.initializeAnimations();
    }

    initializeAnimations() {
      // Setup intersection observer for reveal animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            this.animateElement(entry.target);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      });

      // Observe all motion elements
      document.querySelectorAll('.motion-element').forEach(el => {
        observer.observe(el);
      });
    }

    animateElement(element) {
      const animationType = element.dataset.animation;
      const delay = parseFloat(element.dataset.delay) || 0;
      const duration = parseFloat(element.dataset.duration) || 0.6;

      setTimeout(() => {
        element.classList.add('motion-animate');
        this.applyAnimation(element, animationType, duration);
      }, delay * 1000);
    }

    applyAnimation(element, type, duration) {
      const animations = {
        fadeIn: {
          from: { opacity: 0 },
          to: { opacity: 1 }
        },
        slideUp: {
          from: { opacity: 0, transform: 'translateY(30px)' },
          to: { opacity: 1, transform: 'translateY(0)' }
        },
        slideDown: {
          from: { opacity: 0, transform: 'translateY(-30px)' },
          to: { opacity: 1, transform: 'translateY(0)' }
        },
        slideLeft: {
          from: { opacity: 0, transform: 'translateX(30px)' },
          to: { opacity: 1, transform: 'translateX(0)' }
        },
        slideRight: {
          from: { opacity: 0, transform: 'translateX(-30px)' },
          to: { opacity: 1, transform: 'translateX(0)' }
        },
        scale: {
          from: { opacity: 0, transform: 'scale(0.9)' },
          to: { opacity: 1, transform: 'scale(1)' }
        }
      };

      const animation = animations[type] || animations.fadeIn;
      
      // Apply initial state
      Object.assign(element.style, animation.from);
      
      // Animate to final state
      element.style.transition = `all ${duration}s cubic-bezier(0.4, 0, 0.2, 1)`;
      
      requestAnimationFrame(() => {
        Object.assign(element.style, animation.to);
      });
    }

    // Stagger animation for multiple elements
    staggerElements(selector, delay = 0.1) {
      const elements = document.querySelectorAll(selector);
      elements.forEach((element, index) => {
        element.style.animationDelay = `${index * delay}s`;
        element.classList.add('motion-stagger');
      });
    }

    // Page transition
    pageTransition(callback, duration = 0.3) {
      const overlay = document.createElement('div');
      overlay.className = 'page-transition-overlay';
      overlay.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(45deg, #4A90E2, #357ABD);
        z-index: 9999;
        opacity: 0;
        transition: opacity ${duration}s ease;
      `;
      
      document.body.appendChild(overlay);
      
      requestAnimationFrame(() => {
        overlay.style.opacity = '1';
        
        setTimeout(() => {
          if (callback) callback();
          
          setTimeout(() => {
            overlay.style.opacity = '0';
            setTimeout(() => {
              document.body.removeChild(overlay);
            }, duration * 1000);
          }, 100);
        }, duration * 1000);
      });
    }

    // Hover animations
    addHoverAnimation(element, scale = 1.05) {
      element.style.transition = 'transform 0.2s cubic-bezier(0.4, 0, 0.2, 1)';
      
      element.addEventListener('mouseenter', () => {
        element.style.transform = `scale(${scale})`;
      });
      
      element.addEventListener('mouseleave', () => {
        element.style.transform = 'scale(1)';
      });
    }

    // Loading animation
    createLoadingAnimation(element) {
      element.innerHTML = `
        <div class="loading-dots">
          <div class="dot"></div>
          <div class="dot"></div>
          <div class="dot"></div>
        </div>
      `;
      
      const style = document.createElement('style');
      style.textContent = `
        .loading-dots {
          display: flex;
          gap: 4px;
          justify-content: center;
          align-items: center;
        }
        .loading-dots .dot {
          width: 8px;
          height: 8px;
          border-radius: 50%;
          background: #4A90E2;
          animation: loadingPulse 1.4s ease-in-out infinite both;
        }
        .loading-dots .dot:nth-child(1) { animation-delay: -0.32s; }
        .loading-dots .dot:nth-child(2) { animation-delay: -0.16s; }
        .loading-dots .dot:nth-child(3) { animation-delay: 0s; }
        
        @keyframes loadingPulse {
          0%, 80%, 100% {
            transform: scale(0.8);
            opacity: 0.5;
          }
          40% {
            transform: scale(1);
            opacity: 1;
          }
        }
      `;
      
      if (!document.querySelector('#loading-dots-style')) {
        style.id = 'loading-dots-style';
        document.head.appendChild(style);
      }
    }
  }

  // Initialize motion manager when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    window.motionManager = new MotionManager();
  });
</script>

<style>
  .motion-element {
    opacity: 0;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .motion-animate {
    opacity: 1;
  }

  .motion-stagger {
    animation: staggerFadeIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes staggerFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Smooth page transitions */
  .page-transition-overlay {
    pointer-events: none;
  }

  /* Enhance existing hover effects */
  .card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .btn-primary, .btn-secondary, .btn-outline {
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-primary:hover, .btn-secondary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(74, 144, 226, 0.3);
  }

  .btn-outline:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  /* Smooth input focus animations */
  .input-field {
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .input-field:focus {
    transform: translateY(-1px);
    box-shadow: 0 4px 6px -1px rgba(74, 144, 226, 0.1);
  }

  /* Micro-interactions for navigation */
  nav a {
    position: relative;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  nav a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: currentColor;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateX(-50%);
  }

  nav a:hover::after {
    width: 100%;
  }

  /* Table row animations */
  tbody tr {
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  tbody tr:hover {
    background-color: rgba(74, 144, 226, 0.05);
    transform: translateX(4px);
  }

  /* Stats cards pulse animation */
  @keyframes statsUpdate {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  .stats-update {
    animation: statsUpdate 0.6s ease-out;
  }
</style>