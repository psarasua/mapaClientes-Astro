---
interface Props {
  columns: Array<{
    key: string;
    label: string;
    sortable?: boolean;
    width?: string;
    align?: 'left' | 'center' | 'right';
    type?: 'text' | 'number' | 'date' | 'badge' | 'actions';
  }>;
  data: Array<Record<string, any>>;
  loading?: boolean;
  pagination?: {
    current: number;
    total: number;
    pageSize: number;
  };
  selectable?: boolean;
}

const { 
  columns, 
  data, 
  loading = false, 
  pagination,
  selectable = false 
} = Astro.props;

// Generate unique ID for this table
const tableId = `table-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden" data-motion="fade-up" data-delay="200">
  <!-- Table Header with Actions -->
  <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <div class="flex items-center space-x-2">
          <span class="text-sm font-medium text-gray-700">
            {pagination ? `${((pagination.current - 1) * pagination.pageSize) + 1}-${Math.min(pagination.current * pagination.pageSize, pagination.total)} de ${pagination.total}` : `${data.length} registros`}
          </span>
        </div>
        
        {selectable && (
          <div class="flex items-center space-x-2">
            <input 
              type="checkbox" 
              id={`${tableId}-select-all`}
              class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
            />
            <label for={`${tableId}-select-all`} class="text-sm text-gray-600">
              Seleccionar todos
            </label>
          </div>
        )}
      </div>
      
      <div class="flex items-center space-x-2">
        <!-- View Options -->
        <div class="flex items-center space-x-1 bg-white rounded-lg border border-gray-200 p-1">
          <button 
            class="p-1 rounded text-gray-400 hover:text-gray-600 transition-colors"
            title="Vista de lista"
            data-view="list"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
            </svg>
          </button>
          <button 
            class="p-1 rounded text-blue-600 bg-blue-50 transition-colors"
            title="Vista de tabla"
            data-view="table"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18M7 6h10M7 18h10"></path>
            </svg>
          </button>
        </div>
        
        <!-- Density -->
        <select class="text-sm border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" id={`${tableId}-density`}>
          <option value="comfortable">Cómodo</option>
          <option value="standard" selected>Estándar</option>
          <option value="compact">Compacto</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Table Container -->
  <div class="overflow-x-auto">
    {loading ? (
      <div class="flex items-center justify-center py-12">
        <div class="flex flex-col items-center space-y-3">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
          <p class="text-gray-500 text-sm">Cargando datos...</p>
        </div>
      </div>
    ) : (
      <table class="min-w-full divide-y divide-gray-200" id={tableId}>
        <thead class="bg-gray-50">
          <tr>
            {selectable && (
              <th scope="col" class="w-12 px-6 py-3">
                <span class="sr-only">Seleccionar</span>
              </th>
            )}
            {columns.map((column) => (
              <th 
                scope="col" 
                class={`px-6 py-3 text-${column.align || 'left'} text-xs font-medium text-gray-500 uppercase tracking-wider ${column.sortable ? 'cursor-pointer hover:bg-gray-100 transition-colors' : ''}`}
                style={column.width ? `width: ${column.width}` : ''}
                data-sort-key={column.sortable ? column.key : ''}
              >
                <div class="flex items-center space-x-1">
                  <span>{column.label}</span>
                  {column.sortable && (
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path>
                    </svg>
                  )}
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200" id={`${tableId}-body`}>
          {data.length === 0 ? (
            <tr>
              <td colspan={columns.length + (selectable ? 1 : 0)} class="px-6 py-12 text-center">
                <div class="flex flex-col items-center space-y-3">
                  <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                  </svg>
                  <div>
                    <p class="text-gray-500 font-medium">No hay datos para mostrar</p>
                    <p class="text-gray-400 text-sm">Intenta ajustar los filtros de búsqueda</p>
                  </div>
                </div>
              </td>
            </tr>
          ) : (
            data.map((row, index) => (
              <tr 
                class="hover:bg-gray-50 transition-colors cursor-pointer" 
                data-row-index={index}
                data-motion="fade-up" 
                data-delay={index * 50}
              >
                {selectable && (
                  <td class="px-6 py-4 whitespace-nowrap">
                    <input 
                      type="checkbox" 
                      class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                      data-row-select
                    />
                  </td>
                )}
                {columns.map((column) => (
                  <td class={`px-6 py-4 whitespace-nowrap text-${column.align || 'left'}`}>
                    {column.type === 'badge' ? (
                      <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${getBadgeClass(row[column.key])}`}>
                        {row[column.key]}
                      </span>
                    ) : column.type === 'actions' ? (
                      <div class="flex items-center space-x-2">
                        <button class="text-blue-600 hover:text-blue-900 text-sm font-medium">
                          Editar
                        </button>
                        <button class="text-red-600 hover:text-red-900 text-sm font-medium">
                          Eliminar
                        </button>
                      </div>
                    ) : column.type === 'date' ? (
                      <span class="text-sm text-gray-900">
                        {new Date(row[column.key]).toLocaleDateString('es-ES')}
                      </span>
                    ) : column.type === 'number' ? (
                      <span class="text-sm font-medium text-gray-900">
                        {typeof row[column.key] === 'number' ? row[column.key].toLocaleString('es-ES') : row[column.key]}
                      </span>
                    ) : (
                      <span class="text-sm text-gray-900">
                        {row[column.key]}
                      </span>
                    )}
                  </td>
                ))}
              </tr>
            ))
          )}
        </tbody>
      </table>
    )}
  </div>

  <!-- Pagination -->
  {pagination && (
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <span class="text-sm text-gray-700">Registros por página:</span>
          <select class="text-sm border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" id={`${tableId}-page-size`}>
            <option value="10" selected={pagination.pageSize === 10}>10</option>
            <option value="25" selected={pagination.pageSize === 25}>25</option>
            <option value="50" selected={pagination.pageSize === 50}>50</option>
            <option value="100" selected={pagination.pageSize === 100}>100</option>
          </select>
        </div>
        
        <div class="flex items-center space-x-2">
          <button 
            class="px-3 py-1 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
            disabled={pagination.current === 1}
            data-page="prev"
          >
            Anterior
          </button>
          
          <div class="flex items-center space-x-1">
            {Array.from({ length: Math.min(5, Math.ceil(pagination.total / pagination.pageSize)) }, (_, i) => {
              const page = i + 1;
              return (
                <button 
                  class={`px-3 py-1 text-sm font-medium rounded-lg transition-colors ${
                    page === pagination.current 
                      ? 'bg-blue-600 text-white' 
                      : 'text-gray-500 bg-white border border-gray-300 hover:bg-gray-50'
                  }`}
                  data-page={page}
                >
                  {page}
                </button>
              );
            })}
          </div>
          
          <button 
            class="px-3 py-1 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
            disabled={pagination.current === Math.ceil(pagination.total / pagination.pageSize)}
            data-page="next"
          >
            Siguiente
          </button>
        </div>
      </div>
    </div>
  )}
</div>

<script define:vars={{ tableId, selectable }}>
  document.addEventListener('DOMContentLoaded', () => {
    const table = document.getElementById(tableId);
    const tbody = document.getElementById(`${tableId}-body`);
    const selectAllCheckbox = document.getElementById(`${tableId}-select-all`);
    const densitySelect = document.getElementById(`${tableId}-density`);
    const pageSizeSelect = document.getElementById(`${tableId}-page-size`);
    
    let sortDirection = {};
    let selectedRows = new Set();
    
    // Helper function to get badge classes
    window.getBadgeClass = function(status) {
      const classes = {
        'Activo': 'bg-green-100 text-green-800',
        'Inactivo': 'bg-red-100 text-red-800',
        'Pendiente': 'bg-yellow-100 text-yellow-800',
        'Completado': 'bg-blue-100 text-blue-800',
        'En Proceso': 'bg-purple-100 text-purple-800',
        'Cancelado': 'bg-gray-100 text-gray-800'
      };
      return classes[status] || 'bg-gray-100 text-gray-800';
    };
    
    // Sorting functionality
    table?.addEventListener('click', (e) => {
      const header = e.target.closest('[data-sort-key]');
      if (header && header.dataset.sortKey) {
        const key = header.dataset.sortKey;
        const currentDirection = sortDirection[key] || 'asc';
        const newDirection = currentDirection === 'asc' ? 'desc' : 'asc';
        sortDirection[key] = newDirection;
        
        // Update sort indicators
        table.querySelectorAll('[data-sort-key] svg').forEach(svg => {
          svg.style.transform = 'rotate(0deg)';
          svg.style.color = '#9CA3AF';
        });
        
        const svg = header.querySelector('svg');
        if (svg) {
          svg.style.transform = newDirection === 'desc' ? 'rotate(180deg)' : 'rotate(0deg)';
          svg.style.color = '#3B82F6';
        }
        
        // Dispatch sort event
        window.dispatchEvent(new CustomEvent('tableSort', {
          detail: { key, direction: newDirection }
        }));
      }
    });
    
    // Row selection
    if (selectable) {
      // Select all functionality
      selectAllCheckbox?.addEventListener('change', (e) => {
        const checkboxes = tbody?.querySelectorAll('[data-row-select]');
        checkboxes?.forEach(checkbox => {
          checkbox.checked = e.target.checked;
          const row = checkbox.closest('tr');
          if (row) {
            if (e.target.checked) {
              selectedRows.add(row.dataset.rowIndex);
              row.classList.add('bg-blue-50');
            } else {
              selectedRows.delete(row.dataset.rowIndex);
              row.classList.remove('bg-blue-50');
            }
          }
        });
        
        updateSelectionInfo();
      });
      
      // Individual row selection
      tbody?.addEventListener('change', (e) => {
        if (e.target.hasAttribute('data-row-select')) {
          const row = e.target.closest('tr');
          if (row) {
            if (e.target.checked) {
              selectedRows.add(row.dataset.rowIndex);
              row.classList.add('bg-blue-50');
            } else {
              selectedRows.delete(row.dataset.rowIndex);
              row.classList.remove('bg-blue-50');
            }
          }
          
          // Update select all checkbox
          const allCheckboxes = tbody.querySelectorAll('[data-row-select]');
          const checkedCheckboxes = tbody.querySelectorAll('[data-row-select]:checked');
          if (selectAllCheckbox) {
            selectAllCheckbox.checked = allCheckboxes.length === checkedCheckboxes.length;
            selectAllCheckbox.indeterminate = checkedCheckboxes.length > 0 && checkedCheckboxes.length < allCheckboxes.length;
          }
          
          updateSelectionInfo();
        }
      });
    }
    
    // Density control
    densitySelect?.addEventListener('change', (e) => {
      const density = e.target.value;
      const cells = table?.querySelectorAll('td, th');
      
      cells?.forEach(cell => {
        cell.classList.remove('py-2', 'py-3', 'py-4');
        switch (density) {
          case 'compact':
            cell.classList.add('py-2');
            break;
          case 'comfortable':
            cell.classList.add('py-4');
            break;
          default:
            cell.classList.add('py-3');
        }
      });
    });
    
    // Page size control
    pageSizeSelect?.addEventListener('change', (e) => {
      window.dispatchEvent(new CustomEvent('pageSizeChange', {
        detail: { pageSize: parseInt(e.target.value) }
      }));
    });
    
    // Pagination
    table?.addEventListener('click', (e) => {
      const pageBtn = e.target.closest('[data-page]');
      if (pageBtn && pageBtn.dataset.page) {
        window.dispatchEvent(new CustomEvent('pageChange', {
          detail: { page: pageBtn.dataset.page }
        }));
      }
    });
    
    // Row click
    tbody?.addEventListener('click', (e) => {
      const row = e.target.closest('tr[data-row-index]');
      if (row && !e.target.closest('input, button')) {
        window.dispatchEvent(new CustomEvent('rowClick', {
          detail: { 
            rowIndex: parseInt(row.dataset.rowIndex),
            element: row 
          }
        }));
      }
    });
    
    function updateSelectionInfo() {
      window.dispatchEvent(new CustomEvent('selectionChange', {
        detail: { 
          selectedCount: selectedRows.size,
          selectedRows: Array.from(selectedRows)
        }
      }));
    }
  });
</script>