---
interface Props {
  searchFields: Array<{
    key: string;
    label: string;
    type: 'text' | 'select' | 'date' | 'number';
    options?: Array<{ value: string; label: string }>;
    placeholder?: string;
  }>;
  onSearch?: string;
  initialFilters?: Record<string, any>;
}

const { searchFields, onSearch = 'handleSearch', initialFilters = {} } = Astro.props;

// Generate unique ID for this search component
const searchId = `search-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6" data-motion="fade-up">
  <!-- Search Header -->
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center space-x-3">
      <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900">Búsqueda Avanzada</h3>
    </div>
    
    <!-- Toggle and Actions -->
    <div class="flex items-center space-x-2">
      <button 
        id={`${searchId}-toggle`}
        class="text-sm text-gray-500 hover:text-gray-700 flex items-center space-x-1 transition-colors"
      >
        <svg class="w-4 h-4 transition-transform duration-200" id={`${searchId}-chevron`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
        <span>Contraer</span>
      </button>
      
      <button 
        id={`${searchId}-clear`}
        class="text-sm text-red-600 hover:text-red-800 font-medium transition-colors"
      >
        Limpiar Filtros
      </button>
    </div>
  </div>

  <!-- Search Fields Container -->
  <div id={`${searchId}-container`} class="search-container search-expanded">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-4">
      {searchFields.map((field) => (
        <div class="space-y-1">
          <label class="block text-sm font-medium text-gray-700">
            {field.label}
          </label>
          
          {field.type === 'text' && (
            <input
              type="text"
              name={field.key}
              placeholder={field.placeholder}
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-sm"
              data-search-field
            />
          )}
          
          {field.type === 'number' && (
            <input
              type="number"
              name={field.key}
              placeholder={field.placeholder}
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-sm"
              data-search-field
            />
          )}
          
          {field.type === 'date' && (
            <input
              type="date"
              name={field.key}
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-sm"
              data-search-field
            />
          )}
          
          {field.type === 'select' && field.options && (
            <select
              name={field.key}
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-sm"
              data-search-field
            >
              <option value="">Todos</option>
              {field.options.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          )}
        </div>
      ))}
    </div>
    
    <!-- Search Actions -->
    <div class="flex items-center justify-between pt-4 border-t border-gray-200">
      <div class="flex items-center space-x-2 text-sm text-gray-500">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>Los filtros se aplican automáticamente</span>
      </div>
      
      <div class="flex items-center space-x-3">
        <button 
          id={`${searchId}-export`}
          class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors flex items-center space-x-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <span>Exportar</span>
        </button>
        
        <button 
          id={`${searchId}-save`}
          class="px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors flex items-center space-x-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
          </svg>
          <span>Guardar Filtros</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ searchId, onSearch, initialFilters }}>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById(`${searchId}-container`);
    const toggle = document.getElementById(`${searchId}-toggle`);
    const chevron = document.getElementById(`${searchId}-chevron`);
    const clearBtn = document.getElementById(`${searchId}-clear`);
    const saveBtn = document.getElementById(`${searchId}-save`);
    const exportBtn = document.getElementById(`${searchId}-export`);
    const searchFields = container.querySelectorAll('[data-search-field]');
    
    let isCollapsed = false;
    let searchTimeout;
    
    // Load saved filters from localStorage
    const savedFilters = localStorage.getItem(`search-filters-${window.location.pathname}`);
    if (savedFilters) {
      try {
        const filters = JSON.parse(savedFilters);
        Object.keys(filters).forEach(key => {
          const field = container.querySelector(`[name="${key}"]`);
          if (field) {
            field.value = filters[key];
          }
        });
      } catch (e) {
        console.warn('Error loading saved filters:', e);
      }
    } else if (initialFilters && Object.keys(initialFilters).length > 0) {
      // Apply initial filters
      Object.keys(initialFilters).forEach(key => {
        const field = container.querySelector(`[name="${key}"]`);
        if (field) {
          field.value = initialFilters[key];
        }
      });
    }
    
    // Toggle collapse/expand
    toggle?.addEventListener('click', () => {
      isCollapsed = !isCollapsed;
      
      if (isCollapsed) {
        container.classList.remove('search-expanded');
        container.classList.add('search-collapsed');
        chevron.style.transform = 'rotate(-90deg)';
        toggle.querySelector('span').textContent = 'Expandir';
      } else {
        container.classList.remove('search-collapsed');
        container.classList.add('search-expanded');
        chevron.style.transform = 'rotate(0deg)';
        toggle.querySelector('span').textContent = 'Contraer';
      }
    });
    
    // Real-time search with debounce
    function performSearch() {
      const filters = {};
      let hasActiveFilters = false;
      
      searchFields.forEach(field => {
        if (field.value.trim()) {
          filters[field.name] = field.value.trim();
          hasActiveFilters = true;
        }
      });
      
      // Update clear button visibility
      if (clearBtn) {
        clearBtn.style.opacity = hasActiveFilters ? '1' : '0.5';
        clearBtn.style.pointerEvents = hasActiveFilters ? 'auto' : 'none';
      }
      
      // Call the search function if it exists
      if (window[onSearch] && typeof window[onSearch] === 'function') {
        window[onSearch](filters);
      }
      
      // Dispatch custom event
      window.dispatchEvent(new CustomEvent('advancedSearch', {
        detail: { filters, hasActiveFilters }
      }));
    }
    
    // Add event listeners to all search fields
    searchFields.forEach(field => {
      field.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(performSearch, 300);
      });
      
      field.addEventListener('change', performSearch);
    });
    
    // Clear filters
    clearBtn?.addEventListener('click', () => {
      searchFields.forEach(field => {
        field.value = '';
      });
      performSearch();
      
      // Remove saved filters
      localStorage.removeItem(`search-filters-${window.location.pathname}`);
      
      // Show success feedback
      showToast('Filtros limpiados exitosamente', 'success');
    });
    
    // Save filters
    saveBtn?.addEventListener('click', () => {
      const filters = {};
      let hasFilters = false;
      
      searchFields.forEach(field => {
        if (field.value.trim()) {
          filters[field.name] = field.value.trim();
          hasFilters = true;
        }
      });
      
      if (hasFilters) {
        localStorage.setItem(`search-filters-${window.location.pathname}`, JSON.stringify(filters));
        showToast('Filtros guardados exitosamente', 'success');
      } else {
        showToast('No hay filtros activos para guardar', 'warning');
      }
    });
    
    // Export functionality
    exportBtn?.addEventListener('click', () => {
      // Dispatch export event
      window.dispatchEvent(new CustomEvent('exportData', {
        detail: { source: 'search' }
      }));
    });
    
    // Trigger initial search if there are saved filters
    if (savedFilters || Object.keys(initialFilters).length > 0) {
      setTimeout(performSearch, 100);
    }
    
    // Simple toast notification function
    function showToast(message, type = 'info') {
      const existingToast = document.querySelector('.search-toast');
      if (existingToast) existingToast.remove();
      
      const toast = document.createElement('div');
      toast.className = `search-toast fixed top-4 right-4 px-4 py-2 rounded-lg text-white text-sm font-medium z-50 transform transition-all duration-300 translate-x-full`;
      
      const colors = {
        success: 'bg-green-500',
        warning: 'bg-yellow-500',
        error: 'bg-red-500',
        info: 'bg-blue-500'
      };
      
      toast.classList.add(colors[type] || colors.info);
      toast.textContent = message;
      
      document.body.appendChild(toast);
      
      setTimeout(() => toast.classList.remove('translate-x-full'), 100);
      setTimeout(() => {
        toast.classList.add('translate-x-full');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }
  });
</script>

<style>
  .search-container {
    transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out;
  }
  
  .search-collapsed {
    max-height: 0px;
    opacity: 0;
    overflow: hidden;
  }
  
  .search-expanded {
    max-height: none;
    opacity: 1;
    overflow: visible;
  }
</style>