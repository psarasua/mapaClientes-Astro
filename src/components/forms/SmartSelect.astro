---
// src/components/forms/SmartSelect.astro
interface Props {
  name: string;
  label: string;
  required?: boolean;
  value?: string;
  placeholder?: string;
  helpText?: string;
  options: Array<{value: string, label: string, disabled?: boolean}>;
  searchable?: boolean;
  multiple?: boolean;
  className?: string;
}

const {
  name,
  label,
  required = false,
  value = "",
  placeholder = "Seleccionar...",
  helpText,
  options = [],
  searchable = false,
  multiple = false,
  className = ""
} = Astro.props;

const selectId = `select-${name}`;
---

<div class={`smart-select-group ${className}`}>
  <!-- Label -->
  <label for={selectId} class="block text-sm font-medium text-gray-700 mb-1">
    {label}
    {required && <span class="text-red-500 ml-1">*</span>}
  </label>
  
  {searchable ? (
    <!-- Searchable select -->
    <div class="relative">
      <input
        type="text"
        id={`${selectId}-search`}
        placeholder={placeholder}
        readonly={!searchable}
        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 cursor-pointer"
      />
      
      <!-- Hidden select for form submission -->
      <select
        id={selectId}
        name={name}
        required={required}
        multiple={multiple}
        class="hidden"
      >
        {!required && <option value="">Seleccionar...</option>}
        {options.map(option => (
          <option 
            value={option.value} 
            disabled={option.disabled}
            selected={value === option.value}
          >
            {option.label}
          </option>
        ))}
      </select>
      
      <!-- Dropdown arrow -->
      <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </div>
      
      <!-- Options dropdown -->
      <div 
        id={`${selectId}-dropdown`}
        class="absolute z-20 w-full bg-white border border-gray-300 rounded-md shadow-lg max-h-48 overflow-y-auto mt-1 hidden"
      >
        {options.map((option, index) => (
          <div
            class={`px-3 py-2 hover:bg-gray-100 cursor-pointer text-sm ${option.disabled ? 'opacity-50 cursor-not-allowed' : ''}`}
            data-value={option.value}
            data-label={option.label}
            data-disabled={option.disabled}
          >
            {option.label}
          </div>
        ))}
      </div>
    </div>
  ) : (
    <!-- Standard select -->
    <select
      id={selectId}
      name={name}
      required={required}
      multiple={multiple}
      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200"
    >
      {!required && <option value="">{placeholder}</option>}
      {options.map(option => (
        <option 
          value={option.value} 
          disabled={option.disabled}
          selected={value === option.value}
        >
          {option.label}
        </option>
      ))}
    </select>
  )}
  
  <!-- Help text -->
  {helpText && (
    <p class="mt-1 text-sm text-gray-500">
      {helpText}
    </p>
  )}
  
  <!-- Error message placeholder -->
  <div id={`${selectId}-error`} class="mt-1 text-sm text-red-600 hidden"></div>
</div>

<script define:vars={{ selectId, searchable, options, multiple, value }}>
  document.addEventListener('DOMContentLoaded', () => {
    if (!searchable) return;
    
    const searchInput = document.getElementById(`${selectId}-search`);
    const hiddenSelect = document.getElementById(selectId);
    const dropdown = document.getElementById(`${selectId}-dropdown`);
    
    if (!searchInput || !hiddenSelect || !dropdown) return;
    
    let isOpen = false;
    let filteredOptions = [...options];
    let selectedValues = multiple ? [] : null;
    
    // Initialize with default value
    if (value) {
      if (multiple) {
        selectedValues = Array.isArray(value) ? value : [value];
      } else {
        selectedValues = value;
        const selectedOption = options.find(opt => opt.value === value);
        if (selectedOption) {
          searchInput.value = selectedOption.label;
        }
      }
    }
    
    // Toggle dropdown
    searchInput.addEventListener('click', () => {
      toggleDropdown();
    });
    
    // Search functionality
    searchInput.addEventListener('input', () => {
      if (!searchInput.readOnly) {
        filterOptions(searchInput.value);
      }
    });
    
    // Handle option selection
    dropdown.addEventListener('click', (e) => {
      const optionEl = e.target.closest('[data-value]');
      if (!optionEl || optionEl.dataset.disabled === 'true') return;
      
      const optionValue = optionEl.dataset.value;
      const optionLabel = optionEl.dataset.label;
      
      if (multiple) {
        toggleMultipleSelection(optionValue, optionLabel, optionEl);
      } else {
        selectSingle(optionValue, optionLabel);
        closeDropdown();
      }
    });
    
    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
        closeDropdown();
      }
    });
    
    // Keyboard navigation
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!isOpen) {
          openDropdown();
        } else {
          navigateOptions(e.key === 'ArrowDown' ? 1 : -1);
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const highlighted = dropdown.querySelector('.highlighted');
        if (highlighted) {
          highlighted.click();
        }
      } else if (e.key === 'Escape') {
        closeDropdown();
      }
    });
    
    function toggleDropdown() {
      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
      }
    }
    
    function openDropdown() {
      dropdown.classList.remove('hidden');
      isOpen = true;
      updateDropdownOptions();
    }
    
    function closeDropdown() {
      dropdown.classList.add('hidden');
      isOpen = false;
      
      // Reset search input if nothing selected
      if (!multiple && !selectedValues) {
        searchInput.value = '';
      }
    }
    
    function filterOptions(searchTerm) {
      filteredOptions = options.filter(option =>
        option.label.toLowerCase().includes(searchTerm.toLowerCase())
      );
      updateDropdownOptions();
    }
    
    function updateDropdownOptions() {
      dropdown.innerHTML = '';
      
      if (filteredOptions.length === 0) {
        const noResults = document.createElement('div');
        noResults.className = 'px-3 py-2 text-sm text-gray-500';
        noResults.textContent = 'No se encontraron resultados';
        dropdown.appendChild(noResults);
        return;
      }
      
      filteredOptions.forEach(option => {
        const optionEl = document.createElement('div');
        optionEl.className = `px-3 py-2 hover:bg-gray-100 cursor-pointer text-sm ${
          option.disabled ? 'opacity-50 cursor-not-allowed' : ''
        }`;
        
        // Add selected styling for multiple select
        if (multiple && selectedValues.includes(option.value)) {
          optionEl.classList.add('bg-blue-50', 'text-blue-700');
        }
        
        optionEl.dataset.value = option.value;
        optionEl.dataset.label = option.label;
        optionEl.dataset.disabled = option.disabled;
        optionEl.textContent = option.label;
        
        dropdown.appendChild(optionEl);
      });
    }
    
    function selectSingle(value, label) {
      selectedValues = value;
      searchInput.value = label;
      hiddenSelect.value = value;
      
      // Trigger change event
      hiddenSelect.dispatchEvent(new Event('change'));
    }
    
    function toggleMultipleSelection(value, label, optionEl) {
      if (selectedValues.includes(value)) {
        // Remove selection
        selectedValues = selectedValues.filter(v => v !== value);
        optionEl.classList.remove('bg-blue-50', 'text-blue-700');
      } else {
        // Add selection
        selectedValues.push(value);
        optionEl.classList.add('bg-blue-50', 'text-blue-700');
      }
      
      updateMultipleDisplay();
      updateHiddenSelect();
    }
    
    function updateMultipleDisplay() {
      if (selectedValues.length === 0) {
        searchInput.value = '';
      } else if (selectedValues.length === 1) {
        const option = options.find(opt => opt.value === selectedValues[0]);
        searchInput.value = option ? option.label : '';
      } else {
        searchInput.value = `${selectedValues.length} seleccionados`;
      }
    }
    
    function updateHiddenSelect() {
      // Clear existing selections
      Array.from(hiddenSelect.options).forEach(option => {
        option.selected = false;
      });
      
      // Set new selections
      selectedValues.forEach(value => {
        const option = hiddenSelect.querySelector(`option[value="${value}"]`);
        if (option) {
          option.selected = true;
        }
      });
      
      // Trigger change event
      hiddenSelect.dispatchEvent(new Event('change'));
    }
    
    function navigateOptions(direction) {
      const visibleOptions = dropdown.querySelectorAll('[data-value]:not([data-disabled="true"])');
      if (visibleOptions.length === 0) return;
      
      const currentHighlighted = dropdown.querySelector('.highlighted');
      let newIndex = 0;
      
      if (currentHighlighted) {
        const currentIndex = Array.from(visibleOptions).indexOf(currentHighlighted);
        newIndex = currentIndex + direction;
      }
      
      // Wrap around
      if (newIndex < 0) newIndex = visibleOptions.length - 1;
      if (newIndex >= visibleOptions.length) newIndex = 0;
      
      // Remove previous highlight
      if (currentHighlighted) {
        currentHighlighted.classList.remove('highlighted', 'bg-gray-200');
      }
      
      // Add new highlight
      visibleOptions[newIndex].classList.add('highlighted', 'bg-gray-200');
    }
  });
</script>

<style>
  .smart-select-group select:focus {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(74, 144, 226, 0.15);
  }
  
  .smart-select-group [data-value] {
    transition: background-color 0.15s ease;
  }
  
  .smart-select-group [data-value].highlighted {
    background-color: #e5e7eb;
  }
</style>