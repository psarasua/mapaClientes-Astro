---
// src/components/forms/SmartForm.astro
interface Props {
  id: string;
  title: string;
  submitText?: string;
  cancelText?: string;
  autoSave?: boolean;
  autoSaveInterval?: number;
  onSubmit?: string;
  onCancel?: string;
  className?: string;
}

const { 
  id,
  title,
  submitText = "Guardar",
  cancelText = "Cancelar", 
  autoSave = false,
  autoSaveInterval = 30000,
  onSubmit,
  onCancel,
  className = ""
} = Astro.props;
---

<div class={`smart-form-container ${className}`}>
  <!-- Modal backdrop -->
  <div id={`${id}-backdrop`} class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center p-4 z-50">
    <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-screen overflow-y-auto">
      <!-- Header -->
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h3 id={`${id}-title`} class="text-lg font-medium text-gray-900">{title}</h3>
        <div class="flex items-center space-x-2">
          <!-- Auto-save indicator -->
          {autoSave && (
            <div id={`${id}-autosave-indicator`} class="flex items-center text-sm text-gray-500">
              <svg class="w-4 h-4 mr-1 animate-spin hidden" id={`${id}-saving-icon`} fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id={`${id}-save-status`}>Auto-guardado activado</span>
            </div>
          )}
          <button type="button" id={`${id}-close`} class="text-gray-400 hover:text-gray-600 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Form content -->
      <form id={id} class="px-6 py-4 space-y-4">
        <slot />
      </form>

      <!-- Footer -->
      <div class="px-6 py-4 border-t border-gray-200 flex justify-between items-center">
        <div class="flex items-center space-x-4">
          <!-- Validation summary -->
          <div id={`${id}-validation-summary`} class="text-sm text-red-600 hidden"></div>
          <!-- Unsaved changes indicator -->
          <div id={`${id}-unsaved-indicator`} class="text-sm text-yellow-600 hidden">
            <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.664-.833-2.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
            Cambios sin guardar
          </div>
        </div>
        
        <div class="flex space-x-3">
          <button type="button" id={`${id}-cancel`} class="px-4 py-2 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-lg transition-colors">
            {cancelText}
          </button>
          <button type="submit" id={`${id}-submit`} class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
            {submitText}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ id, autoSave, autoSaveInterval, onSubmit, onCancel }}>
  document.addEventListener('DOMContentLoaded', () => {
    const smartForm = new SmartFormManager(id, {
      autoSave,
      autoSaveInterval,
      onSubmit,
      onCancel
    });
  });

  class SmartFormManager {
    constructor(formId, options = {}) {
      this.formId = formId;
      this.options = options;
      this.form = document.getElementById(formId);
      this.backdrop = document.getElementById(`${formId}-backdrop`);
      this.hasUnsavedChanges = false;
      this.validationErrors = new Map();
      this.autoSaveTimer = null;
      this.originalData = {};
      
      this.init();
    }
    
    init() {
      if (!this.form) return;
      
      this.setupEventListeners();
      this.setupValidation();
      
      if (this.options.autoSave) {
        this.setupAutoSave();
      }
      
      // Store original data for comparison
      this.storeOriginalData();
    }
    
    setupEventListeners() {
      // Form submission
      this.form.addEventListener('submit', (e) => {
        e.preventDefault();
        this.handleSubmit();
      });
      
      // Input changes
      this.form.addEventListener('input', (e) => {
        this.handleInputChange(e);
      });
      
      // Close modal
      const closeBtn = document.getElementById(`${this.formId}-close`);
      const cancelBtn = document.getElementById(`${this.formId}-cancel`);
      
      closeBtn?.addEventListener('click', () => this.close());
      cancelBtn?.addEventListener('click', () => this.close());
      
      // Click outside to close
      this.backdrop?.addEventListener('click', (e) => {
        if (e.target === this.backdrop) {
          this.close();
        }
      });
      
      // Prevent accidental navigation with unsaved changes
      window.addEventListener('beforeunload', (e) => {
        if (this.hasUnsavedChanges) {
          e.preventDefault();
          e.returnValue = '¿Estás seguro de que quieres salir? Tienes cambios sin guardar.';
        }
      });
    }
    
    setupValidation() {
      const inputs = this.form.querySelectorAll('input, select, textarea');
      
      inputs.forEach(input => {
        // Real-time validation
        input.addEventListener('blur', () => {
          this.validateField(input);
        });
        
        input.addEventListener('input', () => {
          // Clear error on input change
          this.clearFieldError(input);
        });
      });
    }
    
    setupAutoSave() {
      const saveStatus = document.getElementById(`${this.formId}-save-status`);
      const savingIcon = document.getElementById(`${this.formId}-saving-icon`);
      
      this.form.addEventListener('input', () => {
        this.resetAutoSaveTimer();
      });
    }
    
    resetAutoSaveTimer() {
      if (this.autoSaveTimer) {
        clearTimeout(this.autoSaveTimer);
      }
      
      this.autoSaveTimer = setTimeout(() => {
        this.autoSave();
      }, this.options.autoSaveInterval);
    }
    
    async autoSave() {
      const savingIcon = document.getElementById(`${this.formId}-saving-icon`);
      const saveStatus = document.getElementById(`${this.formId}-save-status`);
      
      if (!this.hasUnsavedChanges) return;
      
      try {
        savingIcon?.classList.remove('hidden');
        saveStatus.textContent = 'Guardando...';
        
        const formData = new FormData(this.form);
        const data = Object.fromEntries(formData);
        
        // Save to localStorage as backup
        localStorage.setItem(`autosave_${this.formId}`, JSON.stringify({
          data,
          timestamp: Date.now()
        }));
        
        saveStatus.textContent = 'Guardado automáticamente';
        this.hasUnsavedChanges = false;
        this.updateUnsavedIndicator();
        
        // Show success toast
        if (window.showInfo) {
          window.showInfo('Auto-guardado', 'Borrador guardado automáticamente', 2000);
        }
        
      } catch (error) {
        console.error('Auto-save error:', error);
        saveStatus.textContent = 'Error al guardar';
      } finally {
        savingIcon?.classList.add('hidden');
        
        setTimeout(() => {
          saveStatus.textContent = 'Auto-guardado activado';
        }, 3000);
      }
    }
    
    validateField(input) {
      const errors = [];
      
      // Required validation
      if (input.hasAttribute('required') && !input.value.trim()) {
        errors.push('Este campo es obligatorio');
      }
      
      // Email validation
      if (input.type === 'email' && input.value) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(input.value)) {
          errors.push('Ingresa un email válido');
        }
      }
      
      // Phone validation
      if (input.type === 'tel' && input.value) {
        const phoneRegex = /^[\+]?[1-9][\d]{0,15}$/;
        if (!phoneRegex.test(input.value.replace(/\s/g, ''))) {
          errors.push('Ingresa un teléfono válido');
        }
      }
      
      // Number validation
      if (input.type === 'number' && input.value) {
        const min = input.getAttribute('min');
        const max = input.getAttribute('max');
        const value = parseFloat(input.value);
        
        if (min && value < parseFloat(min)) {
          errors.push(`El valor mínimo es ${min}`);
        }
        if (max && value > parseFloat(max)) {
          errors.push(`El valor máximo es ${max}`);
        }
      }
      
      // Date validation
      if (input.type === 'date' && input.value) {
        const date = new Date(input.value);
        const today = new Date();
        
        if (input.hasAttribute('data-min-date-today') && date < today) {
          errors.push('La fecha no puede ser anterior a hoy');
        }
      }
      
      // Custom validation
      const customValidator = input.getAttribute('data-validator');
      if (customValidator && window[customValidator]) {
        const customError = window[customValidator](input.value);
        if (customError) {
          errors.push(customError);
        }
      }
      
      if (errors.length > 0) {
        this.showFieldError(input, errors[0]);
        this.validationErrors.set(input.name, errors);
      } else {
        this.clearFieldError(input);
        this.validationErrors.delete(input.name);
      }
      
      this.updateValidationSummary();
    }
    
    showFieldError(input, message) {
      this.clearFieldError(input);
      
      input.classList.add('border-red-500', 'focus:border-red-500', 'focus:ring-red-200');
      
      const errorDiv = document.createElement('div');
      errorDiv.className = 'mt-1 text-sm text-red-600 field-error';
      errorDiv.textContent = message;
      
      input.parentNode.appendChild(errorDiv);
    }
    
    clearFieldError(input) {
      input.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-200');
      
      const existingError = input.parentNode.querySelector('.field-error');
      if (existingError) {
        existingError.remove();
      }
    }
    
    updateValidationSummary() {
      const summary = document.getElementById(`${this.formId}-validation-summary`);
      const submitBtn = document.getElementById(`${this.formId}-submit`);
      
      if (this.validationErrors.size > 0) {
        summary.textContent = `${this.validationErrors.size} error(es) de validación`;
        summary.classList.remove('hidden');
        submitBtn.disabled = true;
      } else {
        summary.classList.add('hidden');
        submitBtn.disabled = false;
      }
    }
    
    handleInputChange(e) {
      if (!this.hasUnsavedChanges) {
        this.hasUnsavedChanges = true;
        this.updateUnsavedIndicator();
      }
    }
    
    updateUnsavedIndicator() {
      const indicator = document.getElementById(`${this.formId}-unsaved-indicator`);
      
      if (this.hasUnsavedChanges) {
        indicator?.classList.remove('hidden');
      } else {
        indicator?.classList.add('hidden');
      }
    }
    
    storeOriginalData() {
      const formData = new FormData(this.form);
      this.originalData = Object.fromEntries(formData);
    }
    
    async handleSubmit() {
      // Validate all fields
      const inputs = this.form.querySelectorAll('input, select, textarea');
      inputs.forEach(input => this.validateField(input));
      
      if (this.validationErrors.size > 0) {
        window.showError && window.showError('Errores de validación', 'Por favor corrige los errores antes de continuar');
        return;
      }
      
      try {
        const formData = new FormData(this.form);
        const data = Object.fromEntries(formData);
        
        // Call custom submit handler if provided
        if (this.options.onSubmit && window[this.options.onSubmit]) {
          await window[this.options.onSubmit](data);
        }
        
        this.hasUnsavedChanges = false;
        this.updateUnsavedIndicator();
        
        // Clear auto-save data
        localStorage.removeItem(`autosave_${this.formId}`);
        
      } catch (error) {
        console.error('Form submission error:', error);
        window.showError && window.showError('Error', 'No se pudo enviar el formulario');
      }
    }
    
    open(data = {}) {
      this.backdrop?.classList.remove('hidden');
      this.backdrop?.classList.add('flex');
      
      // Fill form with data
      Object.keys(data).forEach(key => {
        const input = this.form.querySelector(`[name="${key}"]`);
        if (input) {
          input.value = data[key] || '';
        }
      });
      
      // Check for auto-save data
      this.loadAutoSaveData();
      
      this.storeOriginalData();
      this.hasUnsavedChanges = false;
      this.updateUnsavedIndicator();
      
      // Focus first input
      const firstInput = this.form.querySelector('input, select, textarea');
      if (firstInput) {
        setTimeout(() => firstInput.focus(), 100);
      }
    }
    
    close() {
      if (this.hasUnsavedChanges) {
        // Show warning toast instead of confirm dialog
        if (window.showWarning) {
          window.showWarning(
            'Cambios sin guardar', 
            'Hay cambios que no se han guardado. Haz clic en "Guardar" para preservar los cambios o "Descartar" para cerrar sin guardar.',
            8000
          );
          
          // Add temporary buttons to save or discard
          this.showUnsavedChangesActions();
          return;
        }
      }
      
      this.actuallyClose();
    }
    
    showUnsavedChangesActions() {
      // Create action buttons for unsaved changes
      let actionBar = document.getElementById(`${this.formId}-unsaved-actions`);
      if (!actionBar) {
        actionBar = document.createElement('div');
        actionBar.id = `${this.formId}-unsaved-actions`;
        actionBar.className = 'flex justify-center gap-3 p-4 bg-amber-50 border-t border-amber-200';
        actionBar.innerHTML = `
          <button type="button" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors" onclick="smartFormManager_${this.formId}.saveAndClose()">
            Guardar y Cerrar
          </button>
          <button type="button" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors" onclick="smartFormManager_${this.formId}.discardAndClose()">
            Descartar Cambios
          </button>
          <button type="button" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors" onclick="smartFormManager_${this.formId}.continueEditing()">
            Continuar Editando
          </button>
        `;
        
        const formContent = this.backdrop.querySelector('.bg-white');
        formContent.appendChild(actionBar);
      }
      
      // Make manager globally accessible for buttons
      window[`smartFormManager_${this.formId}`] = this;
    }
    
    async saveAndClose() {
      try {
        const formData = new FormData(this.form);
        const data = Object.fromEntries(formData);
        
        // Call the submit handler
        if (this.options.onSubmit && window[this.options.onSubmit]) {
          await window[this.options.onSubmit](data);
        }
      } catch (error) {
        console.error('Error saving:', error);
        if (window.showError) {
          window.showError('Error', 'No se pudo guardar. Inténtalo de nuevo.');
        }
      }
    }
    
    discardAndClose() {
      this.hasUnsavedChanges = false;
      if (window.showInfo) {
        window.showInfo('Cambios descartados', 'Se han descartado los cambios no guardados');
      }
      this.actuallyClose();
    }
    
    continueEditing() {
      const actionBar = document.getElementById(`${this.formId}-unsaved-actions`);
      if (actionBar) {
        actionBar.remove();
      }
    }
    
    actuallyClose() {
      // Remove action bar if exists
      const actionBar = document.getElementById(`${this.formId}-unsaved-actions`);
      if (actionBar) {
        actionBar.remove();
      }
      
      this.backdrop?.classList.add('hidden');
      this.backdrop?.classList.remove('flex');
      
      // Call custom cancel handler if provided
      if (this.options.onCancel && window[this.options.onCancel]) {
        window[this.options.onCancel]();
      }
      
      this.form.reset();
      this.hasUnsavedChanges = false;
      this.validationErrors.clear();
      this.updateUnsavedIndicator();
      this.updateValidationSummary();
      
      // Clear field errors
      const fieldErrors = this.form.querySelectorAll('.field-error');
      fieldErrors.forEach(error => error.remove());
      
      const inputs = this.form.querySelectorAll('input, select, textarea');
      inputs.forEach(input => {
        input.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-200');
      });
    }
    
    loadAutoSaveData() {
      const saved = localStorage.getItem(`autosave_${this.formId}`);
      if (saved) {
        try {
          const { data, timestamp } = JSON.parse(saved);
          const age = Date.now() - timestamp;
          
          // Show auto-save data if less than 1 hour old
          if (age < 3600000) {
            // Show info toast with action buttons
            if (window.showInfo) {
              window.showInfo(
                'Borrador encontrado', 
                'Se encontró un borrador guardado automáticamente. Puedes cargarlo o continuar con el formulario vacío.',
                0 // Don't auto-dismiss
              );
            }
            
            this.showAutoSaveActions(data);
          } else {
            // Remove old auto-save data
            localStorage.removeItem(`autosave_${this.formId}`);
          }
        } catch (error) {
          console.error('Error loading auto-save data:', error);
        }
      }
    }
    
    showAutoSaveActions(data) {
      // Create action bar for auto-save recovery
      let actionBar = document.getElementById(`${this.formId}-autosave-actions`);
      if (!actionBar) {
        actionBar = document.createElement('div');
        actionBar.id = `${this.formId}-autosave-actions`;
        actionBar.className = 'flex justify-center gap-3 p-4 bg-blue-50 border-t border-blue-200';
        actionBar.innerHTML = `
          <button type="button" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors" onclick="smartFormManager_${this.formId}.loadDraft()">
            Cargar Borrador
          </button>
          <button type="button" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors" onclick="smartFormManager_${this.formId}.ignoreDraft()">
            Continuar sin Borrador
          </button>
        `;
        
        const formContent = this.backdrop.querySelector('.bg-white');
        formContent.insertBefore(actionBar, formContent.firstChild.nextSibling);
      }
      
      // Store data for loading
      this.draftData = data;
      
      // Make manager globally accessible
      window[`smartFormManager_${this.formId}`] = this;
    }
    
    loadDraft() {
      if (this.draftData) {
        Object.keys(this.draftData).forEach(key => {
          const input = this.form.querySelector(`[name="${key}"]`);
          if (input) {
            input.value = this.draftData[key] || '';
          }
        });
        
        this.hasUnsavedChanges = true;
        this.updateUnsavedIndicator();
        
        if (window.showSuccess) {
          window.showSuccess('Borrador cargado', 'Se ha restaurado el borrador guardado automáticamente');
        }
      }
      
      this.removeDraftActions();
    }
    
    ignoreDraft() {
      // Remove the auto-save data
      localStorage.removeItem(`autosave_${this.formId}`);
      
      if (window.showInfo) {
        window.showInfo('Borrador descartado', 'Se ha eliminado el borrador guardado');
      }
      
      this.removeDraftActions();
    }
    
    removeDraftActions() {
      const actionBar = document.getElementById(`${this.formId}-autosave-actions`);
      if (actionBar) {
        actionBar.remove();
      }
      this.draftData = null;
    }
  }
  
  // Make SmartFormManager globally available
  window.SmartFormManager = SmartFormManager;
</script>

<style>
  /* Smooth transitions for form elements */
  .smart-form-container input,
  .smart-form-container select,
  .smart-form-container textarea {
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  
  /* Enhanced focus states */
  .smart-form-container input:focus,
  .smart-form-container select:focus,
  .smart-form-container textarea:focus {
    outline: none;
    border-color: #4A90E2;
    box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.1);
  }
  
  /* Validation error states */
  .smart-form-container input.border-red-500:focus {
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
  }
</style>